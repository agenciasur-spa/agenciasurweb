---
import { Clock, CheckCircle, TrendingUp, Award } from '@lucide/astro';

const stats = [
  { value: '18+', label: 'Años de Trayectoria', icon: Clock },
  { value: '200+', label: 'Procesos Analizados', icon: CheckCircle },
  { value: '50+', label: 'Proyectos de Éxito', icon: TrendingUp },
];
---


<section aria-label="Indicadores">
  <div class="main-container s">
    <div data-ns-animate data-delay="0.5" class="flex flex-col md:flex-row gap-4 md:gap-y-2 items-center md:items-start justify-center">
    <div
          data-instant="true"
          data-ns-animate
          data-delay="0.9"
          class="flex items-start flex-col bg-secondary dark:bg-background-6 gap-1 p-4 rounded-2xl"
         
        >
        <h5 class="flex items-center gap-05 text-ns-green font-normal">
            <span class="text-ns-green" data-counter="18">0</span><span class="text-ns-green"> +</span>
          </h5>

          <small class="text-white fw-300">Años de trayectoria</small>
          
        </div>


    <div
          data-instant="true"
          data-ns-animate
          data-delay="0.9"
          class="flex items-start flex-col bg-secondary dark:bg-background-6 gap-1 p-4 rounded-2xl"
         
        >
        <h5 class="flex items-center gap-05 text-ns-green font-normal">
            <span class="text-ns-green" data-counter="200">0</span><span class="text-ns-green"> +</span>
          </h5>

          <small class="text-white fw-300">Procesos analizados</small>
          
        </div>

            <div
          data-instant="true"
          data-ns-animate
          data-delay="0.9"
          class="flex items-start flex-col bg-secondary dark:bg-background-6 gap-1 p-4 rounded-2xl"
         
        >
        <h5 class="flex items-center gap-05 text-ns-green font-normal">
            <span class="text-ns-green" data-counter="50">0</span><span class="text-ns-green"> +</span>
          </h5>

          <small class="text-white fw-300">Proyectos de éxito</small>
          
        </div>



    </div>
  </div>
</section>
