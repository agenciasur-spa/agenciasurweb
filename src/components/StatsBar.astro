---
import { Clock, CheckCircle, TrendingUp } from '@lucide/astro';

const stats = [
  { value: 18, label: 'Años de trayectoria', icon: Clock },
  { value: 200, label: 'Procesos analizados', icon: CheckCircle },
  { value: 50, label: 'Proyectos de éxito', icon: TrendingUp },
];
---

<section aria-label="Indicadores">
  <div
    data-ns-animate
    data-delay="0.6"
    class="grid grid-cols-1 gap-3 sm:grid-cols-3"
  >
    {stats.map(({ value, label, icon: Icon }, index) => (
      <div
        data-instant="true"
        data-ns-animate
        data-delay={0.7 + index * 0.1}
        class="flex flex-col items-start gap-2 rounded-2xl bg-secondary dark:bg-background-6 p-4"
      >
        <Icon color="currentColor" size={20} stroke-width={1.5} class="text-accent-300" />
        <h5 class="flex items-center gap-0.5 text-accent-300 font-normal">
          <span data-counter={value}>{value}</span><span>+</span>
        </h5>
        <small class="text-white font-light">{label}</small>
      </div>
    ))}
  </div>
</section>
