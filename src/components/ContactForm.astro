---
// ContactForm — Nexsas contact layout with Mad-libs form
interface Props {
  hideCta?: boolean;
}

const { hideCta = false } = Astro.props;
---

{!hideCta && (
<pre>------------------...footer...------------------</pre>
<section
  class="pt-16 md:pt-20 lg:pt-[90px] xl:pt-[100px] pb-16 md:pb-20 lg:pb-[90px] xl:pb-[100px] bg-[url('/images/ns-img-169.png')] bg-no-repeat bg-cover bg-top"
>
  <div class="main-container">
    
    <div class="text-center space-y-5 max-w-[1024px] mx-auto mb-14">
      <span data-ns-animate data-delay="0.2" class="badge badge-section mb-5">Contacto</span>
      <div>
        <h2 data-ns-animate data-delay="0.3" class="mb-3 font-light">
          ¿Tienes un proyecto?
        </h2>
      </div>
    </div>

    <!-- form -->
    <form id="mad-libs-form" class="mad-libs-form">
      <div class="grid grid-cols-12 space-y-8 md:space-y-0 md:gap-8 mb-10 lg:mb-18 max-w-[1010px] mx-auto">
        
        <div
          data-ns-animate
          data-delay="0.5"
          class="col-span-12 md:col-span-12 lg:col-span-12 p-8 rounded-[20px] bg-white dark:bg-background-6 space-y-6 sm:min-h-[288px]"
        >
          <div class="space-y-2 p-6">
            <h6 class="font-light text-xl mb-4">Cuéntanos qué necesitas. Te ayudamos a definir el camino desde la idea hasta la implementación.</h6>
            
            <!-- Anti-spam field (hidden) -->
            <input type="text" name="website" style="display: none;" tabindex="-1" autocomplete="off">
          
            <div class="mb-4 font-light text-xl flex flex-wrap items-center ml-text gap-x-2 gap-y-2">
              <span>Hola, me llamo</span>  
              <span class="ml-input-wrap flex-1">
                <input class="ml-input" id="ml-nombre" name="nombre" placeholder="tu nombre" required aria-label="Tu nombre" />
                <span class="ml-error-msg" id="err-nombre"></span>
              </span>  
              <span>y mi correo es</span>  
              <span class="ml-input-wrap flex-1">
                <input class="ml-input" id="ml-correo" name="correo" type="email" placeholder="tu@empresa.com" required aria-label="Tu correo electrónico" />
                <span class="ml-error-msg" id="err-correo"></span>
              </span>.
            </div>

            <div class="mb-4 font-light text-xl flex flex-wrap items-center ml-text gap-x-2 gap-y-2">
              <div class="mb-4 font-light text-xl">
                Trabajo en una empresa del sector
              </div>     
              <div class="mb-4 font-light text-xl flex-1">
                <span class="ml-select-wrap w-full">
                  <select class="ml-select flex-1 w-full" id="ml-sector" name="sector" required aria-label="Sector de tu empresa">
                    <option value="">elige</option>
                    <option>Financiero</option>
                    <option>Retail y comercio</option>
                    <option>Logística</option>
                    <option>Salud</option>
                    <option>Educación</option>
                    <option>Manufactura</option>
                    <option>Tecnología</option>
                    <option>Otro</option>
                  </select>
                  <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>
                <span class="ml-error-msg" id="err-sector"></span>
              </div>
            </div>
    
            <div class="mb-4 font-light text-xl flex flex-wrap items-center ml-text gap-x-2 gap-y-2">
              <span>Actualmente necesitamos</span>
              <span class="flex-1">
                <span class="ml-select-wrap w-full">
                  <select class="ml-select w-full" id="ml-necesidad" name="necesidad" required aria-label="Qué necesitas">
                    <option value="">elige</option>
                    <option>digitalizar un proceso manual</option>
                    <option>construir una plataforma web</option>
                    <option>desarrollar una app móvil</option>
                    <option>integrar sistemas existentes</option>
                    <option>mejorar nuestra infraestructura actual</option>
                    <option>automatizar flujos de trabajo</option>
                  </select>
                  <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>
                <span class="ml-error-msg" id="err-necesidad"></span>
              </span>
            </div>

            <div class="mb-4 font-light text-xl flex flex-wrap items-center ml-text gap-x-2 gap-y-2">
              <span>y queremos lograr</span>
              <span class="flex-1">
                <span class="ml-select-wrap w-full">
                  <select class="ml-select w-full" id="ml-objetivo" name="objetivo" required aria-label="Tu objetivo">
                    <option value="">elige</option>
                    <option>escalar el negocio</option>
                    <option>reducir errores y tiempo operativo</option>
                    <option>mejorar la experiencia del cliente</option>
                    <option>integrar nuestras APIs y datos</option>
                    <option>aumentar la visibilidad digital</option>
                    <option>tener control en tiempo real</option>
                  </select>
                  <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>
                <span class="ml-error-msg" id="err-objetivo"></span>
              </span>.
            </div>

            <div class="mb-4 font-light text-xl flex flex-wrap items-center ml-text gap-x-2 gap-y-2">
              <span>Nos gustaría empezar</span>
              <span class="ml-select-wrap flex-1">
                <select class="ml-select w-full" id="ml-plazo" name="plazo" required aria-label="Plazo estimado">
                  <option value="">elige</option>
                  <option>lo antes posible</option>
                  <option>en los próximos 3 meses</option>
                  <option>en los próximos 6 meses</option>
                  <option>solo estamos cotizando por ahora</option>
                </select>
                <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </span>
              <span class="ml-error-msg" id="err-plazo"></span>.
            </div>

            <div class="mb-6 font-light text-xl">
              Algo más que quiero añadir:
              <input class="ml-input ml-input-muted" id="ml-extra" name="extra" placeholder="(opcional)" aria-label="Notas adicionales" />
            </div>
          </div>

          <!-- Validation hint -->
          <div id="ml-hint" class="ml-hint hidden">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-hint-icon"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="ml-hint-text">Completá los campos resaltados para enviar tu mensaje</span>
          </div>

          <!-- Preview -->
          <div id="ml-preview" class="ml-preview">
            <p class="ml-preview-label">Así quedará tu mensaje</p>
            <p id="ml-preview-text" class="text-tagline-1"></p>
          </div>
          
        </div>
      </div>

      <div data-ns-animate data-delay="0.7" class="flex items-center justify-center">
        <button type="submit" id="ml-submit-btn" class="btn btn-secondary hover:btn-green dark:btn-transparent dark:border-primary-50 btn-md w-[85%] md:w-auto mx-auto" disabled>
          <span>Enviar mensaje</span>
        </button>
      </div>  

      <!-- Success state -->
      <div id="ml-success" class="ml-success hidden">
        <div class="flex flex-col items-center gap-4 py-8">
          <div class="flex size-16 items-center justify-center rounded-full bg-accent-500/20">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent-500">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </div>
          <div class="text-center">
            <h5 id="ml-success-msg" class="mb-1"></h5>
            <p class="text-secondary/60 dark:text-accent/60 text-tagline-1">
              Te contactaremos en las próximas 24 horas hábiles.
            </p>
          </div>
        </div>
      </div>

      <!-- SE ELIMINÓ EL </div> SOBRANTE QUE ESTABA AQUÍ -->
      
    </form> 
    <!-- end form -->

  </div> 
</section>
<pre>------------------...footer...------------------</pre>
)}


<style>
  /* Mad-libs mobile-first */
  .ml-text > p {
    margin-bottom: 1rem;
    line-height: 1.8;
  }

  /* Mobile: block layout */
  @media (max-width: 639px) {
    .ml-input {
      display: block !important;
      width: 100% !important;
      min-width: 0 !important;
      margin: 4px 0 8px 0;
      padding: 8px 10px !important;      
      border-bottom: 1px dotted var(--color-secondary);
    }
    .ml-select-wrap {
      display: block !important;
      width: 100%;
      margin: 4px 0 8px 0;
    }
    .ml-select {
      display: block !important;
      width: 100%;
      padding: 8px 28px 8px 8px;
      border-bottom: 1px dotted var(--color-secondary);
      border-radius: 4px;
      background-color: rgba(0, 0, 0, 0.03);
    }
    .ml-select-arrow {
      right: 10px;
    }
    .ml-error-msg {
      display: block;
      margin-left: 0;
      margin-bottom: 4px;
    }
    .ml-text {
      font-size: 1.125rem !important;
    }
    .ml-text > p {
      line-height: 1.6;
    }
  }

  /* Desktop: inline layout */
  @media (min-width: 640px) {
    .ml-input {
      display: inline-block;
      vertical-align: baseline;
      min-width: 100%;
      width: 100%;
    }
    .ml-select-wrap {
      display: inline-block;
      position: relative;
      vertical-align: baseline;
    }
    .ml-select {
      display: inline-block;
      vertical-align: baseline;
    }
     .ml-input-wrap {
    display: inline-flex;
    flex: 1;
    width: 100%;
  }
  }

  /* ── Text inputs ── */
  .ml-input {
    border: none;
    border-bottom: 1px dotted var(--color-secondary);
    background: transparent;
    font-size: inherit;
    font-family: inherit;
    font-weight: 500;
    color: var(--color-secondary);
    outline: none;
    padding: 0 4px 2px;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .ml-input::placeholder {
    color: var(--color-secondary);
    font-style: italic;
    font-weight: 400;
  }
  .ml-input:focus {
    border-color: var(--color-accent-400);
  }
  .ml-input.ml-invalid {
    border-bottom-color: #ef4444 !important;
    background-color: rgba(239, 68, 68, 0.08);
  }
  .ml-input.ml-valid {
    border-bottom-color: #22c55e;
  }
  .ml-input-muted {
    border-bottom-color: var(--color-stroke-3);
    color: var(--color-secondary);
    opacity: 0.6;
  }
  .ml-input-muted::placeholder {
    color: var(--color-stroke-3);
  }

  /* ── Error messages ── */
  .ml-error-msg {
    font-size: 12px;
    color: #ef4444;
    font-weight: 500;
    margin-left: 2px;
    opacity: 0;
    transition: opacity 0.2s;
    vertical-align: baseline;
  }
  .ml-error-msg.ml-visible {
    opacity: 1;
  }

  /* ── Native selects ── */
  .ml-select {
    border: none;
    border-bottom: 1px dotted var(--color-secondary);
    background: transparent;
    font-size: inherit;
    font-family: inherit;
    font-weight: 500;
    color: var(--color-secondary);
    outline: none;
    padding: 0 22px 2px 4px;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.2s;
  }
  .ml-select:focus {
    border-color: var(--color-accent-400);
  }
  .ml-select.ml-invalid {
    border-bottom-color: #ef4444 !important;
  }
  .ml-select.ml-valid {
    border-bottom-color: #22c55e;
  }
  .ml-select-arrow {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-secondary);
  }

  /* Dark mode */
  :global(.dark) .ml-input {
    border-bottom-color: var(--color-primary-50);
    color: var(--color-primary-50);
  }
  :global(.dark) .ml-input::placeholder {
    color: var(--color-primary-50);
    opacity: 0.5;
  }
  :global(.dark) .ml-input.ml-invalid {
    background-color: rgba(239, 68, 68, 0.12);
  }
  :global(.dark) .ml-input-muted {
    border-bottom-color: var(--color-stroke-7);
    color: var(--color-accent);
    opacity: 0.5;
  }
  :global(.dark) .ml-error-msg {
    color: #f87171;
  }
  :global(.dark) .ml-select {
    border-bottom-color: var(--color-primary-50);
    color: var(--color-primary-50);
  }
  :global(.dark) .ml-select-arrow {
    color: var(--color-primary-50);
  }

  /* Validation hint */
  .ml-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 1rem;
    padding: 12px 16px;
    background: rgba(234, 179, 8, 0.1);
    border: 1px solid rgba(234, 179, 8, 0.3);
    border-radius: 10px;
    font-size: 13px;
    color: #b45309;
    line-height: 1.5;
    transition: opacity 0.3s, max-height 0.3s;
  }
  .ml-hint.hidden {
    display: none;
  }
  .ml-hint-icon {
    flex-shrink: 0;
    color: #b45309;
  }
  :global(.dark) .ml-hint {
    background: rgba(234, 179, 8, 0.15);
    color: #fbbf24;
    border-color: rgba(234, 179, 8, 0.25);
  }
  :global(.dark) .ml-hint-icon {
    color: #fbbf24;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  /* Preview */
  .ml-preview {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--color-background-3);
    border-radius: 12px;
    border-left: 3px solid var(--color-primary-500);
    font-size: 0.9375rem;
    line-height: 1.8;
    display: none;
  }
  .ml-preview.show {
    display: block;
  }
  .ml-preview-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-secondary);
    opacity: 0.5;
    margin-bottom: 8px;
  }
  :global(.dark) .ml-preview {
    background: var(--color-background-7);
  }
  :global(.dark) .ml-preview-label {
    color: var(--color-accent);
    opacity: 0.4;
  }

  /* Success */
  .ml-success {
    transition: opacity 0.3s;
  }
</style>

<script is:inline>
  function sizeInput(el) {
    if (window.innerWidth < 640) {
      el.style.width = '';
      return;
    }
    var span = document.createElement('span');
    span.style.cssText = 'visibility:hidden;position:absolute;font-size:inherit;font-family:inherit;white-space:pre;padding:0 4px';
    span.textContent = el.value || el.placeholder;
    document.body.appendChild(span);
    el.style.width = (span.offsetWidth + 12) + 'px';
    document.body.removeChild(span);
  }

  function initMadLibs() {
    var form = document.getElementById('mad-libs-form');
    if (!form) return;

    var inputs = form.querySelectorAll('.ml-input');
    var selects = form.querySelectorAll('.ml-select');
    var submitBtn = document.getElementById('ml-submit-btn');
    var preview = document.getElementById('ml-preview');
    var previewText = document.getElementById('ml-preview-text');
    var successDiv = document.getElementById('ml-success');
    var successMsg = document.getElementById('ml-success-msg');
    var hintDiv = document.getElementById('ml-hint');
    var hintText = document.getElementById('ml-hint-text');

    var touched = {};

    var fieldLabels = {
      nombre: 'tu nombre',
      correo: 'tu correo',
      sector: 'el sector',
      necesidad: 'la necesidad',
      objetivo: 'el objetivo',
      plazo: 'el plazo',
    };

    inputs.forEach(function(el) { sizeInput(el); });

    function vals() {
      return {
        nombre: document.getElementById('ml-nombre').value.trim(),
        correo: document.getElementById('ml-correo').value.trim(),
        sector: document.getElementById('ml-sector').value,
        necesidad: document.getElementById('ml-necesidad').value,
        objetivo: document.getElementById('ml-objetivo').value,
        plazo: document.getElementById('ml-plazo').value,
        extra: document.getElementById('ml-extra').value.trim(),
      };
    }

    function isComplete(v) {
      var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return v.nombre && emailRegex.test(v.correo) && v.sector && v.necesidad && v.objetivo && v.plazo;
    }

    function buildMsg(v) {
      var msg = 'Hola, me llamo ' + v.nombre + ' y mi correo es ' + v.correo + '. Trabajo en una empresa del sector ' + v.sector + '. Actualmente necesitamos ' + v.necesidad + ' y queremos lograr ' + v.objetivo + '. Nos gustaría empezar ' + v.plazo + '.';
      if (v.extra) msg += ' ' + v.extra;
      return msg;
    }

    function validateField(id, value, isEmail) {
      var key = id.replace('ml-', '');
      var el = document.getElementById(id);
      var errEl = document.getElementById('err-' + key);
      if (!el) return true;

      var isEmpty = !value.trim();
      var isInvalidEmail = isEmail && value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());

      if (touched[key]) {
        if (isEmpty) {
          el.classList.add('ml-invalid');
          el.classList.remove('ml-valid');
          if (errEl) { errEl.textContent = ' requerido'; errEl.classList.add('ml-visible'); }
          return false;
        } else if (isInvalidEmail) {
          el.classList.add('ml-invalid');
          el.classList.remove('ml-valid');
          if (errEl) { errEl.textContent = ' email inválido'; errEl.classList.add('ml-visible'); }
          return false;
        } else {
          el.classList.remove('ml-invalid');
          el.classList.add('ml-valid');
          if (errEl) { errEl.textContent = ''; errEl.classList.remove('ml-visible'); }
          return true;
        }
      }
      el.classList.remove('ml-invalid', 'ml-valid');
      if (errEl) { errEl.textContent = ''; errEl.classList.remove('ml-visible'); }
      return !isEmpty && !isInvalidEmail;
    }

    function validateAll(showAll) {
      var v = vals();
      var fields = [
        { id: 'ml-nombre', key: 'nombre', value: v.nombre },
        { id: 'ml-correo', key: 'correo', value: v.correo, isEmail: true },
        { id: 'ml-sector', key: 'sector', value: v.sector },
        { id: 'ml-necesidad', key: 'necesidad', value: v.necesidad },
        { id: 'ml-objetivo', key: 'objetivo', value: v.objetivo },
        { id: 'ml-plazo', key: 'plazo', value: v.plazo },
      ];

      if (showAll) {
        fields.forEach(function(f) { touched[f.key] = true; });
      }

      var results = fields.map(function(f) { return validateField(f.id, f.value, f.isEmail); });
      var allValid = results.every(Boolean);
      var missing = fields.filter(function(_, i) { return !results[i]; }).map(function(f) { return fieldLabels[f.key]; });

      if (!allValid) {
        hintText.textContent = 'Falta completar: ' + missing.join(', ');
        hintDiv.classList.remove('hidden');
      } else {
        hintDiv.classList.add('hidden');
      }

      return allValid;
    }

    function updatePreview() {
      var v = vals();
      var complete = isComplete(v);
      submitBtn.toggleAttribute('disabled', !complete);

      if (complete) {
        previewText.textContent = buildMsg(v);
        preview.classList.add('show');
        hintDiv.classList.add('hidden');
      } else {
        preview.classList.remove('show');
      }

      var fields = [
        { id: 'ml-nombre', key: 'nombre', value: v.nombre },
        { id: 'ml-correo', key: 'correo', value: v.correo, isEmail: true },
        { id: 'ml-sector', key: 'sector', value: v.sector },
        { id: 'ml-necesidad', key: 'necesidad', value: v.necesidad },
        { id: 'ml-objetivo', key: 'objetivo', value: v.objetivo },
        { id: 'ml-plazo', key: 'plazo', value: v.plazo },
      ];
      fields.forEach(function(f) { if (touched[f.key]) validateField(f.id, f.value, f.isEmail); });

      if (!complete) {
        var missing = fields.filter(function(f) {
          if (f.isEmail) return !f.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.value.trim());
          return !f.value.trim();
        }).map(function(f) { return fieldLabels[f.key]; });
        hintText.textContent = 'Falta completar: ' + missing.join(', ');
        if (Object.keys(touched).length > 0) hintDiv.classList.remove('hidden');
      } else {
        hintDiv.classList.add('hidden');
      }
    }

    // Blur validation for text inputs
    var fieldMap = {
      'ml-nombre': 'nombre',
      'ml-correo': 'correo',
    };

    Object.keys(fieldMap).forEach(function(elId) {
      var el = document.getElementById(elId);
      if (!el) return;
      var key = fieldMap[elId];
      var isEmail = key === 'correo';

      el.addEventListener('blur', function() {
        touched[key] = true;
        var v = vals();
        validateField(elId, v[key], isEmail);
        updatePreview();
      });
    });

    // Live resize on input
    inputs.forEach(function(el) {
      el.addEventListener('input', function() {
        sizeInput(el);
        var key = el.id.replace('ml-', '');
        if (touched[key]) {
          var v = vals();
          validateField(el.id, v[key], key === 'correo');
        }
        updatePreview();
      });
    });

    // Update on select change
    selects.forEach(function(sel) {
      sel.addEventListener('change', function() {
        var key = sel.id.replace('ml-', '');
        touched[key] = true;
        var v = vals();
        validateField(sel.id, v[key]);
        updatePreview();
      });
    });

    // Click on disabled button: show validation
    submitBtn.addEventListener('click', function(e) {
      if (submitBtn.disabled) {
        e.preventDefault();
        validateAll(true);
        hintDiv.classList.remove('hidden');
        hintDiv.style.animation = 'none';
        hintDiv.offsetHeight;
        hintDiv.style.animation = 'shake 0.4s ease';
        return;
      }
    });

    // Submit
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var v = vals();
      if (!isComplete(v)) return;

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Enviando...</span>';

      var formData = new FormData();
      formData.append('nombre', v.nombre);
      formData.append('email', v.correo);
      formData.append('sector', v.sector);
      formData.append('necesidad', v.necesidad);
      formData.append('objetivo', v.objetivo);
      formData.append('plazo', v.plazo);
      if (v.extra) formData.append('extra', v.extra);

      fetch('/api/contacto', {
        method: 'POST',
        body: formData,
      })
      .then(function(response) {
        return response.json().then(function(result) {
          if (!response.ok) throw new Error(result.error || 'Error al enviar el mensaje');
          return result;
        });
      })
      .then(function() {
        form.style.display = 'none';
        successMsg.textContent = '¡Gracias, ' + v.nombre + '! Te contactaremos en las próximas 24 horas.';
        successDiv.classList.remove('hidden');

        setTimeout(function() {
          form.reset();
          form.style.display = 'block';
          successDiv.classList.add('hidden');
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Enviar mensaje</span>';
          touched = {};
          document.querySelectorAll('.ml-invalid, .ml-valid').forEach(function(el) {
            el.classList.remove('ml-invalid', 'ml-valid');
          });
          document.querySelectorAll('.ml-error-msg.ml-visible').forEach(function(el) {
            el.textContent = '';
            el.classList.remove('ml-visible');
          });
          updatePreview();
          inputs.forEach(function(el) { sizeInput(el); });
        }, 5000);
      })
      .catch(function(error) {
        console.error('Form submission error:', error);
        successDiv.querySelector('.flex').classList.add('hidden');
        var errorMsg = successMsg.nextElementSibling;
        if (errorMsg) {
          errorMsg.textContent = 'Error: ' + (error.message || 'No se pudo enviar el mensaje. Intenta nuevamente.');
          errorMsg.className = 'text-secondary/60 dark:text-accent/60 text-tagline-1 text-red-600';
        }
        successDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Enviar mensaje</span>';
      });
    });

    // Initial sizing
    inputs.forEach(function(el) { sizeInput(el); });
  }

  // Ensure DOM is fully rendered before initializing
  // Astro's is:inline scripts run synchronously during parse — use setTimeout to defer
  setTimeout(initMadLibs, 0);
</script>
