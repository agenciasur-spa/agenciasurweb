---
// ── Sistemas Core Section (features pattern) ─────────────────────────────────
// Nexsas Time-Tracking adapted for Agencia Sur
// Grid de 3 cards: imagen (light/dark) + heading + tagline
---

<section class="py-20 lg:py-[100px] xl:py-[200px] bg-background-1 dark:bg-background-6">
  <div class="main-container">
    <!-- Header -->
    <div class="space-y-5 mb-10 md:mb-[72px] text-center lg:max-w-[570px] lg:mx-auto">
      <span data-ns-animate data-delay="0.1" class="badge badge-green-v2">Sistemas Core</span>
      <h2 data-ns-animate data-delay="0.2">Plataformas modulares diseñadas para optimizar la gestión empresarial</h2>
    </div>

    <!-- Grid de 3 cards -->
    <div class="grid grid-cols-12 md:gap-x-8 gap-y-14">
      <!-- Sistema 1: Sistema de Compras -->
      <article
        data-ns-animate
        data-delay="0.3"
        class="space-y-3 col-span-12 md:col-span-6 lg:col-span-4"
      >
        <figure class="rounded-[12px] overflow-hidden max-w-full lg:max-w-[408px]">
          <img
            src="https://picsum.photos/408/300?random=1"
            class="w-full h-full object-cover block dark:hidden"
            alt="Sistema de Compras"
          />
          <img
            src="https://picsum.photos/408/300?random=11"
            class="w-full h-full object-cover hidden dark:block"
            alt="Sistema de Compras (dark)"
          />
        </figure>
        <div class="max-md:space-y-0.5">
          <h3 class="text-heading-6 md:text-heading-5">Sistema de Compras</h3>
          <p>
            Digitaliza el proceso de adquisiciones y haz eficiente tu abastecimiento. Control total desde la solicitud hasta la entrega.
          </p>
        </div>
      </article>

      <!-- Sistema 2: Gestión de Personal Transitorio -->
      <article
        data-ns-animate
        data-delay="0.4"
        class="space-y-3 col-span-12 md:col-span-6 lg:col-span-4"
      >
        <figure class="rounded-[12px] overflow-hidden max-w-full lg:max-w-[408px]">
          <img
            src="https://picsum.photos/408/300?random=2"
            class="w-full h-full object-cover block dark:hidden"
            alt="Gestión de Personal Transitorio"
          />
          <img
            src="https://picsum.photos/408/300?random=12"
            class="w-full h-full object-cover hidden dark:block"
            alt="Gestión de Personal Transitorio (dark)"
          />
        </figure>
        <div class="max-md:space-y-0.5">
          <h3 class="text-heading-6 md:text-heading-5">Gestión de Personal Transitorio</h3>
          <p>
            Estandariza solicitudes, evalúa y valida personal externo en una sola plataforma centralizada.
          </p>
        </div>
      </article>

      <!-- Sistema 3: Mesa de Ayuda -->
      <article
        data-ns-animate
        data-delay="0.5"
        class="space-y-3 col-span-12 md:col-span-6 lg:col-span-4"
      >
        <figure class="rounded-[12px] overflow-hidden max-w-full lg:max-w-[408px]">
          <img
            src="https://picsum.photos/408/300?random=3"
            class="w-full h-full object-cover block dark:hidden"
            alt="Mesa de Ayuda"
          />
          <img
            src="https://picsum.photos/408/300?random=13"
            class="w-full h-full object-cover hidden dark:block"
            alt="Mesa de Ayuda (dark)"
          />
        </figure>
        <div class="max-md:space-y-0.5">
          <h3 class="text-heading-6 md:text-heading-5">Mesa de Ayuda</h3>
          <p>
            Omnicanalidad y base de conocimientos para una autoatención inteligente con SLA automatizado.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>