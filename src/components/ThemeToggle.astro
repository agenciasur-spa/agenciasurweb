---
// ── Theme Toggle ──────────────────────────────────────────────
// JS: animations.ts → themeSwitcher
// CSS: .dark / .light classes on <html> control icon visibility
// Init: Layout.astro inline script (before render)
// Toggle guarda en localStorage key "theme"
---

<style>
  /* Por defecto (sin .dark ni .light aplicada, el caso mas comun ya que
     el script de init en Layout.astro solo agrega .light explicitamente
     y nunca agrega .dark) el boton ya se ve oscuro (bg-background-8, ya
     que dark:bg-white no se dispara), asi que mostramos la luna --
     misma pareja bg-oscuro/icono-luna que el estado .light explicito.
     Cuando .dark SI esta presente (bg-white via dark:bg-white) mostramos
     el sol. Antes ninguna regla cubria el estado "sin clase", dejando el
     boton sin icono para todo visitante nuevo. */
  #icon-sun { display: none; }
  #icon-moon { display: flex; }

  :global(.dark) #icon-sun { display: flex; }
  :global(.dark) #icon-moon { display: none; }
</style>

<button
  id="theme-toggle"
  aria-label="Cambiar tema"
  class="size-12 bg-background-8 !z-[9999] dark:bg-white rounded-l-2xl cursor-pointer flex items-center justify-center fixed right-0 bottom-5"
>
  <!-- Sol → dark mode (bg blanco) → stroke negro para contrastar -->
  <span id="icon-sun" class="items-center justify-center text-black">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
      />
    </svg>
  </span>

  <!-- Luna → light mode (bg oscuro) → stroke blanco para contrastar -->
  <span id="icon-moon" class="items-center justify-center text-white">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
      />
    </svg>
  </span>
</button>
