---
// ContactoFooter — Nexsas contact layout + Mad-libs form
---

<!-- CTA / Contact Section -->
<section class="pt-[100px] pb-[100px] md:pb-[200px]">
  <div class="main-container">
    <div class="grid grid-cols-12 gap-y-12 lg:gap-x-10 lg:gap-y-0 xl:gap-x-[100px]">
      <!-- Left: Info -->
      <div class="col-span-12 lg:col-span-6">
        <div class="mb-12 space-y-5 text-center lg:text-left">
          <span data-ns-animate data-delay="0.1" class="badge badge-green">Contacto</span>
          <div class="space-y-3">
            <h2 data-ns-animate data-delay="0.2">¿Tienes un proyecto?</h2>
            <p
              data-ns-animate
              data-delay="0.3"
              class="mx-auto max-w-[550px] text-center lg:mx-0 lg:text-left"
            >
              Contanos qué necesitás. Te ayudamos a definir el camino desde la idea hasta la
              implementación.
            </p>
          </div>
        </div>

        <!-- Contact details -->
        <div data-ns-animate data-delay="0.4" class="space-y-4 text-center lg:text-left">
          <div>
            <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 font-normal">Dirección</p>
            <p class="text-tagline-1 font-medium">Las Bellotas 199, of 62, Providencia</p>
          </div>
          <div>
            <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 font-normal">Teléfono</p>
            <a href="tel:+56978640400" class="text-tagline-1 font-medium transition-colors hover:text-primary-500">
              +56 9 7864 0400
            </a>
          </div>
          <div>
            <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 font-normal">Email</p>
            <a href="mailto:contacto@agenciasur.cl" class="text-tagline-1 font-medium tracking-tight transition-colors hover:text-primary-500">
              contacto@agenciasur.cl
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Mad-libs form -->
      <div class="col-span-12 lg:col-span-6">
        <div
          data-ns-animate
          data-delay="0.5"
          class="dark:bg-background-8 rounded-[20px] bg-white p-6 lg:p-[42px]"
        >
          <form id="mad-libs-form" class="mad-libs-form">
            <div class="ml-text text-heading-5 md:text-heading-4 leading-[1.6] font-normal text-secondary dark:text-accent">
              <p class="mb-4">
                Hola, me llamo
                <input class="ml-input" id="ml-nombre" name="nombre" placeholder="tu nombre" required />
                y mi correo es
                <input class="ml-input" id="ml-correo" name="correo" type="email" placeholder="tu@empresa.com" required />.
              </p>

              <p class="mb-4">
                Trabajo en una empresa del sector
                <span class="ml-select-wrap">
                  <select class="ml-select" id="ml-sector" name="sector" required>
                    <option value="">elige</option>
                    <option>Financiero</option>
                    <option>Retail y comercio</option>
                    <option>Logística</option>
                    <option>Salud</option>
                    <option>Educación</option>
                    <option>Manufactura</option>
                    <option>Tecnología</option>
                    <option>Otro</option>
                  </select>
                  <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>.
              </p>

              <p class="mb-4">
                Actualmente necesitamos
                <span class="ml-select-wrap">
                  <select class="ml-select" id="ml-necesidad" name="necesidad" required>
                    <option value="">elige</option>
                    <option>digitalizar un proceso manual</option>
                    <option>construir una plataforma web</option>
                    <option>desarrollar una app móvil</option>
                    <option>integrar sistemas existentes</option>
                    <option>mejorar nuestra infraestructura actual</option>
                    <option>automatizar flujos de trabajo</option>
                  </select>
                  <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>
                y queremos lograr
                <span class="ml-select-wrap">
                  <select class="ml-select" id="ml-objetivo" name="objetivo" required>
                    <option value="">elige</option>
                    <option>escalar el negocio</option>
                    <option>reducir errores y tiempo operativo</option>
                    <option>mejorar la experiencia del cliente</option>
                    <option>integrar nuestras APIs y datos</option>
                    <option>aumentar la visibilidad digital</option>
                    <option>tener control en tiempo real</option>
                  </select>
                  <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>.
              </p>

              <p class="mb-4">
                Nos gustaría empezar
                <span class="ml-select-wrap">
                  <select class="ml-select" id="ml-plazo" name="plazo" required>
                    <option value="">elige</option>
                    <option>lo antes posible</option>
                    <option>en los próximos 3 meses</option>
                    <option>en los próximos 6 meses</option>
                    <option>solo estamos cotizando por ahora</option>
                  </select>
                  <svg class="ml-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>.
              </p>

              <p class="mb-6">
                Algo más que quiero añadir:
                <input class="ml-input ml-input-muted" id="ml-extra" name="extra" placeholder="(opcional)" />
              </p>
            </div>

            <!-- Preview -->
            <div id="ml-preview" class="ml-preview">
              <p class="ml-preview-label">Así quedará tu mensaje</p>
              <p id="ml-preview-text" class="text-tagline-1"></p>
            </div>

            <button
              type="submit"
              id="ml-submit-btn"
              class="btn btn-md btn-secondary hover:btn-primary dark:btn-accent dark:hover:btn-white w-full mt-6 before:content-none"
              disabled
            >
              <span>Enviar mensaje</span>
            </button>
          </form>

          <!-- Success state -->
          <div id="ml-success" class="ml-success hidden">
            <div class="flex flex-col items-center gap-4 py-8">
              <div class="flex size-16 items-center justify-center rounded-full bg-accent-500/20">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent-500">
                  <path d="M20 6 9 17l-5-5"/>
                </svg>
              </div>
              <div class="text-center">
                <h5 id="ml-success-msg" class="mb-1"></h5>
                <p class="text-secondary/60 dark:text-accent/60 text-tagline-1">
                  Te contactaremos en las próximas 24 horas hábiles.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-secondary dark:bg-background-8 relative overflow-hidden">
  <div class="main-container px-5">
    <div class="grid grid-cols-12 justify-between gap-x-0 gap-y-16 pb-12 pt-16 xl:pt-[90px]">
      <!-- Brand -->
      <div class="col-span-12 xl:col-span-4">
        <div data-ns-animate data-delay="0.3" class="max-w-[306px]">
          <span class="text-accent text-lg font-bold tracking-tight">
            AGENCIA<span class="text-primary-500">SUR</span>
          </span>
          <p class="text-accent/60 text-tagline-1 mt-4 mb-7 font-normal">
            Transformación digital para empresas. Automatizamos procesos críticos con
            soluciones a medida.
          </p>
          <!-- Social links -->
          <div class="flex items-center gap-3">
            <a href="#" class="footer-social-link" aria-label="LinkedIn">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <div class="bg-stroke-1/20 h-6 w-px"></div>
            <a href="#" class="footer-social-link" aria-label="Instagram">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 100 12.324 6.162 6.162 0 100-12.324zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405a1.441 1.441 0 11-2.882 0 1.441 1.441 0 012.882 0z"/></svg>
            </a>
            <div class="bg-stroke-1/20 h-6 w-px"></div>
            <a href="#" class="footer-social-link" aria-label="YouTube">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Links -->
      <div class="col-span-12 grid grid-cols-12 gap-x-0 gap-y-8 xl:col-span-8">
        <div class="col-span-12 md:col-span-4">
          <div data-ns-animate data-delay="0.4" class="space-y-8">
            <p class="sm:text-heading-6 text-tagline-1 text-primary-50 font-normal">Servicios</p>
            <ul class="space-y-3 sm:space-y-5">
              <li><a href="/servicios" class="footer-link">Consultoría TI</a></li>
              <li><a href="/servicios" class="footer-link">Automatización</a></li>
              <li><a href="/servicios" class="footer-link">Desarrollo Web</a></li>
              <li><a href="/servicios" class="footer-link">Infraestructura</a></li>
            </ul>
          </div>
        </div>
        <div class="col-span-12 md:col-span-4">
          <div data-ns-animate data-delay="0.5" class="space-y-8">
            <p class="sm:text-heading-6 text-tagline-1 text-primary-50 font-normal">Empresa</p>
            <ul class="space-y-3 sm:space-y-5">
              <li><a href="/nosotros" class="footer-link">Nosotros</a></li>
              <li><a href="/casos-exito" class="footer-link">Casos de Éxito</a></li>
              <li><a href="/contacto" class="footer-link">Contacto</a></li>
            </ul>
          </div>
        </div>
        <div class="col-span-12 md:col-span-4">
          <div data-ns-animate data-delay="0.6" class="space-y-8">
            <p class="sm:text-heading-6 text-tagline-1 text-primary-50 font-normal">Soluciones</p>
            <ul class="space-y-3 sm:space-y-5">
              <li><a href="/soluciones/sistema-de-compras" class="footer-link">Sistema de Compras</a></li>
              <li><a href="/soluciones/gestion-personal-transitorio" class="footer-link">Personal Transitorio</a></li>
              <li><a href="/soluciones/mesa-de-ayuda" class="footer-link">Mesa de Ayuda</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="relative pt-[26px] pb-[100px] text-center">
      <div class="footer-divider bg-accent/10 dark:bg-stroke-4/10 absolute top-0 right-0 left-0 mx-auto h-px w-0 origin-center"></div>
      <p data-ns-animate data-delay="0.7" data-offset="10" data-start="top 105%" class="text-tagline-1 text-primary-50 font-normal">
        &copy;{new Date().getFullYear()} Agencia Sur. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Mad-libs inline inputs */
  .ml-input {
    display: inline-block;
    border: none;
    border-bottom: 2px solid var(--color-primary-500);
    background: transparent;
    font-size: inherit;
    font-family: inherit;
    font-weight: 500;
    color: var(--color-primary-500);
    outline: none;
    padding: 0 4px 2px;
    min-width: 80px;
    transition: border-color 0.2s;
    vertical-align: baseline;
  }
  .ml-input::placeholder {
    color: var(--color-primary-300);
    font-style: italic;
    font-weight: 400;
  }
  .ml-input:focus {
    border-color: var(--color-primary-700);
  }
  .ml-input-muted {
    border-bottom-color: var(--color-stroke-3);
    color: var(--color-secondary);
    opacity: 0.6;
  }
  .ml-input-muted::placeholder {
    color: var(--color-stroke-3);
  }
  :global(.dark) .ml-input-muted {
    border-bottom-color: var(--color-stroke-7);
    color: var(--color-accent);
    opacity: 0.5;
  }
  :global(.dark) .ml-input {
    border-bottom-color: var(--color-accent-400);
    color: var(--color-accent-400);
  }
  :global(.dark) .ml-input::placeholder {
    color: var(--color-accent-400);
    opacity: 0.5;
  }

  /* Inline selects */
  .ml-select-wrap {
    display: inline-block;
    position: relative;
    vertical-align: baseline;
  }
  .ml-select {
    display: inline-block;
    border: none;
    border-bottom: 2px solid var(--color-accent-500);
    background: transparent;
    font-size: inherit;
    font-family: inherit;
    font-weight: 500;
    color: var(--color-accent-500);
    outline: none;
    padding: 0 22px 2px 4px;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.2s;
    vertical-align: baseline;
  }
  .ml-select:focus {
    border-color: var(--color-accent-700);
  }
  .ml-select-arrow {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-accent-500);
  }
  :global(.dark) .ml-select {
    border-bottom-color: var(--color-accent-400);
    color: var(--color-accent-400);
  }
  :global(.dark) .ml-select-arrow {
    color: var(--color-accent-400);
  }

  /* Preview */
  .ml-preview {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--color-background-3);
    border-radius: 12px;
    border-left: 3px solid var(--color-primary-500);
    font-size: 14px;
    line-height: 1.8;
    display: none;
  }
  .ml-preview.show {
    display: block;
  }
  .ml-preview-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-secondary);
    opacity: 0.5;
    margin-bottom: 8px;
  }
  :global(.dark) .ml-preview {
    background: var(--color-background-7);
  }
  :global(.dark) .ml-preview-label {
    color: var(--color-accent);
    opacity: 0.4;
  }

  /* Success */
  .ml-success {
    transition: opacity 0.3s;
  }
</style>

<script>
  function sizeInput(el: HTMLInputElement) {
    const span = document.createElement('span');
    span.style.cssText = 'visibility:hidden;position:absolute;font-size:inherit;font-family:inherit;white-space:pre;padding:0 4px';
    span.textContent = el.value || el.placeholder;
    document.body.appendChild(span);
    el.style.width = (span.offsetWidth + 12) + 'px';
    document.body.removeChild(span);
  }

  function initMadLibs() {
    const form = document.getElementById('mad-libs-form') as HTMLFormElement;
    if (!form) return;

    const inputs = form.querySelectorAll('.ml-input') as NodeListOf<HTMLInputElement>;
    const submitBtn = document.getElementById('ml-submit-btn') as HTMLButtonElement;
    const preview = document.getElementById('ml-preview') as HTMLDivElement;
    const previewText = document.getElementById('ml-preview-text') as HTMLParagraphElement;
    const successDiv = document.getElementById('ml-success') as HTMLDivElement;
    const successMsg = document.getElementById('ml-success-msg') as HTMLHeadingElement;

    inputs.forEach(sizeInput);

    function vals() {
      return {
        nombre: (document.getElementById('ml-nombre') as HTMLInputElement).value.trim(),
        correo: (document.getElementById('ml-correo') as HTMLInputElement).value.trim(),
        sector: (document.getElementById('ml-sector') as HTMLSelectElement).value,
        necesidad: (document.getElementById('ml-necesidad') as HTMLSelectElement).value,
        objetivo: (document.getElementById('ml-objetivo') as HTMLSelectElement).value,
        plazo: (document.getElementById('ml-plazo') as HTMLSelectElement).value,
        extra: (document.getElementById('ml-extra') as HTMLInputElement).value.trim(),
      };
    }

    function isComplete(v: ReturnType<typeof vals>) {
      return v.nombre && v.correo.includes('@') && v.sector && v.necesidad && v.objetivo && v.plazo;
    }

    function buildMsg(v: ReturnType<typeof vals>) {
      let msg = `Hola, me llamo ${v.nombre} y mi correo es ${v.correo}. Trabajo en una empresa del sector ${v.sector}. Actualmente necesitamos ${v.necesidad} y queremos lograr ${v.objetivo}. Nos gustaría empezar ${v.plazo}.`;
      if (v.extra) msg += ` ${v.extra}`;
      return msg;
    }

    function updatePreview() {
      const v = vals();
      submitBtn.toggleAttribute('disabled', !isComplete(v));
      if (isComplete(v)) {
        previewText.textContent = buildMsg(v);
        preview.classList.add('show');
      } else {
        preview.classList.remove('show');
      }
    }

    // Live resize on input
    inputs.forEach(el => {
      el.addEventListener('input', () => {
        sizeInput(el);
        updatePreview();
      });
    });

    // Update on select change
    form.querySelectorAll('.ml-select').forEach(sel => {
      sel.addEventListener('change', updatePreview);
    });

    // Submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = vals();
      if (!isComplete(v)) return;

      form.style.display = 'none';
      successMsg.textContent = `¡Gracias, ${v.nombre}! Recibimos tu mensaje.`;
      successDiv.classList.remove('hidden');

      // TODO: integrate with /api/contacto
    });

    // Initial sizing
    inputs.forEach(sizeInput);
  }

  document.addEventListener('DOMContentLoaded', initMadLibs);
</script>
