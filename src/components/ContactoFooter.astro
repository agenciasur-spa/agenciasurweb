---

import ContactForm from './ContactFormV2.astro';

interface Props {
  hideCta?: boolean;
}

const { hideCta = false } = Astro.props;
---

{!hideCta && <ContactForm />}



<style>
  /* Mad-libs inline inputs */
  .ml-input {
    display: inline-block;
    border: none;
    border-bottom: 2px solid var(--color-accent-400);
    background: transparent;
    font-size: inherit;
    font-family: inherit;
    font-weight: 500;
    color: var(--color-accent-400);
    outline: none;
    padding: 0 4px 2px;
    min-width: 80px;
    transition: border-color 0.2s;
    vertical-align: baseline;
  }
  .ml-input::placeholder {
    color: var(--color-accent-100);
    font-style: italic;
    font-weight: 400;
  }
  .ml-input:focus {
    border-color: var(--color-accent-600);
  }
  .ml-input-muted {
    border-bottom-color: var(--color-stroke-3);
    color: var(--color-secondary);
    opacity: 0.6;
  }
  .ml-input-muted::placeholder {
    color: var(--color-stroke-3);
  }
  :global(.dark) .ml-input-muted {
    border-bottom-color: var(--color-stroke-7);
    color: var(--color-accent);
    opacity: 0.5;
  }
  :global(.dark) .ml-input {
    border-bottom-color: var(--color-accent-400);
    color: var(--color-accent-400);
  }
  :global(.dark) .ml-input::placeholder {
    color: var(--color-accent-400);
    opacity: 0.5;
  }

  /* Inline selects */
  .ml-select-wrap {
    display: inline-block;
    position: relative;
    vertical-align: baseline;
  }
  .ml-select {
    display: inline-block;
    border: none;
    border-bottom: 2px solid var(--color-accent-500);
    background: transparent;
    font-size: inherit;
    font-family: inherit;
    font-weight: 500;
    color: var(--color-accent-500);
    outline: none;
    padding: 0 22px 2px 4px;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.2s;
    vertical-align: baseline;
  }
  .ml-select:focus {
    border-color: var(--color-accent-700);
  }
  .ml-select-arrow {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-accent-500);
  }
  :global(.dark) .ml-select {
    border-bottom-color: var(--color-accent-400);
    color: var(--color-accent-400);
  }
  :global(.dark) .ml-select-arrow {
    color: var(--color-accent-400);
  }

  /* Preview */
  .ml-preview {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--color-background-3);
    border-radius: 12px;
    border-left: 3px solid var(--color-accent-400);
    font-size: 14px;
    line-height: 1.8;
    display: none;
  }
  .ml-preview.show {
    display: block;
  }
  .ml-preview-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-secondary);
    opacity: 0.5;
    margin-bottom: 8px;
  }
  :global(.dark) .ml-preview {
    background: var(--color-background-7);
  }
  :global(.dark) .ml-preview-label {
    color: var(--color-accent);
    opacity: 0.4;
  }

  /* Success */
  .ml-success {
    transition: opacity 0.3s;
  }
</style>
