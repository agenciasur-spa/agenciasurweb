---
import { UserCog, Workflow, Code, Cloud } from '@lucide/astro';

const servicios = [
  {
    icon: UserCog,
    color: 'primary',
    title: 'Levantamiento de Procesos',
    description:
      'No programamos sin entender. Analizamos y definimos la metodología óptima antes de digitalizar.',
  },
  {
    icon: Code,
    color: 'green',
    title: 'Desarrollo Web & Mobile High-End',
    description:
      'Construimos sistemas robustos sobre arquitecturas modernas o evolucionamos tu infraestructura actual en WordPress/Prestashop hacia el alto rendimiento.',
    span: true,
  },
  {
    icon: Workflow,
    color: 'purple',
    title: 'Integración & Soporte Continuo',
    description:
      'Conectamos tus sistemas existentes con APIs y middleware. Soporte post-entrega para asegurar la operación sin interrupciones.',
  },
];
---

<section
  class="pt-14 pb-[220px] sm:pb-14 md:pt-16 md:pb-16 lg:pt-[88px] lg:pb-[88px] xl:pt-[100px] xl:pb-[100px]"
>
  <div class="main-container">
    <div
      class="flex flex-col items-start justify-center max-md:gap-y-18 md:flex-row md:justify-between md:gap-x-[120px]"
    >
    
      <div class="lg:sticky lg:top-28">
        
        <span data-ns-animate data-delay="0.1" class="badge badge-green">Servicios</span>

        <div class="mb-14 space-y-2 md:max-w-[595px]">
          <h2 data-ns-animate data-delay="0.2">Soluciones para la era digital</h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[512px]">
            lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec suscipit auctor dui, at convallis nisl. Sed a nunc eget nunc efficitur efficitur. Donec in felis sed enim efficitur commodo. Donec suscipit auctor dui, at convallis nisl. Sed a nunc eget nunc efficitur efficitur. Donec in felis sed enim efficitur commodo.
          </p>
        </div>
                
      </div>
      <!-- Right: Features List -->
      <div class="stack-cards js-stack-cards w-full max-w-xl">
        {servicios.map(({ icon: Icon, title, description }) => (
        <div
           class="stack-cards__item js-stack-cards__item border-stroke-4/50 dark:border-stroke-5 bg-background-1 dark:bg-background-8 z-0 min-h-[250px] space-y-4 rounded-[20px] border p-8"
        >
        <div class="bg-black flex size-17 items-center justify-center rounded-3xl p-4">
            <Icon />
          </div>
          <div>
            <h3 class="text-heading-5">{title}</h3>
            <p class="">{description}</p>
          </div>
        </div>
   ))}


       

      </div>
    </div>
  </div>
</section>
