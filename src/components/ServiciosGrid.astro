---
import { UserCog, Workflow, Code, Cloud } from '@lucide/astro';
import BadgeSection from '../components/blocks/BadgeSection.astro';

const servicios = [
  {
    icon: UserCog,
    title: 'Levantamiento de Procesos',
    description:
      'No programamos sin entender. Analizamos y definimos la metodología óptima antes de digitalizar.',
    tag: 'Discovery & mapeo',
  },
  {
    icon: Code,
    title: 'Desarrollo Web & Mobile High-End',
    description:
      'Construimos sistemas robustos sobre arquitecturas modernas o evolucionamos tu infraestructura actual en WordPress/Prestashop hacia el alto rendimiento.',
    tag: 'Arquitecturas modernas',
  },
  {
    icon: Workflow,
    title: 'Integración & Soporte Continuo',
    description:
      'Conectamos tus sistemas existentes con APIs y middleware. Soporte post-entrega para asegurar la operación sin interrupciones.',
    tag: 'APIs & middleware',
  },
  {
    icon: Cloud,
    title: 'Infraestructura Cloud',
    description:
      'Despliegue, monitoreo y escalabilidad en la nube. Tu operación, siempre disponible.',
    tag: 'Monitoreo 24/7',
  },
];
---

<!-- Sentinel: marca la posicion "natural" (sin transform) del borde
     superior de #servicios, para que el ScrollTrigger de la animacion
     de entrada (initServiciosReveal en animations.ts) no mida un
     elemento que el mismo esta transformando (eso desincroniza el
     scrub). Vive fuera de #servicios a proposito. -->
<div id="servicios-trigger" aria-hidden="true" class="h-px w-full"></div>

<section
  id="servicios"
  class="relative z-10 -mt-8 rounded-t-[28px] bg-background-2 pt-16 md:-mt-12 md:rounded-t-[36px] md:pt-20 lg:pt-[90px] xl:pt-[100px] pb-16 md:pb-20 lg:pb-[90px] xl:pb-[100px] dark:bg-background-6"
>
  <div class="main-container">
    <!-- Header centrado: mismo ritmo visual que SistemasGrid, la
         seccion siguiente (badge + heading centrados antes del grid),
         para que ambas secciones se lean como parte de un mismo
         sistema en vez de layouts distintos una tras otra. -->
    <div class="mx-auto max-w-[640px] text-center">
      <div class="flex justify-center">
        <BadgeSection text="Servicios" delay={0.1} />
      </div>
      <div class="mt-4 space-y-2">
        <h2 data-ns-animate data-delay="0.2" class="font-light">
          <span class="text-accent-400 block">Soluciones</span>
          para la era digital
        </h2>
        <p data-ns-animate data-delay="0.3" class="mx-auto max-w-[512px]">
          Transformamos procesos complejos en soluciones simples, eficientes y escalables.
        </p>
      </div>
    </div>

    <!-- Grid de servicios: reemplaza el stack-scroll (dependia de
         stack-card.min.js + un parser regex sobre su transform inline,
         fragil). Ahora usa el mismo sistema de reveal (data-ns-animate)
         que el resto del sitio. -->
    <div class="mt-14 grid grid-cols-1 gap-6 md:mt-16 md:grid-cols-2 md:gap-8">
      {servicios.map(({ icon: Icon, title, description, tag }, index) => (
        <div
          data-ns-animate
          data-delay={0.15 * index}
          data-direction="up"
          data-offset="40"
          class="group rounded-[20px] border border-stroke-1 bg-white p-8 transition-colors duration-300 hover:border-accent-400/50 dark:border-stroke-7 dark:bg-background-5"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="bg-black flex size-17 items-center justify-center rounded-2xl p-4 shadow-lg border border-stroke-1 dark:border-stroke-6 dark:bg-background-5">
              <Icon color="currentColor" size={48} stroke-width={1} class="text-accent-400" />
            </div>
            <span class="mt-2 shrink-0 rounded-full border border-accent-400/30 bg-accent-400/10 px-3 py-1 text-tagline-2 font-medium text-accent-400">
              {tag}
            </span>
          </div>
          <div class="mt-6 space-y-2">
            <h3 class="text-heading-5 font-light">{title}</h3>
            <p class="text-secondary/70 dark:text-accent/70">{description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
