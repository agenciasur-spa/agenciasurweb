---
import BadgeSection from '../components/blocks/BadgeSection.astro';

const servicios = [
  {
    title: 'Levantamiento de Procesos',
    description:
      'No programamos sin entender. Analizamos y definimos la metodología óptima antes de digitalizar.',
    tag: 'Discovery & mapeo',
    visual: 'discovery',
  },
  {
    title: 'Desarrollo Web & Mobile High-End',
    description:
      'Construimos sistemas robustos sobre arquitecturas modernas o evolucionamos tu infraestructura actual en WordPress/Prestashop hacia el alto rendimiento.',
    tag: 'Arquitecturas modernas',
    visual: 'dev',
  },
  {
    title: 'Integración & Soporte Continuo',
    description:
      'Conectamos tus sistemas existentes con APIs y middleware. Soporte post-entrega para asegurar la operación sin interrupciones.',
    tag: 'APIs & middleware',
    visual: 'integration',
  },
  {
    title: 'Infraestructura Cloud',
    description:
      'Despliegue, monitoreo y escalabilidad en la nube. Tu operación, siempre disponible.',
    tag: 'Monitoreo 24/7',
    visual: 'cloud',
  },
];
---

<!-- Sentinel para ScrollTrigger -->
<div id="servicios-trigger" aria-hidden="true" class="h-0 w-full"></div>

<section
  id="servicios"
  class="relative z-10 -mt-8 rounded-t-[28px] bg-background-2 pt-16 md:-mt-12 md:rounded-t-[36px] md:pt-20 lg:pt-[90px] xl:pt-[100px] pb-16 md:pb-20 lg:pb-[90px] xl:pb-[100px] dark:bg-background-6"
>
  <div class="main-container">
    <div class="mx-auto max-w-[640px] text-center">
      <div class="flex justify-center">
        <BadgeSection text="Servicios" delay={0.1} />
      </div>
      <div class="mt-4 space-y-2">
        <h2 data-ns-animate data-delay="0.2" class="font-light">
          <span class="text-accent-400 block">Soluciones</span>
          para la era digital
        </h2>
        <p data-ns-animate data-delay="0.3" class="mx-auto max-w-[512px]">
          Transformamos procesos complejos en soluciones simples, eficientes y escalables.
        </p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:mt-16 md:grid-cols-2 md:gap-8">
      {servicios.map(({ title, description, tag, visual }, index) => (
        <div
          data-ns-animate
          data-delay={0.15 * index}
          data-direction="up"
          data-offset="40"
          class="group overflow-hidden rounded-[20px] border border-stroke-1 bg-white transition-colors duration-300 hover:border-accent-400/50 dark:border-stroke-7 dark:bg-background-5"
        >
          <!-- Illustration area -->
          <div class="relative h-52 w-full overflow-hidden" style="background-color: #0b0d10;">

            {visual === 'discovery' && (
              <svg viewBox="0 0 400 208" xmlns="http://www.w3.org/2000/svg" fill="none" class="h-full w-full" preserveAspectRatio="xMidYMid meet">
                <!-- Subtle background lines -->
                <line x1="0" y1="52" x2="400" y2="52" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
                <line x1="0" y1="156" x2="400" y2="156" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>

                <!-- Progress bar top -->
                <text x="24" y="30" fill="rgba(255,255,255,0.3)" font-size="9" font-family="system-ui, sans-serif" letter-spacing="0.5">FASE 2 DE 4</text>
                <rect x="24" y="36" width="200" height="3" rx="1.5" fill="rgba(255,255,255,0.06)"/>
                <rect x="24" y="36" height="3" rx="1.5" fill="rgba(143,209,79,0.55)" width="95">
                  <animate attributeName="width" from="0" to="95" dur="1.8s" fill="freeze"/>
                </rect>

                <!-- Step 1: Entrevista -->
                <rect x="24" y="76" width="78" height="40" rx="8" fill="rgba(143,209,79,0.05)" stroke="rgba(143,209,79,0.2)" stroke-width="1"/>
                <text x="63" y="100" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="10" font-family="system-ui, sans-serif">Entrevista</text>
                <circle cx="36" cy="84" r="2.5" fill="rgba(143,209,79,0.3)"/>

                <!-- Arrow -->
                <path d="M103 96 L121 96" stroke="rgba(143,209,79,0.3)" stroke-width="1.5" stroke-dasharray="4 3">
                  <animate attributeName="stroke-dashoffset" from="0" to="-14" dur="1.4s" repeatCount="indefinite"/>
                </path>
                <path d="M118 92 L123 96 L118 100" stroke="rgba(143,209,79,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

                <!-- Step 2: Análisis (active) -->
                <rect x="123" y="68" width="88" height="56" rx="8" fill="rgba(143,209,79,0.11)" stroke="#8FD14F" stroke-width="1.5"/>
                <circle cx="136" cy="80" r="6" fill="none" stroke="#8FD14F" stroke-width="1">
                  <animate attributeName="r" from="4" to="10" dur="2s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" from="0.6" to="0" dur="2s" repeatCount="indefinite"/>
                </circle>
                <circle cx="136" cy="80" r="3" fill="#8FD14F"/>
                <text x="167" y="92" text-anchor="middle" fill="rgba(255,255,255,0.9)" font-size="10" font-weight="500" font-family="system-ui, sans-serif">Análisis</text>
                <text x="167" y="107" text-anchor="middle" fill="rgba(143,209,79,0.65)" font-size="8" font-family="system-ui, sans-serif">● activo</text>

                <!-- Arrow -->
                <path d="M212 96 L230 96" stroke="rgba(143,209,79,0.22)" stroke-width="1.5" stroke-dasharray="4 3">
                  <animate attributeName="stroke-dashoffset" from="0" to="-14" dur="1.4s" repeatCount="indefinite" begin="0.35s"/>
                </path>
                <path d="M227 92 L232 96 L227 100" stroke="rgba(143,209,79,0.22)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

                <!-- Step 3: Mapeo -->
                <rect x="232" y="76" width="72" height="40" rx="8" fill="rgba(143,209,79,0.03)" stroke="rgba(143,209,79,0.14)" stroke-width="1"/>
                <text x="268" y="100" text-anchor="middle" fill="rgba(255,255,255,0.32)" font-size="10" font-family="system-ui, sans-serif">Mapeo</text>

                <!-- Arrow -->
                <path d="M305 96 L322 96" stroke="rgba(143,209,79,0.12)" stroke-width="1.5" stroke-dasharray="4 3">
                  <animate attributeName="stroke-dashoffset" from="0" to="-14" dur="1.4s" repeatCount="indefinite" begin="0.7s"/>
                </path>
                <path d="M319 92 L324 96 L319 100" stroke="rgba(143,209,79,0.12)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

                <!-- Step 4: Definir (future) -->
                <rect x="325" y="76" width="55" height="40" rx="8" fill="transparent" stroke="rgba(143,209,79,0.08)" stroke-width="1" stroke-dasharray="3 2"/>
                <text x="352" y="100" text-anchor="middle" fill="rgba(255,255,255,0.18)" font-size="9" font-family="system-ui, sans-serif">Definir</text>

                <!-- Step numbers below -->
                <text x="63" y="135" text-anchor="middle" fill="rgba(143,209,79,0.3)" font-size="8" font-family="system-ui, sans-serif">01</text>
                <text x="167" y="135" text-anchor="middle" fill="#8FD14F" font-size="8" font-weight="600" font-family="system-ui, sans-serif">02</text>
                <text x="268" y="135" text-anchor="middle" fill="rgba(143,209,79,0.2)" font-size="8" font-family="system-ui, sans-serif">03</text>
                <text x="352" y="135" text-anchor="middle" fill="rgba(143,209,79,0.12)" font-size="8" font-family="system-ui, sans-serif">04</text>

                <!-- Meta info top-right -->
                <text x="376" y="30" text-anchor="end" fill="rgba(255,255,255,0.18)" font-size="8" font-family="system-ui, sans-serif">4 etapas · 2 semanas</text>

                <!-- Decorative dots bottom-right -->
                <circle cx="368" cy="174" r="1.5" fill="rgba(143,209,79,0.12)"/>
                <circle cx="380" cy="174" r="1.5" fill="rgba(143,209,79,0.07)"/>
                <circle cx="356" cy="174" r="1.5" fill="rgba(143,209,79,0.07)"/>
                <circle cx="368" cy="186" r="1.5" fill="rgba(143,209,79,0.07)"/>
                <circle cx="368" cy="162" r="1.5" fill="rgba(143,209,79,0.07)"/>
              </svg>
            )}

            {visual === 'dev' && (
              <svg viewBox="0 0 400 208" xmlns="http://www.w3.org/2000/svg" fill="none" class="h-full w-full" preserveAspectRatio="xMidYMid meet">
                <!-- Browser window -->
                <rect x="20" y="18" width="178" height="174" rx="10" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.09)" stroke-width="1"/>
                <!-- Chrome bar -->
                <rect x="20" y="18" width="178" height="30" rx="10" fill="rgba(255,255,255,0.05)"/>
                <rect x="20" y="36" width="178" height="12" fill="rgba(255,255,255,0.05)"/>
                <!-- Traffic lights -->
                <circle cx="36" cy="33" r="4" fill="rgba(255,80,80,0.45)"/>
                <circle cx="50" cy="33" r="4" fill="rgba(255,200,60,0.38)"/>
                <circle cx="64" cy="33" r="7" fill="none" stroke="rgba(143,209,79,0.4)" stroke-width="1">
                  <animate attributeName="r" from="5" to="10" dur="2.5s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" from="0.5" to="0" dur="2.5s" repeatCount="indefinite"/>
                </circle>
                <circle cx="64" cy="33" r="4" fill="rgba(143,209,79,0.45)"/>
                <!-- URL bar -->
                <rect x="78" y="27" width="106" height="12" rx="6" fill="rgba(255,255,255,0.05)"/>
                <text x="86" y="37" fill="rgba(255,255,255,0.28)" font-size="7" font-family="monospace">agenciasur.cl/api</text>
                <!-- Code lines -->
                <rect x="32" y="60" width="38" height="5" rx="2" fill="rgba(143,209,79,0.55)"/>
                <rect x="76" y="60" width="72" height="5" rx="2" fill="rgba(255,255,255,0.18)"/>
                <rect x="32" y="73" width="20" height="5" rx="2" fill="rgba(180,232,107,0.38)"/>
                <rect x="58" y="73" width="52" height="5" rx="2" fill="rgba(255,255,255,0.11)"/>
                <rect x="32" y="86" width="28" height="5" rx="2" fill="rgba(255,255,255,0.08)"/>
                <rect x="66" y="86" width="82" height="5" rx="2" fill="rgba(143,209,79,0.3)"/>
                <rect x="32" y="99" width="58" height="5" rx="2" fill="rgba(255,255,255,0.07)"/>
                <rect x="32" y="112" width="18" height="5" rx="2" fill="rgba(180,232,107,0.38)"/>
                <rect x="56" y="112" width="44" height="5" rx="2" fill="rgba(255,255,255,0.14)"/>
                <rect x="32" y="125" width="88" height="5" rx="2" fill="rgba(255,255,255,0.06)"/>
                <rect x="32" y="138" width="42" height="5" rx="2" fill="rgba(143,209,79,0.45)"/>
                <rect x="80" y="138" width="26" height="5" rx="2" fill="rgba(255,255,255,0.18)"/>
                <rect x="32" y="151" width="68" height="5" rx="2" fill="rgba(255,255,255,0.07)"/>
                <rect x="32" y="164" width="32" height="5" rx="2" fill="rgba(143,209,79,0.2)"/>

                <!-- Mobile frame -->
                <rect x="218" y="26" width="92" height="160" rx="14" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.09)" stroke-width="1"/>
                <!-- Notch area -->
                <rect x="244" y="26" width="40" height="10" rx="0 0 8 8" fill="rgba(255,255,255,0.05)"/>
                <circle cx="264" cy="32" r="3" fill="rgba(255,255,255,0.07)"/>
                <!-- Mobile content -->
                <rect x="228" y="48" width="72" height="9" rx="4.5" fill="rgba(143,209,79,0.38)"/>
                <rect x="228" y="64" width="56" height="5" rx="2" fill="rgba(255,255,255,0.14)"/>
                <rect x="228" y="75" width="66" height="5" rx="2" fill="rgba(255,255,255,0.09)"/>
                <rect x="228" y="86" width="44" height="5" rx="2" fill="rgba(255,255,255,0.07)"/>
                <!-- Mobile card component -->
                <rect x="228" y="104" width="72" height="54" rx="7" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.2)" stroke-width="0.75"/>
                <rect x="234" y="113" width="32" height="4" rx="2" fill="rgba(143,209,79,0.48)"/>
                <rect x="234" y="121" width="52" height="3" rx="1.5" fill="rgba(255,255,255,0.14)"/>
                <rect x="234" y="128" width="42" height="3" rx="1.5" fill="rgba(255,255,255,0.09)"/>
                <rect x="234" y="138" width="58" height="12" rx="6" fill="rgba(143,209,79,0.28)"/>
                <text x="263" y="148" text-anchor="middle" fill="rgba(255,255,255,0.65)" font-size="7" font-family="system-ui, sans-serif">Ver sistema</text>
                <!-- Bottom dots nav -->
                <circle cx="249" cy="176" r="2.5" fill="rgba(143,209,79,0.5)"/>
                <circle cx="264" cy="176" r="2.5" fill="rgba(255,255,255,0.14)"/>
                <circle cx="279" cy="176" r="2.5" fill="rgba(255,255,255,0.14)"/>

                <!-- Sync line between devices -->
                <path d="M198 104 L218 104" stroke="rgba(143,209,79,0.25)" stroke-width="1" stroke-dasharray="3 2">
                  <animate attributeName="stroke-dashoffset" from="0" to="-10" dur="1.2s" repeatCount="indefinite"/>
                </path>
                <circle cx="198" cy="104" r="3" fill="rgba(143,209,79,0.28)"/>
                <circle cx="218" cy="104" r="3" fill="rgba(143,209,79,0.28)"/>
                <!-- Sync packet -->
                <path id="sg-dev-sync" d="M198 104 L218 104" fill="none" stroke="none"/>
                <circle r="2.5" fill="#8FD14F">
                  <animateMotion dur="1.6s" repeatCount="indefinite">
                    <mpath href="#sg-dev-sync"/>
                  </animateMotion>
                  <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.8;1" dur="1.6s" repeatCount="indefinite"/>
                </circle>
                <text x="208" y="118" text-anchor="middle" fill="rgba(143,209,79,0.38)" font-size="7" font-family="system-ui, sans-serif">sync</text>
              </svg>
            )}

            {visual === 'integration' && (
              <svg viewBox="0 0 400 208" xmlns="http://www.w3.org/2000/svg" fill="none" class="h-full w-full" preserveAspectRatio="xMidYMid meet">
                <!-- Central hub rings -->
                <circle cx="200" cy="104" r="38" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.2)" stroke-width="1" stroke-dasharray="4 3">
                  <animateTransform attributeName="transform" type="rotate" from="0 200 104" to="360 200 104" dur="18s" repeatCount="indefinite"/>
                </circle>
                <circle cx="200" cy="104" r="38" fill="none" stroke="rgba(143,209,79,0.18)" stroke-width="1">
                  <animate attributeName="r" from="28" to="46" dur="3s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" from="0.35" to="0" dur="3s" repeatCount="indefinite"/>
                </circle>
                <circle cx="200" cy="104" r="26" fill="rgba(143,209,79,0.1)" stroke="#8FD14F" stroke-width="1.5"/>
                <circle cx="200" cy="104" r="16" fill="rgba(143,209,79,0.15)"/>
                <text x="200" y="100" text-anchor="middle" fill="rgba(255,255,255,0.88)" font-size="8" font-weight="600" font-family="system-ui, sans-serif">AgSur</text>
                <text x="200" y="111" text-anchor="middle" fill="rgba(143,209,79,0.65)" font-size="7" font-family="system-ui, sans-serif">hub</text>

                <!-- Node: CRM (top-left) -->
                <line x1="174" y1="81" x2="106" y2="46" stroke="rgba(143,209,79,0.28)" stroke-width="1" stroke-dasharray="5 4"/>
                <circle cx="94" cy="40" r="22" fill="rgba(255,255,255,0.03)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/>
                <text x="94" y="44" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-size="9" font-family="system-ui, sans-serif">CRM</text>
                <!-- data packet -->
                <circle cx="142" cy="62" r="3.5" fill="#8FD14F" opacity="0.68"/>

                <!-- Node: ERP (left) -->
                <line x1="162" y1="104" x2="64" y2="104" stroke="rgba(143,209,79,0.28)" stroke-width="1" stroke-dasharray="5 4"/>
                <circle cx="50" cy="104" r="22" fill="rgba(255,255,255,0.03)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/>
                <text x="50" y="108" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-size="9" font-family="system-ui, sans-serif">ERP</text>
                <circle cx="112" cy="104" r="3.5" fill="#8FD14F" opacity="0.68"/>

                <!-- Node: DB (bottom-left) -->
                <line x1="176" y1="128" x2="106" y2="163" stroke="rgba(143,209,79,0.28)" stroke-width="1" stroke-dasharray="5 4"/>
                <circle cx="94" cy="169" r="22" fill="rgba(255,255,255,0.03)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/>
                <text x="94" y="173" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-size="9" font-family="system-ui, sans-serif">DB</text>
                <circle cx="138" cy="149" r="3.5" fill="#8FD14F" opacity="0.5"/>

                <!-- Node: Cloud (top-right) -->
                <line x1="226" y1="81" x2="294" y2="46" stroke="rgba(143,209,79,0.28)" stroke-width="1" stroke-dasharray="5 4"/>
                <circle cx="306" cy="40" r="22" fill="rgba(255,255,255,0.03)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/>
                <text x="306" y="44" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-size="9" font-family="system-ui, sans-serif">Cloud</text>
                <circle cx="260" cy="62" r="3.5" fill="#8FD14F" opacity="0.6"/>

                <!-- Node: SMS (right) -->
                <line x1="238" y1="104" x2="336" y2="104" stroke="rgba(143,209,79,0.28)" stroke-width="1" stroke-dasharray="5 4"/>
                <circle cx="350" cy="104" r="22" fill="rgba(255,255,255,0.03)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/>
                <text x="350" y="101" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-size="9" font-family="system-ui, sans-serif">SMS</text>
                <text x="350" y="112" text-anchor="middle" fill="rgba(143,209,79,0.4)" font-size="7" font-family="system-ui, sans-serif">notify</text>
                <circle cx="296" cy="104" r="3.5" fill="#8FD14F" opacity="0.68"/>

                <!-- Motion paths for data packets -->
                <path id="sg-int-crm" d="M94 40 L200 104" fill="none" stroke="none"/>
                <path id="sg-int-erp" d="M50 104 L200 104" fill="none" stroke="none"/>
                <path id="sg-int-sms" d="M350 104 L200 104" fill="none" stroke="none"/>
                <path id="sg-int-cloud" d="M306 40 L200 104" fill="none" stroke="none"/>
                <!-- Animated packets -->
                <circle r="3.5" fill="#8FD14F">
                  <animateMotion dur="3s" repeatCount="indefinite" begin="0s">
                    <mpath href="#sg-int-erp"/>
                  </animateMotion>
                  <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="3s" repeatCount="indefinite" begin="0s"/>
                </circle>
                <circle r="3.5" fill="#8FD14F">
                  <animateMotion dur="3.5s" repeatCount="indefinite" begin="0.8s">
                    <mpath href="#sg-int-crm"/>
                  </animateMotion>
                  <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="3.5s" repeatCount="indefinite" begin="0.8s"/>
                </circle>
                <circle r="3.5" fill="rgba(143,209,79,0.7)">
                  <animateMotion dur="3s" repeatCount="indefinite" begin="1.6s">
                    <mpath href="#sg-int-sms"/>
                  </animateMotion>
                  <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="3s" repeatCount="indefinite" begin="1.6s"/>
                </circle>
                <circle r="3" fill="rgba(143,209,79,0.6)">
                  <animateMotion dur="3.8s" repeatCount="indefinite" begin="2.4s">
                    <mpath href="#sg-int-cloud"/>
                  </animateMotion>
                  <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="3.8s" repeatCount="indefinite" begin="2.4s"/>
                </circle>
                <!-- Status pulse on center -->
                <circle cx="200" cy="78" r="4" fill="rgba(143,209,79,0.18)" stroke="rgba(143,209,79,0.5)" stroke-width="1"/>
                <circle cx="200" cy="78" r="2" fill="#8FD14F"/>
              </svg>
            )}

            {visual === 'cloud' && (
              <svg viewBox="0 0 400 208" xmlns="http://www.w3.org/2000/svg" fill="none" class="h-full w-full" preserveAspectRatio="xMidYMid meet">
                <!-- Metrics panel left -->
                <rect x="20" y="20" width="202" height="168" rx="10" fill="rgba(255,255,255,0.025)" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>

                <!-- Metric: Uptime -->
                <text x="34" y="46" fill="rgba(255,255,255,0.42)" font-size="9" font-family="system-ui, sans-serif">Uptime</text>
                <text x="206" y="46" text-anchor="end" fill="#8FD14F" font-size="9" font-weight="600" font-family="system-ui, sans-serif">99.9%</text>
                <rect x="34" y="52" width="154" height="5" rx="2.5" fill="rgba(255,255,255,0.05)"/>
                <rect x="34" y="52" height="5" rx="2.5" fill="rgba(143,209,79,0.65)" width="153">
                  <animate attributeName="width" from="0" to="153" dur="2s" fill="freeze"/>
                </rect>

                <!-- Metric: Latencia -->
                <text x="34" y="78" fill="rgba(255,255,255,0.42)" font-size="9" font-family="system-ui, sans-serif">Latencia</text>
                <text x="206" y="78" text-anchor="end" fill="rgba(255,255,255,0.68)" font-size="9" font-family="system-ui, sans-serif">42 ms</text>
                <rect x="34" y="84" width="154" height="5" rx="2.5" fill="rgba(255,255,255,0.05)"/>
                <rect x="34" y="84" width="46" height="5" rx="2.5" fill="rgba(143,209,79,0.48)"/>

                <!-- Metric: Deploy -->
