---
// ── Hero Section ─────────────────────────────────────────────────
// Nexsas Time-Tracking adapted for Agencia Sur
// Video → gradient background (azul oscuro → slate)
// Badge + heading + description + feature list + 2 CTAs
---




<section class="relative overflow-hidden md:mt-4 lg:mt-6 xl:mt-[30px]">
  <div
    class="max-w-[1860px] mx-auto pt-[170px] sm:pt-[190px] md:pt-[210px] lg:pt-[220px] pb-[80px] sm:pb-[100px] lg:pb-[200px] max-h-[940px] md:rounded-[30px] xl:rounded-[50px] relative overflow-hidden"
  >

    

    <!-- Background image -->
    <img
      src="/bg-hero.png"
      alt=""
      class="pointer-events-none absolute inset-0 -z-20 h-full w-full object-cover"
      aria-hidden="true"
      loading="eager"
    />

    <!-- Overlay para legibilidad -->
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      aria-hidden="true"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-background-5/90 via-background-5/60 to-background-5"></div>
    </div>

    <div class="main-container">
      <div class="space-y-3 text-center md:text-left md:space-y-5">
        <!-- Badge -->
        <span
          data-ns-animate
          data-delay="0.1"
          class="bg-accent/10 text-accent/60 inline-block rounded-full px-5 py-1.5 text-tagline-2 font-medium backdrop-blur-[18px]"
        >
          Transformación digital
        </span>

        <!-- Heading -->
        <div class="space-y-2.5 md:space-y-4">
          <h1
            data-ns-animate
            data-delay="0.2"
            class="max-w-[720px] leading-[1.2]"
          >
            <span class="hero-text-gradient hero-text-color-1 block">
              Automatizamos tus procesos críticos.
            </span>
          </h1>
          <p
            data-ns-animate
            data-delay="0.3"
            class="text-accent/60 max-w-[580px]"
          >
            Transformamos la manera en que tu empresa opera. Desde la
            consultoría tecnológica hasta el desarrollo de soluciones web a
            medida, te ayudamos a optimizar cada aspecto de tu negocio.
          </p>

          <!-- Feature list -->
          <ul
            class="flex flex-col flex-wrap items-start gap-y-3 gap-x-9 pt-3 sm:flex-row sm:items-center md:pt-6"
          >
            <li data-ns-animate data-delay="0.4" class="flex items-center gap-2">
              <span
                class="inline-flex size-[18px] items-center justify-center rounded-full bg-primary-500/20"
              >
                <svg width="11" height="8" viewBox="0 0 11 8" fill="none" class="shrink-0">
                  <path
                    d="M4.81661 7.25605L10.2491 1.92144C10.5836 1.5959 10.5836 1.0697 10.2491 0.744158C9.91446 0.418614 9.37363 0.418614 9.03904 0.744158L4.2116 5.49012L1.96096 3.28807C1.62636 2.96253 1.08554 2.96253 0.750945 3.28807C0.416352 3.61362 0.416352 4.13982 0.750945 4.46536L3.6066 7.25605C3.77347 7.41841 3.99253 7.5 4.2116 7.5C4.43067 7.5 4.64974 7.41841 4.81661 7.25605Z"
                    fill="currentColor"
                    class="text-primary-500"
                  />
                </svg>
              </span>
              <span class="text-accent/60 text-tagline-2">
                Consultoría TI estratégica
              </span>
            </li>
            <li data-ns-animate data-delay="0.5" class="flex items-center gap-2">
              <span
                class="inline-flex size-[18px] items-center justify-center rounded-full bg-primary-500/20"
              >
                <svg width="11" height="8" viewBox="0 0 11 8" fill="none" class="shrink-0">
                  <path
                    d="M4.81661 7.25605L10.2491 1.92144C10.5836 1.5959 10.5836 1.0697 10.2491 0.744158C9.91446 0.418614 9.37363 0.418614 9.03904 0.744158L4.2116 5.49012L1.96096 3.28807C1.62636 2.96253 1.08554 2.96253 0.750945 3.28807C0.416352 3.61362 0.416352 4.13982 0.750945 4.46536L3.6066 7.25605C3.77347 7.41841 3.99253 7.5 4.2116 7.5C4.43067 7.5 4.64974 7.41841 4.81661 7.25605Z"
                    fill="currentColor"
                    class="text-primary-500"
                  />
                </svg>
              </span>
              <span class="text-accent/60 text-tagline-2">
                Automatización inteligente
              </span>
            </li>
            <li data-ns-animate data-delay="0.6" class="flex items-center gap-2">
              <span
                class="inline-flex size-[18px] items-center justify-center rounded-full bg-primary-500/20"
              >
                <svg width="11" height="8" viewBox="0 0 11 8" fill="none" class="shrink-0">
                  <path
                    d="M4.81661 7.25605L10.2491 1.92144C10.5836 1.5959 10.5836 1.0697 10.2491 0.744158C9.91446 0.418614 9.37363 0.418614 9.03904 0.744158L4.2116 5.49012L1.96096 3.28807C1.62636 2.96253 1.08554 2.96253 0.750945 3.28807C0.416352 3.61362 0.416352 4.13982 0.750945 4.46536L3.6066 7.25605C3.77347 7.41841 3.99253 7.5 4.2116 7.5C4.43067 7.5 4.64974 7.41841 4.81661 7.25605Z"
                    fill="currentColor"
                    class="text-primary-500"
                  />
                </svg>
              </span>
              <span class="text-accent/60 text-tagline-2">
                Desarrollo web a medida
              </span>
            </li>
          </ul>
        </div>
      </div>

      <!-- CTAs -->

      <ul
        class="mt-12 flex flex-col items-center gap-y-4 md:flex-row md:items-start md:gap-x-4 md:justify-start lg:mb-[100px]"
      >
        <li
          data-ns-animate
          data-delay="0.7"
          data-direction="left"
          data-offset="50"
          class="w-full sm:w-auto"
        >
          <a
            href="/contacto"
            
              class="btn btn-green hover:btn-white dark:hover:btn-accent mx-auto sm:mx-0 block md:inline-block w-[90%] md:w-auto btn-lg md:btn-xl border-0"
          >
            <span>Empecemos</span>
          </a>
        </li>
        <li
          data-ns-animate
          data-delay="0.9"
          data-direction="left"
          data-offset="50"
          class="w-full sm:w-auto"
        >
          <a
            href="/servicios"
            class="btn btn-lg md:btn-xl dark:btn-transparent dark:border btn-dark bg-accent/20 mx-auto block w-[90%] sm:mx-0 sm:w-auto md:inline-block hover:btn-accent"
          >
            <span>Ver servicios</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

