---
import { CircleCheck } from '@lucide/astro';
import BadgeSection  from '../components/blocks/BadgeSection.astro';
import FeatureListItem  from '../components/blocks/FeatureListItem.astro';

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL ?? '#';
---


<section class="relative overflow-hidden">
  <div
    class="w-full pt-[130px] sm:pt-[150px] md:pt-[160px] lg:pt-[150px] pb-[60px] sm:pb-[80px] lg:pb-[100px] max-h-[940px] relative overflow-hidden"
  >    
    <!-- Background: dot grid -->
    <svg class="pointer-events-none absolute inset-0 -z-20 h-full w-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <pattern id="hero-dots" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
          <circle cx="0.5" cy="0.5" r="0.9" fill="rgba(143,209,79,0.09)"/>
        </pattern>
      </defs>
      <rect width="1440" height="900" fill="url(#hero-dots)"/>
    </svg>

    <!-- Overlay para legibilidad -->
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      aria-hidden="true"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-background-5/90 via-background-5/60 to-background-5"></div>
    </div>

    <div class="main-container">
      <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-8">

        <!-- Left: text + CTAs -->
        <div class="w-full space-y-3 text-center md:text-left md:space-y-5 lg:max-w-[580px] lg:flex-shrink-0">
          <BadgeSection text="Transformación digital" />

          <div class="space-y-2.5 md:space-y-4">
            <h1 data-ns-animate data-delay="0.2" class="max-w-[720px] leading-[1.2]">
              <span class="block font-light tracking-[-0.02em] text-white">
                Automatizamos tus procesos <span class="text-accent-400" data-hero-rotate data-words='["críticos","manuales","repetitivos"]'>críticos</span>.
              </span>
            </h1>
            <p data-ns-animate data-delay="0.3" class="text-white max-w-[580px]">
              Transformamos la manera en que tu empresa opera. Desde la
              consultoría tecnológica hasta el desarrollo de soluciones web a
              medida, te ayudamos a optimizar cada aspecto de tu negocio.
            </p>
            <ul class="flex flex-col flex-wrap items-center gap-y-3 gap-x-6 pt-1 sm:flex-row sm:items-center md:items-start">
              <FeatureListItem text="Consultoría TI estratégica" delay={0.4} />
              <FeatureListItem text="Desarrollo web a medida" delay={0.5} />
              <FeatureListItem text="Automatización inteligente" delay={0.6} />
            </ul>
          </div>

          <ul class="mt-8 flex flex-col items-center gap-y-4 md:flex-row md:items-start md:gap-x-4 md:justify-start">
            <li data-ns-animate data-delay="0.7" data-direction="left" data-offset="50" class="w-full sm:w-auto">
              <button type="button" data-open-demo-modal data-modal-title="Hablemos de tu proyecto" data-cta-label="Enviar mensaje" data-solucion="Consulta general" data-description="Cuéntanos brevemente en qué podemos ayudarte y te contactamos a la brevedad." class="btn btn-green hover:btn-white dark:hover:btn-accent mx-auto sm:mx-0 block md:inline-block w-[90%] md:w-auto btn-lg md:btn-xl border-0">
                <span>Hablemos de tu proyecto</span>
              </button>
            </li>
            <li data-ns-animate data-delay="0.9" data-direction="left" data-offset="50" class="w-full sm:w-auto">
              <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lg md:btn-xl dark:btn-transparent dark:border btn-dark bg-accent/20 mx-auto block w-[90%] sm:mx-0 sm:w-auto md:inline-block hover:btn-accent">
                <span>Agenda una llamada</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Right: conceptual hub-and-spoke SVG -->
        <div data-ns-animate data-delay="0.4" class="flex w-full justify-center lg:flex-1 " aria-hidden="true">
          <svg style="filter: blur(2px);" class="w-[260px] sm:w-[320px] lg:w-full lg:max-w-[460px]" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" fill="none">

            <!-- Background reference rings -->
            <circle cx="250" cy="250" r="218" stroke="rgba(143,209,79,0.05)" stroke-width="1"/>
            <circle cx="250" cy="250" r="152" stroke="rgba(143,209,79,0.07)" stroke-width="0.8"/>

            <!-- ── Connection lines: hub → satellite nodes ── -->
            <!-- To Node A (right-low) -->
            <path id="h-a" d="M 250 250 L 368 318" stroke="rgba(143,209,79,0.3)" stroke-width="1.2" stroke-dasharray="6 14">
              <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.8s" repeatCount="indefinite"/>
            </path>
            <!-- To Node B (left-low) -->
            <path id="h-b" d="M 250 250 L 132 318" stroke="rgba(143,209,79,0.3)" stroke-width="1.2" stroke-dasharray="6 14">
              <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.5s" repeatCount="indefinite"/>
            </path>
            <!-- To Node C (top) -->
            <path id="h-c" d="M 250 250 L 250 118" stroke="rgba(143,209,79,0.3)" stroke-width="1.2" stroke-dasharray="6 14">
              <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="2.0s" repeatCount="indefinite"/>
            </path>
            <!-- To Node D (bottom) -->
            <path id="h-d" d="M 250 250 L 250 448" stroke="rgba(143,209,79,0.22)" stroke-width="1" stroke-dasharray="6 14">
              <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.6s" repeatCount="indefinite"/>
            </path>
            <!-- To Node E (far left) -->
            <path id="h-e" d="M 250 250 L 62 352" stroke="rgba(143,209,79,0.22)" stroke-width="1" stroke-dasharray="6 14">
              <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="2.2s" repeatCount="indefinite"/>
            </path>
            <!-- To Node F (far right-top) -->
            <path id="h-f" d="M 250 250 L 438 148" stroke="rgba(143,209,79,0.22)" stroke-width="1" stroke-dasharray="6 14">
              <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.9s" repeatCount="indefinite"/>
            </path>

            <!-- ── Secondary arcs (satellite ↔ satellite) ── -->
            <path d="M 368 318 C 408 200 310 125 250 118" stroke="rgba(143,209,79,0.1)" stroke-width="0.8" stroke-dasharray="4 10">
              <animate attributeName="stroke-dashoffset" from="0" to="-14" dur="3.0s" repeatCount="indefinite"/>
            </path>
            <path d="M 132 318 C 90 200 190 125 250 118" stroke="rgba(143,209,79,0.1)" stroke-width="0.8" stroke-dasharray="4 10">
              <animate attributeName="stroke-dashoffset" from="0" to="-14" dur="3.4s" repeatCount="indefinite"/>
            </path>
            <path d="M 368 318 L 438 148" stroke="rgba(143,209,79,0.08)" stroke-width="0.8" stroke-dasharray="4 10">
              <animate attributeName="stroke-dashoffset" from="0" to="-14" dur="2.8s" repeatCount="indefinite"/>
            </path>

            <!-- ── Moving data packets ── -->
            <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.4s" repeatCount="indefinite" begin="0s"><mpath href="#h-a"/></animateMotion></circle>
            <circle r="2" fill="rgba(143,209,79,0.55)"><animateMotion dur="2.4s" repeatCount="indefinite" begin="1.2s"><mpath href="#h-a"/></animateMotion></circle>
            <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.0s" repeatCount="indefinite" begin="0.5s"><mpath href="#h-b"/></animateMotion></circle>
            <circle r="2" fill="rgba(143,209,79,0.55)"><animateMotion dur="2.0s" repeatCount="indefinite" begin="1.3s"><mpath href="#h-b"/></animateMotion></circle>
            <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.6s" repeatCount="indefinite" begin="0.2s"><mpath href="#h-c"/></animateMotion></circle>
            <circle r="2" fill="rgba(143,209,79,0.55)"><animateMotion dur="2.6s" repeatCount="indefinite" begin="1.5s"><mpath href="#h-c"/></animateMotion></circle>
            <circle r="2.5" fill="rgba(143,209,79,0.7)"><animateMotion dur="2.8s" repeatCount="indefinite" begin="0.8s"><mpath href="#h-d"/></animateMotion></circle>
            <circle r="2.5" fill="rgba(143,209,79,0.7)"><animateMotion dur="3.0s" repeatCount="indefinite" begin="1.5s"><mpath href="#h-e"/></animateMotion></circle>
            <circle r="2.5" fill="rgba(143,209,79,0.7)"><animateMotion dur="2.5s" repeatCount="indefinite" begin="0.4s"><mpath href="#h-f"/></animateMotion></circle>

            <!-- ── Satellite nodes (ring 1, closer) ── -->
            <circle cx="368" cy="318" r="20" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.35)" stroke-width="1.5"/>
            <circle cx="368" cy="318" r="8" fill="rgba(143,209,79,0.45)"/>
            <circle cx="132" cy="318" r="20" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.35)" stroke-width="1.5"/>
            <circle cx="132" cy="318" r="8" fill="rgba(143,209,79,0.45)"/>
            <circle cx="250" cy="118" r="24" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.4)" stroke-width="1.5"/>
            <circle cx="250" cy="118" r="10" fill="rgba(143,209,79,0.5)"/>

            <!-- ── Satellite nodes (ring 2, outer) ── -->
            <circle cx="250" cy="448" r="13" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.25)" stroke-width="1"/>
            <circle cx="250" cy="448" r="5" fill="rgba(143,209,79,0.4)"/>
            <circle cx="62" cy="352" r="13" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.25)" stroke-width="1"/>
            <circle cx="62" cy="352" r="5" fill="rgba(143,209,79,0.4)"/>
            <circle cx="438" cy="148" r="13" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.25)" stroke-width="1"/>
            <circle cx="438" cy="148" r="5" fill="rgba(143,209,79,0.4)"/>

            <!-- ── Central Hub ── -->
            <!-- Outer rotating ring -->
            <circle cx="250" cy="250" r="76" stroke="rgba(143,209,79,0.18)" stroke-width="1" stroke-dasharray="5 9" fill="transparent">
              <animateTransform attributeName="transform" type="rotate" from="0 250 250" to="360 250 250" dur="24s" repeatCount="indefinite"/>
            </circle>
            <!-- Hub body -->
            <circle cx="250" cy="250" r="58" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.4)" stroke-width="1.5"/>
            <circle cx="250" cy="250" r="42" fill="rgba(143,209,79,0.05)" stroke="rgba(143,209,79,0.2)" stroke-width="1"/>
            <!-- Center pulsing dot -->
            <circle cx="250" cy="250" r="11" fill="rgba(143,209,79,0.9)">
              <animate attributeName="r" values="11;15;11" dur="2.2s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="1;0.45;1" dur="2.2s" repeatCount="indefinite"/>
            </circle>
          </svg>
        </div>

      </div>
    </div>

    <!-- Scroll cue: fixed (no absolute) para que el margen quede calculado
         siempre sobre el 100vh real de la pantalla, sin depender de la
         altura del Hero (que varía por breakpoint/contenido). Fuera del
         sistema data-ns-animate a propósito (no es contenido que revela
         al hacer scroll, es un elemento de UI fijo) — su fade lo maneja
         initHeroScrollCue en animations.ts según la posición de scroll. -->
    <a
      id="hero-scroll-cue"
      href="#servicios"
      aria-label="Ver más contenido"
      class="scroll-cue fixed bottom-6 left-1/2 z-30 hidden -translate-x-1/2 md:flex"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7" />
      </svg>
    </a>
  </div>
</section>

