---
// Footer — Simple standard layout
---

<footer class="bg-secondary dark:bg-background-8 pt-16 pb-8">
  <div class="main-container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      
      <!-- Brand -->
      <div class="lg:col-span-1">
        <img src="/logo.svg" alt="AgenciaSur" class="h-8 w-auto mb-4" />
        <p class="text-tagline-1 text-white/60">
          Transformación digital para empresas que quieren crecer.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-tagline-1 font-semibold text-white mb-4">Navegación</h4>
        <ul class="space-y-2">
          <li><a href="/" class="footer-link">Inicio</a></li>
          <li><a href="/servicios" class="footer-link">Servicios</a></li>
          <li><a href="/soluciones" class="footer-link">Soluciones</a></li>
          <li><a href="/casos-exito" class="footer-link">Casos de éxito</a></li>
          <li><a href="/contacto" class="footer-link">Contacto</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-tagline-1 font-semibold text-white mb-4">Servicios</h4>
        <ul class="space-y-2">
          <li><a href="/servicios#desarrollo-web" class="footer-link">Desarrollo Web</a></li>
          <li><a href="/servicios#apps-moviles" class="footer-link">Apps Móviles</a></li>
          <li><a href="/servicios#sistemas-a-medida" class="footer-link">Sistemas a Medida</a></li>
          <li><a href="/servicios#consultoria" class="footer-link">Consultoría</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-tagline-1 font-semibold text-white mb-4">Contacto</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:contacto@agenciasur.cl" class="footer-link">contacto@agenciasur.cl</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-tagline-1 text-white/60">Lun - Vie: 9:00 - 18:00</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-stroke-7 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-tagline-2 text-white/40">
        © {new Date().getFullYear()} Agencia Sur. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacidad" class="text-tagline-2 text-white/40 hover:text-accent-400 transition-colors">Privacidad</a>
        <a href="/terminos" class="text-tagline-2 text-white/40 hover:text-accent-400 transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>