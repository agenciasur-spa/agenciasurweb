---
const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL ?? '#';
---

<footer class="bg-secondary dark:bg-background-8 pt-16 pb-8">
  <div class="main-container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4 w-fit">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="size-8 shrink-0">
            <path d="M10,0 C15.5228475,0 20,4.4771525 20,10 C20,15.5228475 15.5228475,20 10,20 C4.4771525,20 0,15.5228475 0,10 C0,4.4771525 4.4771525,0 10,0 Z M10,1 C5.02943725,1 1,5.02943725 1,10 C1,14.9705627 5.02943725,19 10,19 C14.9705627,19 19,14.9705627 19,10 C19,5.02943725 14.9705627,1 10,1 Z" fill-opacity="0.525" fill="#D8D8D8"/>
            <path d="M12.5,10 C12.5,11.3807119 11.3807119,12.5 10,12.5 C8.61928813,12.5 7.5,11.3807119 7.5,10 C7.5,8.61928813 8.61928813,7.5 10,7.5 C11.3807119,7.5 12.5,8.61928813 12.5,10 Z M8.5,10 C8.5,10.8284271 9.17157288,11.5 10,11.5 C10.8284271,11.5 11.5,10.8284271 11.5,10 C11.5,9.17157288 10.8284271,8.5 10,8.5 C9.17157288,8.5 8.5,9.17157288 8.5,10 Z" stroke="#FFFFFF" fill="#D8D8D8"/>
            <circle cx="4" cy="4" r="4" fill="#8FD14F"/>
          </svg>
          <span class="text-lg font-light leading-none" style="font-family: 'Inter Tight', sans-serif;">
            <span class="text-white">Agencia</span><span style="color: #8FD14F;">Sur</span>
          </span>
        </a>
        <p class="text-tagline-1 text-white/60">
          Transformación digital para empresas que quieren crecer.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-tagline-1 font-semibold text-white mb-4">Navegación</h4>
        <ul class="space-y-2">
          <li><a href="/" class="footer-link">Inicio</a></li>
          <li><a href="/servicios" class="footer-link">Servicios</a></li>
          <li><a href="/soluciones" class="footer-link">Soluciones</a></li>
          <li><a href="/casos-exito" class="footer-link">Casos de éxito</a></li>
          <li><a href="/contacto" class="footer-link">Contacto</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-tagline-1 font-semibold text-white mb-4">Servicios</h4>
        <ul class="space-y-2">
          <li><a href="/servicios#servicio-desarrollo-web" class="footer-link">Desarrollo Web</a></li>
          <li><a href="/servicios#servicio-automatizacion" class="footer-link">Automatización</a></li>
          <li><a href="/servicios#servicio-consultoria" class="footer-link">Consultoría</a></li>
          <li><a href="/servicios#servicio-infraestructura-cloud" class="footer-link">Infraestructura y Cloud</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-tagline-1 font-semibold text-white mb-4">Contacto</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:contacto@agenciasur.cl" class="footer-link">contacto@agenciasur.cl</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-tagline-1 text-white/60">
              Lun - Vie: 9:00 - 18:00 ·
              <span id="footer-local-time" data-footer-clock>--:--</span> en Santiago
            </span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-accent-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="footer-link">Agendar una llamada</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-stroke-7 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-tagline-2 text-white/40">
        © {new Date().getFullYear()} Agencia Sur. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
      </div>
    </div>
  </div>
</footer>

<script>
  // Reloj local del footer — patron "IST -> 20:04" de trionn.com/services,
  // pero con la hora real de Santiago (no la del visitante), ya que
  // Agencia Sur opera desde ahi. Se actualiza cada 30s, es puramente
  // decorativo (no bloquea nada si falla).
  function updateFooterClock() {
    const els = document.querySelectorAll('[data-footer-clock]');
    if (!els.length) return;
    try {
      const time = new Intl.DateTimeFormat('es-CL', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'America/Santiago',
      }).format(new Date());
      els.forEach((el) => {
        el.textContent = time;
      });
    } catch {
      // Intl/timeZone no soportado: deja el placeholder "--:--".
    }
  }

  updateFooterClock();
  setInterval(updateFooterClock, 30000);
</script>