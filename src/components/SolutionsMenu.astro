---
interface Props {
  Uii?: string;
}
const { Uii } = Astro.props;

import { ShoppingCart, Users, LifeBuoy, Sparkles } from '@lucide/astro';
import { sanityClient } from '../lib/sanity';

// Slug → icon mapping (hardcoded Lucide components — can't be dynamic)
const iconMap: Record<string, typeof ShoppingCart> = {
  'sistema-de-compras': ShoppingCart,
  'gestion-personal-transitorio': Users,
  'mesa-de-ayuda': LifeBuoy,
};

const fallbackSolutions = [
  { title: 'Sistema de Compras', slug: 'sistema-de-compras', tagline: 'Digitaliza el proceso de adquisiciones y haz eficiente tu abastecimiento.' },
  { title: 'Personal Transitorio', slug: 'gestion-personal-transitorio', tagline: 'Estandariza solicitudes, evalúa y valida personal externo en una sola plataforma.' },
  { title: 'Mesa de Ayuda', slug: 'mesa-de-ayuda', tagline: 'Omnicanalidad y base de conocimientos para una autoatención inteligente.' },
];

let solutions: { title: string; slug: string; tagline: string }[] = fallbackSolutions;

if (sanityClient) {
  try {
    const sanitySolutions = await sanityClient.fetch(
      `*[_type == "solucion"] | order(order asc) { title, "slug": slug.current, tagline }`
    );
    if (sanitySolutions && sanitySolutions.length > 0) {
      solutions = sanitySolutions;
    }
  } catch {
    // Sanity failed — use fallbacks
  }
}

const col1 = solutions.slice(0, Math.ceil(solutions.length / 2));
const col2 = solutions.slice(Math.ceil(solutions.length / 2));
---

<div>
  <!-- Bridge -->
  <div
    class="dropdown-menu-bridge fixed left-1/2 -translate-x-1/2 top-full w-full h-3 z-40 min-w-[952px] pointer-events-none bg-transparent opacity-0"
  ></div>

  <!-- Dropdown -->
  <div
    id={Uii}
    class="dropdown-menu fixed left-1/2 -translate-x-1/2 top-full mt-2 pointer-events-none transition-all duration-300 opacity-0 md:w-[952px] w-full bg-background-6 z-50 rounded-[20px] p-4 border border-stroke-1 dark:border-stroke-7"
  >
    <div class="flex items-start md:gap-x-6 gap-y-6">
      <!-- Col 1 -->
      <ul class="space-y-2 flex-1">
        {col1.map((item) => {
          const Icon = iconMap[item.slug] || Sparkles;
          return (
          <li>
            <a
              href={`/soluciones/${item.slug}`}
              class="p-3 rounded-[10px] flex items-start gap-3 transition-all duration-300 relative group"
            >
              <div
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-white/5 opacity-0 group-hover:opacity-100 rounded-[10px] z-0 transition-all duration-400"
              ></div>
              <div class="mt-1.5 relative z-10">
                <div
                  class="border-stroke-1 relative z-10 mt-1 flex size-7 shrink-0 items-center justify-center rounded-lg border p-1 dark:border-stroke-7"
                >
                  <Icon color="currentColor" size={48} stroke-width={1} class="text-accent-400" />
                </div>
              </div>
              <div class="relative z-10 space-y-0.5">
                <span class="text-accent text-tagline-1 font-normal block">{item.title}</span>
                <span class="text-accent/60 text-tagline-3 font-normal block">{item.tagline}</span>
              </div>
            </a>
          </li>
          );
        })}
      </ul>

      <!-- Col 2 -->
      <ul class="space-y-2 flex-1">
        {col2.map((item) => {
          const Icon = iconMap[item.slug] || Sparkles;
          return (
          <li>
            <a
              href={`/soluciones/${item.slug}`}
              class="p-3 rounded-[10px] flex items-start gap-3 transition-all duration-300 relative group"
            >
              <div
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-white/5 opacity-0 group-hover:opacity-100 rounded-[10px] z-0 transition-all duration-400"
              ></div>
              <div class="mt-1.5 relative z-10">
                <div
                  class="border-stroke-1 relative z-10 mt-1 flex size-7 shrink-0 items-center justify-center rounded-lg border border-white/50 p-1 dark:border-white/10"
                >
                  <Icon color="currentColor" size={48} stroke-width={1} class="text-accent-400" />
                </div>
              </div>
              <div class="relative z-10 space-y-0.5">
                <span class="text-accent text-tagline-1 font-normal block">{item.title}</span>
                <span class="text-accent/60 text-tagline-3 font-normal block">{item.tagline}</span>
              </div>
            </a>
          </li>
          );
        })}
      </ul>

      <!-- Col 3 — Video + CTA -->
      <figure class="flex-1 w-full space-y-3">
        <p class="text-tagline-2 font-medium text-white/60">Soluciones a medida</p>
        <a href="/contacto">
          <figure
            class="overflow-hidden rounded-[14px] max-w-full w-full min-h-[200px] relative group"
          >
            <video
              src="https://www.pexels.com/download/video/34279721/"
              class="w-full h-full object-cover rounded-[14px] "
              autoplay muted loop
            ></video>
           <div class="absolute top-4 backdrop-blur-sm bg-background-3/5 rounded-[14px] p-3 m-4">
                <span class="text-tagline-1 font-medium text-white/70">Agenda una demo</span>
                <br/>
                <span class="text-white/70 max-w-[212px] w-full text-tagline-3 font-normal">
                    Descubre cómo nuestras soluciones se adaptan a tu operación.
                </span>
            </div>
          </figure>
        </a>
      </figure>
    </div>
  </div>
</div>
