---
interface Props {
  Uii?: string;
}
const { Uii } = Astro.props;

import { ShoppingCart, Users, LifeBuoy, Sparkles } from '@lucide/astro';

const solutions = [
  {
    title: 'Sistema de Compras',
    icon: ShoppingCart,
    href: '/soluciones/sistema-de-compras',
    description: 'Digitaliza el proceso de adquisiciones y haz eficiente tu abastecimiento.',
  },
  {
    title: 'Personal Transitorio',
    icon: Users,
    href: '/soluciones/gestion-personal-transitorio',
    description: 'Estandariza solicitudes, evalúa y valida personal externo en una sola plataforma.',
  },
  {
    title: 'Mesa de Ayuda',
    icon: LifeBuoy,
    href: '/soluciones/mesa-de-ayuda',
    description: 'Omnicanalidad y base de conocimientos para una autoatención inteligente.',
  },
  {
    title: 'Próximamente',
    icon: Sparkles,
    href: '#',
    description: 'Nuevas soluciones en desarrollo.',
  },
];

const col1 = solutions.slice(0, 2);
const col2 = solutions.slice(2);
---

<div>
  <!-- Bridge -->
  <div
    class="dropdown-menu-bridge fixed left-1/2 -translate-x-1/2 top-full w-full h-3 z-40 min-w-[952px] pointer-events-none bg-transparent opacity-0"
  ></div>

  <!-- Dropdown -->
  <div
    id={Uii}
    class="dropdown-menu fixed left-1/2 -translate-x-1/2 top-full mt-2 pointer-events-none transition-all duration-300 opacity-0 md:w-[952px] w-full bg-background-6 z-50 rounded-[20px] p-4 border border-stroke-1 dark:border-background-7"
  >
    <div class="flex items-start md:gap-x-6 gap-y-6">
      <!-- Col 1 -->
      <ul class="space-y-2 flex-1">
        {col1.map((item) => (
          <li>
            <a
              href={item.href}
              class="p-3 rounded-[10px] flex items-start gap-3 transition-all duration-300 relative group"
            >
              <div
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-background-3 dark:bg-background-7 opacity-0 group-hover:opacity-100 rounded-[10px] z-0 transition-all duration-400"
              ></div>
              <div class="mt-1.5 relative z-10">
                <div
                  class="border-stroke-1 relative z-10 mt-1 flex size-7 shrink-0 items-center justify-center rounded-lg border p-1 dark:border-white/10"
                >
                  <item.icon />
                </div>
              </div>
              <div class="relative z-10 space-y-0.5">
                <span class="text-accent text-tagline-1 font-normal block">{item.title}</span>
                <span class="text-accent/60 text-tagline-3 font-normal block">{item.description}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <!-- Col 2 -->
      <ul class="space-y-2 flex-1">
        {col2.map((item) => (
          <li>
            <a
              href={item.href}
              class="p-3 rounded-[10px] flex items-start gap-3 transition-all duration-300 relative group"
            >
              <div
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-background-3 dark:bg-background-7 opacity-0 group-hover:opacity-100 rounded-[10px] z-0 transition-all duration-400"
              ></div>
              <div class="mt-1.5 relative z-10">
                <div
                  class="border-stroke-1 relative z-10 mt-1 flex size-7 shrink-0 items-center justify-center rounded-lg border p-1 dark:border-white/10"
                >
                  <item.icon />
                </div>
              </div>
              <div class="relative z-10 space-y-0.5">
                <span class="text-accent text-tagline-1 font-normal block">{item.title}</span>
                <span class="text-accent/60 text-tagline-3 font-normal block">{item.description}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <!-- Col 3 — Video + CTA -->
      <figure class="flex-1 w-full space-y-3">
        <p class="text-tagline-2 font-medium text-white/60">Soluciones a medida</p>
        <a href="/contacto">
          <figure
            class="overflow-hidden rounded-[14px] max-w-full w-full min-h-[200px] relative group"
          >
            <video
              src="https://www.pexels.com/download/video/34279721/"
              class="w-full h-full object-cover rounded-[14px] group-hover:scale-105 transition-all duration-500 ease-in-out"
              autoplay muted loop
            ></video>
            <div
              class="absolute group-hover:top-5 group-hover:left-5 top-4 left-4 size-full space-y-1 transition-all duration-500 ease-in-out"
            >
              <p class="text-white text-tagline-1 font-medium">Agenda una demo</p>
              <p class="text-white/60 max-w-[212px] w-full text-tagline-3 font-normal">
                Descubrí cómo nuestras soluciones se adaptan a tu operación.
              </p>
            </div>
          </figure>
        </a>
      </figure>
    </div>
  </div>
</div>
