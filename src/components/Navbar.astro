---
// Minimal, pill, backdrop-blur, dropdown menu
import ServiceMenu from "../components/ServiceMenu.astro";
import SolutionsMenu from "../components/SolutionsMenu.astro";
import CasosExitoMenu from "../components/CasosExitoMenu.astro";
import MobileMenu from "../components/MobileMenu.astro";
---

<header>
 <div
  data-ns-animate
  data-direction="up"
  data-offset="20"
  class="header-two bg-secondary/50 dark:bg-background-8/50 fixed top-14 left-1/2 z-50 mx-auto flex w-full max-w-[350px] -translate-x-1/2 items-center justify-between rounded-full px-5 py-2.5 backdrop-blur-[25px] max-md:!top-8 min-[425px]:max-w-[380px] min-[500px]:max-w-[450px] sm:max-w-[540px] md:max-w-[720px] lg:max-w-[1290px] xl:py-0"
>
    <div>
      <a href="/" aria-label="AgenciaSur — inicio" class="flex items-center gap-2">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0">
          <path d="M10,0 C15.5228475,0 20,4.4771525 20,10 C20,15.5228475 15.5228475,20 10,20 C4.4771525,20 0,15.5228475 0,10 C0,4.4771525 4.4771525,0 10,0 Z M10,1 C5.02943725,1 1,5.02943725 1,10 C1,14.9705627 5.02943725,19 10,19 C14.9705627,19 19,14.9705627 19,10 C19,5.02943725 14.9705627,1 10,1 Z" fill-opacity="0.525" fill="#D8D8D8"/>
          <path d="M12.5,10 C12.5,11.3807119 11.3807119,12.5 10,12.5 C8.61928813,12.5 7.5,11.3807119 7.5,10 C7.5,8.61928813 8.61928813,7.5 10,7.5 C11.3807119,7.5 12.5,8.61928813 12.5,10 Z M8.5,10 C8.5,10.8284271 9.17157288,11.5 10,11.5 C10.8284271,11.5 11.5,10.8284271 11.5,10 C11.5,9.17157288 10.8284271,8.5 10,8.5 C9.17157288,8.5 8.5,9.17157288 8.5,10 Z" stroke="#FFFFFF" fill="#D8D8D8"/>
          <circle cx="4" cy="4" r="4" fill="#8FD14F"/>
        </svg>
        <span class="text-sm font-light leading-none" style="font-family: 'Inter Tight', sans-serif;">
          <span class="text-white">Agencia</span><span style="color: #8FD14F;">Sur</span>
        </span>
      </a>
    </div>
    <nav class="hidden items-center xl:flex">
      <ul class="flex items-center">
        <li
          class="nav-item relative cursor-pointer py-2.5"
          data-menu="company-mega-menu-v2"
        >
          <a
            href="#"
            class="hover:text-accent hover:border-accent light:hover:border-stroke-7 dark:hover:border-stroke-7 text-tagline-1 text-accent/60 dark:text-accent/60 dark:hover:text-accent group flex items-center gap-1 rounded-full border border-transparent px-4 py-2 font-normal transition-all duration-200"
          >
            <span>Servicios</span>
            <span
              class="nav-arrow block origin-center translate-y-px transition-all duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="stroke-accent/60 group-hover:stroke-accent size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </a>

          <div>
            <ServiceMenu Uii="company-mega-menu-v2" />
          </div>
        </li>
        <li
          class="nav-item relative cursor-pointer py-2.5"
          data-menu="product-mega-menu"
        >
          <a
            href="#"
            class="hover:text-accent hover:border-accent light:hover:border-stroke-7 dark:hover:border-stroke-7 text-tagline-1 text-accent/60 dark:text-accent/60 dark:hover:text-accent group flex items-center gap-1 rounded-full border border-transparent px-4 py-2 font-normal transition-all duration-200"
          >
            <span>Soluciones</span>
            <span
              class="nav-arrow block origin-center translate-y-px transition-all duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="stroke-accent/60 group-hover:stroke-accent size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </a>
          <SolutionsMenu Uii="product-mega-menu" />
        </li>

        <li class="nav-item relative cursor-pointer py-2.5">
          <a
            href="/nosotros"
            class="hover:text-accent hover:border-accent light:hover:border-stroke-7 dark:hover:border-stroke-7 text-tagline-1 text-accent/60 dark:text-accent/60 dark:hover:text-accent group flex items-center gap-1 rounded-full border border-transparent px-4 py-2 font-normal transition-all duration-200"
          >
            <span>Nosotros</span>
          </a>
        </li>

        <li
          class="nav-item relative cursor-pointer py-2.5"
          data-menu="casos-exito-dropdown"
        >
          <a
            href="#"
            class="hover:text-accent hover:border-accent light:hover:border-stroke-7 dark:hover:border-stroke-7 text-tagline-1 text-accent/60 dark:text-accent/60 dark:hover:text-accent group flex items-center gap-1 rounded-full border border-transparent px-4 py-2 font-normal transition-all duration-200"
          >
            <span>Casos de Éxito</span>
            <span
              class="nav-arrow block origin-center translate-y-px transition-all duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="stroke-accent/60 group-hover:stroke-accent size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </a>
          <CasosExitoMenu Uii="casos-exito-dropdown" />
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center justify-center xl:flex">
        <a
          href="/contacto"
          class="btn btn-md hover:btn-white dark:hover:btn-white-dark btn-white-dark dark:btn-white dark:text-secondary"
        >
          <span>Contacto</span>
        </a>
      </div>
      <div class="block xl:hidden">
        <button
          class="nav-hamburger bg-background-4 dark:bg-background-6 flex size-12 cursor-pointer flex-col items-center justify-center gap-[5px] rounded-full"
        >
          <span class="sr-only">Menu</span>
          <span class="bg-stroke-9 dark:bg-stroke-1 block h-0.5 w-6"></span>
          <span class="bg-stroke-9 dark:bg-stroke-1 block h-0.5 w-6"></span>
          <span class="bg-stroke-9 dark:bg-stroke-1 block h-0.5 w-6"></span>
        </button>
      </div>
    </div>
  </div>
  <MobileMenu />
</header>
