            </div>
          </div>
        </div>
      </div>
      <div
        data-ns-animate
        data-delay="0.5"
        class="border-stroke-1 dark:border-stroke-7 bg-background-1 dark:bg-background-6 rounded-[20px] border p-7 lg:max-w-full lg:p-[42px]"
      >
        <div class="grid grid-cols-12 items-center gap-y-10 lg:gap-20 xl:gap-[100px]">
          <div class="col-span-12 lg:col-span-6">
            <div class="flex items-center gap-8">
              <figure
                class="h-full max-h-[317px] w-full max-w-[326px] overflow-hidden rounded-[20px]"
              >
                <img
                  src="./images/ns-img-102.png"
                  alt="revenue"
                  class="h-full w-full object-cover dark:hidden"
                />
                <img
                  src="./images/ns-img-dark-74.png"
                  alt="revenue"
                  class="hidden h-full w-full object-cover dark:block"
                />
              </figure>
              <figure class="h-full max-h-[178px] w-full max-w-[255px] overflow-hidden rounded-2xl">
                <img
                  src="./images/ns-img-103.png"
                  alt="balance"
                  class="h-full w-full object-cover dark:hidden"
                />
                <img
                  src="./images/ns-img-dark-75.png"
                  alt="balance"
                  class="hidden h-full w-full object-cover dark:block"
