                    class="hidden h-full w-full object-cover dark:block"
                  />
                </figure>
                <div>
                  <div class="space-y-4">
                    <div class="flex cursor-pointer -space-x-3.5">
                      <img
                        class="bg-ns-green inline-block size-11 rounded-full ring-4 ring-white"
                        src="./images/ns-avatar-1.png"
                        alt="Avatar 1"
                      />
                      <img
                        class="bg-ns-green inline-block size-11 rounded-full ring-4 ring-white"
                        src="./images/ns-avatar-2.png"
                        alt="Avatar 2"
                      />
                      <img
                        class="bg-ns-green relative z-0 inline-block size-11 rounded-full ring-4 ring-white"
                        src="./images/ns-avatar-3.png"
                        alt="Avatar 3"
                      />
                      <div
                        class="bg-ns-green text-secondary/80 text-tagline-3 relative z-10 inline-flex size-11 items-center justify-center rounded-full font-medium ring-4 ring-white"
                      >
                        99+
                      </div>
                    </div>
                    <div>
                      <p class="text-secondary dark:text-accent font-medium">Trusted by 20k+</p>
                      <p class="text-tagline-2 font-normal">Customers across the globe</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        data-ns-animate
        data-delay="0.7"
        class="border-stroke-1 dark:border-stroke-7 bg-background-1 dark:bg-background-6 rounded-[20px] border p-7 lg:max-w-full lg:p-[42px]"
      >
        <div class="grid grid-cols-12 items-center gap-y-10 lg:gap-20 xl:gap-[100px]">
          <div class="col-span-12 lg:col-span-6">
            <div class="flex items-start -space-x-20">
              <figure class="w-full max-w-[408px] overflow-hidden rounded-[20px]">
                <img
                  src="./images/ns-img-393.svg"
                  alt="revenue"
                  class="h-full w-full object-cover dark:hidden"
                />
                <img
                  src="./images/ns-img-dark-212.svg"
                  alt="revenue"
                  class="hidden h-full w-full object-cover dark:block"
                />
              </figure>
              <figure class="mt-4 w-full max-w-[225px] overflow-hidden rounded-2xl">
                <img
                  src="./images/ns-img-395.svg"
                  alt="balance"
                  class="h-full w-full object-cover dark:hidden"
                />
                <img
                  src="./images/ns-img-dark-214.svg"
                  alt="balance"
                  class="hidden h-full w-full object-cover dark:block"
                />
              </figure>
            </div>
          </div>
          <div class="col-span-12 lg:col-span-6">
            <div class="space-y-8">
              <div class="space-y-2">
                <h3>Machine learning & AI</h3>
                <p class="w-full max-w-[493px]">
                  Utilize advanced predictive analytics to proactively identify potential threats
                  before they escalate. by analyzing patterns and trends in data.
                </p>
              </div>
              <div>
                <a
                  href="./service-details.html"
                  class="btn hover:btn-primary dark:btn-transparent btn-white btn-md"
                  ><span>View more</span></a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>



  
  <ContactoFooter />
</Layout>
