---
import Layout from '../../layouts/Layout.astro';
import ContactoFooter from '../../components/ContactoFooter.astro';
import { sanityClient } from '../../lib/sanity';
import type { Solucion } from '../../types/sanity';
import { ShoppingCart, Users, LifeBuoy } from '@lucide/astro';

let soluciones: Solucion[] = [];
if (sanityClient) {
  try {
    soluciones = await sanityClient.fetch(
    `*[_type == "solucion"] | order(order asc) {
      _id,
      title,
      "slug": slug.current,
      tagline,
      features,
      icon
    }`);
  } catch {
    // Sanity query failed
  }
}

const fallbackSoluciones = [
  {
    title: 'Sistema de Compras',
    slug: 'sistema-de-compras',
    tagline: 'Digitaliza el proceso de adquisiciones y haz eficiente tu abastecimiento.',
    features: ['Control de cumplimiento SLA', 'Reducción 100% papel', 'Tracking en tiempo real'],
    icon: '🛒',
  },
  {
    title: 'Personal Transitorio',
    slug: 'gestion-personal-transitorio',
    tagline: 'Estandariza solicitudes, evalúa y valida personal externo en una sola plataforma.',
    features: ['Solicitudes estandarizadas', 'Evaluación centralizada', 'Validación de documentación'],
    icon: '👥',
  },
  {
    title: 'Mesa de Ayuda',
    slug: 'mesa-de-ayuda',
    tagline: 'Omnicanalidad y base de conocimientos para una autoatención inteligente.',
    features: ['Canales unificados', 'Base de conocimiento IA', 'SLA automatizado'],
    icon: '🛟',
  },
];

const displaySoluciones = soluciones.length > 0 ? soluciones : fallbackSoluciones;
---

<Layout title="Soluciones | Agencia Sur">

  <!-- Hero -->
  <section class="pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-green-v2 mb-5">Nuestros Sistemas</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto fw-300">
            Soluciones que resuelven problemas reales
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto">
            Sistemas cerrados, probados en producción, diseñados para procesos empresariales críticos.
            No vendemos software genérico — entregamos herramientas que encajan en tu operación.
          </p>
        </div>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-12 xl:gap-8 md:gap-8 gap-y-5">
        {displaySoluciones.map((sol, i) => (
          <div data-ns-animate data-delay={0.4 + i * 0.1} class="col-span-12 md:col-span-6 xl:col-span-4">
            <a href={`/soluciones/${sol.slug}`} class="group block">
              
              <div class="px-6 py-8 rounded-[20px] bg-background-3 dark:bg-background-7 space-y-5 text-center hover:translate-y-[-10px] transition-transform duration-500 ease-in-out">
                <div class="flex items-center justify-center">
                  <div class="flex size-14 items-center justify-center rounded-2xl bg-primary-500/10 dark:bg-accent/10">
                    {sol.icon && <span class="text-2xl">{sol.icon}</span>}
                  </div>
                </div>
                <div class="space-y-2">
                  <h3 class="text-heading-5">{sol.title}</h3>
                  <p>{sol.tagline}</p>
                </div>
                {sol.features && sol.features.length > 0 && (
                  <ul class="space-y-2 text-left w-full max-w-[280px] mx-auto">
                    {sol.features.slice(0, 3).map((f) => (
                      <li class="flex items-center gap-2">
                        <span class="inline-flex size-[18px] shrink-0 items-center justify-center rounded-full bg-primary-500/20">
                          <svg width="11" height="8" viewBox="0 0 11 8" fill="none">
                            <path d="M4.81661 7.25605L10.2491 1.92144C10.5836 1.5959 10.5836 1.0697 10.2491 0.744158C9.91446 0.418614 9.37363 0.418614 9.03904 0.744158L4.2116 5.49012L1.96096 3.28807C1.62636 2.96253 1.08554 2.96253 0.750945 3.28807C0.416352 3.61362 0.416352 4.13982 0.750945 4.46536L3.6066 7.25605C3.77347 7.41841 3.99253 7.5 4.2116 7.5C4.43067 7.5 4.64974 7.41841 4.81661 7.25605Z" fill="currentColor" class="text-primary-500" />
                          </svg>
                        </span>
                        <span class="text-tagline-2">{f}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <div>
                  <span class="btn btn-white dark:btn-transparent dark:hover:btn-accent hover:btn-secondary btn-md">
                    <span>Ver detalle</span>
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>


      
    </div>
  </section>


<!-- =========================
Services section
===========================-->

  <div class="main-container">
    <div class="flex flex-wrap gap-4 space-y-[42px]">
      <div
        data-ns-animate
        data-delay="0.4"
        class="border-stroke-1 dark:border-stroke-7 bg-background-1 dark:bg-background-6 rounded-[20px] border p-7 lg:max-w-full lg:p-[42px]"
      >
        <div class="grid grid-cols-12 items-center gap-y-10 lg:gap-20 xl:gap-[100px]">
          <div class="col-span-12 lg:col-span-6">
            <div class="space-y-8">
              <div class="space-y-2">
                <h3>Big data consulting</h3>
                <p class="w-full max-w-[410px]">
                  Utilize comprehensive data security frameworks to effectively safeguard sensitive
                  information from unauthorized access and breaches.
                </p>
              </div>
              <div>
                <a
                  href="./service-details.html"
