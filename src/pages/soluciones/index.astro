---
import Layout from '../../layouts/Layout.astro';
import ContactoFooter from '../../components/ContactoFooter.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from '../../lib/sanity';
import type { Solucion } from '../../types/sanity';
import { ShoppingCart, Users, LifeBuoy } from '@lucide/astro';

let soluciones: Solucion[] = [];
if (sanityClient) {
  try {
    soluciones = await sanityClient.fetch(
    `*[_type == "solucion"] | order(order asc) {
      _id,
      title,
      "slug": slug.current,
      tagline,
      features,
      icon
    }`);
  } catch {
    // Sanity query failed
  }
}

const fallbackSoluciones = [
  {
    title: 'Sistema de Compras',
    slug: 'sistema-de-compras',
    tagline: 'Digitaliza el proceso de adquisiciones y haz eficiente tu abastecimiento.',
    features: ['Control de cumplimiento SLA', 'Reducción 100% papel', 'Tracking en tiempo real'],
    icon: '🛒',
  },
  {
    title: 'Personal Transitorio',
    slug: 'gestion-personal-transitorio',
    tagline: 'Estandariza solicitudes, evalúa y valida personal externo en una sola plataforma.',
    features: ['Solicitudes estandarizadas', 'Evaluación centralizada', 'Validación de documentación'],
    icon: '👥',
  },
  {
    title: 'Mesa de Ayuda',
    slug: 'mesa-de-ayuda',
    tagline: 'Omnicanalidad y base de conocimientos para una autoatención inteligente.',
    features: ['Canales unificados', 'Base de conocimiento IA', 'SLA automatizado'],
    icon: '🛟',
  },
];

const iconMap: Record<string, typeof ShoppingCart> = {
  'sistema-de-compras': ShoppingCart,
  'gestion-personal-transitorio': Users,
  'mesa-de-ayuda': LifeBuoy,
};

const displaySoluciones = soluciones.length > 0 ? soluciones : fallbackSoluciones;
---

<Layout title="Soluciones | Agencia Sur">

  <!-- Hero -->
  <section class="pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-section mb-5">Soluciones</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto font-light text-white">
            Soluciones que resuelven problemas <span class="text-accent-400">reales</span>
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto text-white/60">
            Sistemas cerrados, probados en producción, diseñados para procesos empresariales críticos.
            No vendemos software genérico — entregamos herramientas que encajan en tu operación.
          </p>
        </div>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-12 xl:gap-8 md:gap-8 gap-y-5">
        {displaySoluciones.map((sol, i) => (
          <div class="col-span-12 md:col-span-6 lg:col-span-4" data-ns-animate data-delay={0.4 + i * 0.1}>
            <a href={`/soluciones/${sol.slug}`} class="group block h-full">
              <div class="flex min-h-[340px] h-full flex-col justify-between space-y-4 rounded-[20px] p-7 md:p-10 transition-all duration-300 hover:translate-y-[-8px] hover:shadow-[0_0_40px_rgba(143,209,79,0.12)] border border-white/[0.07] group-hover:border-accent-400/30" style="background-color: #0b0d10;">

                <div class="flex size-14 items-center justify-center rounded-2xl border border-white/[0.07]" style="background: rgba(143,209,79,0.08);">
                  {(() => {
                    const Icon = iconMap[sol.slug];
                    return Icon ? <Icon color="currentColor" size={28} stroke-width={1} class="text-accent-400" /> : <span class="text-2xl text-accent-400">⚡</span>;
                  })()}
                </div>

                <div class="space-y-3">
                  <h3 class="text-xl font-light text-white group-hover:text-accent-400 transition-colors">
                    {sol.title}
                  </h3>
                  <p class="text-white/50 text-sm leading-relaxed">
                    {sol.tagline}
                  </p>
                </div>

                {sol.features && sol.features.length > 0 && (
                  <ul class="space-y-2">
                    {sol.features.slice(0, 3).map((f: string) => (
                      <li class="flex items-center gap-2 text-sm text-white/50">
                        <span class="size-1.5 rounded-full bg-accent-400 shrink-0" />
                        {f}
                      </li>
                    ))}
                  </ul>
                )}

                <div>
                  <span class="inline-flex items-center gap-2 text-sm font-medium text-accent-400 group-hover:gap-3 transition-all">
                    <span>Ver detalle</span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <ContactoFooter />
  <Footer />
</Layout>
