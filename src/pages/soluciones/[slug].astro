                    <span class="text-white/50 text-base leading-[1.6] font-light group-hover:text-accent-400 transition-colors">Beneficios</span>
                    <svg width="16" height="16" viewBox="0 0 24 25" fill="none" class="opacity-25 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
                      <path d="M10 8.5L14 12.5L10 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
