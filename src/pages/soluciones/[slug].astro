---
import Layout from '../../layouts/Layout.astro';
import ContactoFooter from '../../components/ContactoFooter.astro';
import { sanityClient, urlFor } from '../../lib/sanity';
import PortableText from '../../components/PortableText';
import type { Solucion } from '../../types/sanity';

const fallbackData: Record<string, Solucion> = {
  'sistema-de-compras': {
    title: 'Sistema de Compras',
    slug: 'sistema-de-compras',
    tagline: 'Digitaliza el proceso de adquisiciones y haz eficiente tu abastecimiento.',
    bajada: 'Digitaliza el proceso de adquisiciones y reduce tiempos operativos con un sistema completo de gestión de compras.',
    features: ['Control de cumplimiento SLA', 'Reducción 100% papel', 'Tracking en tiempo real', 'Aprobaciones multinivel', 'Integración con ERP'],
    featuresDescription: 'Cada módulo está pensado para resolver un problema específico de operación, no para agregar complejidad innecesaria.',
    benefits: [
      { metric: '60%', label: 'Reducción en tiempos operativos' },
      { metric: '100%', label: 'Eliminación de papel' },
      { metric: '3x', label: 'Más rápido en aprobaciones', description: 'Flujo de aprobación multinivel automatizado' },
    ],
  },
  'gestion-personal-transitorio': {
    title: 'Gestión de Personal Transitorio',
    slug: 'gestion-personal-transitorio',
    tagline: 'Estandariza solicitudes, evalúa y valida personal externo en una sola plataforma.',
    bajada: 'Estandariza solicitudes, evalúa y valida personal externo en una sola plataforma.',
    features: ['Solicitudes estandarizadas', 'Evaluación centralizada', 'Validación de documentación', 'Dashboard de seguimiento'],
    featuresDescription: 'Cada módulo está pensado para resolver un problema específico de operación, no para agregar complejidad innecesaria.',
    benefits: [
      { metric: '80%', label: 'Menos tiempo en gestión manual' },
      { metric: '100%', label: 'Documentación validada', description: 'Verificación automática de antecedentes y certificaciones' },
      { metric: '2x', label: 'Más rápido en contratación' },
    ],
  },
  'mesa-de-ayuda': {
    title: 'Mesa de Ayuda',
    slug: 'mesa-de-ayuda',
    tagline: 'Omnicanalidad y base de conocimientos para una autoatención inteligente.',
    bajada: 'Omnicanalidad y base de conocimientos para una autoatención inteligente.',
    features: ['Canales unificados', 'Base de conocimiento IA', 'SLA automatizado', 'Reportes de satisfacción'],
    featuresDescription: 'Cada módulo está pensado para resolver un problema específico de operación, no para agregar complejidad innecesaria.',
    benefits: [
      { metric: '90%', label: 'Resolución en primer contacto' },
      { metric: '50%', label: 'Reducción de tickets repetitivos', description: 'Base de conocimiento con IA integrada' },
      { metric: '24/7', label: 'Disponibilidad continua' },
    ],
  },
};

export async function getStaticPaths() {
  const fallbackData: Record<string, { slug: string }> = {
    'sistema-de-compras': { slug: 'sistema-de-compras' },
    'gestion-personal-transitorio': { slug: 'gestion-personal-transitorio' },
    'mesa-de-ayuda': { slug: 'mesa-de-ayuda' },
  };
  const fallbackSlugs = Object.keys(fallbackData);
  const paths = fallbackSlugs.map((slug) => ({ params: { slug } }));

  if (sanityClient) {
    try {
      const soluciones: Solucion[] = await sanityClient.fetch(
        `*[_type == "solucion"] { "slug": slug.current }`
      );
      for (const sol of soluciones) {
        if (!fallbackSlugs.includes(sol.slug)) {
          paths.push({ params: { slug: sol.slug } });
        }
      }
    } catch {
      // Sanity query failed — fallbacks still work
    }
  }

  return paths;
}

const { slug } = Astro.params;

let solucion: Solucion | null = null;
if (sanityClient) {
  try {
      solucion = await sanityClient.fetch(
        `*[_type == "solucion" && slug.current == $slug][0] {
          _id, title, "slug": slug.current, tagline, bajada, description, features, featuresDescription,
          mainImage, benefits, galleryImages { image, alt }, icon, image
        }`,
        { slug }
      );
  } catch {
    // Sanity query failed
  }
}

if (!solucion && slug && fallbackData[slug]) {
  solucion = fallbackData[slug];
}

if (!solucion) {
  return Astro.redirect('/soluciones');
}
---

<Layout title={`${solucion.title} | Agencia Sur`}>            
  <!-- Content + TOC sidebar — Nexsas services-details/content.htm layout -->
  <section class="pb-24 sm:pt-36 md:pt-42 md:pb-36 lg:pb-44 xl:pt-[180px] xl:pb-[200px]">
    <div class="main-container">
      <div class="flex items-start lg:gap-[72px]">
        <div class="w-full max-w-full lg:max-w-[767px]">
          <div class="services-details-content mb-[72px]">
            <div class="space-y-3 mb-8">
              <h3 data-ns-animate data-delay="0.3" class="max-w-[878px] font-light text-white">
                {solucion.title}
              </h3>
              <h5 data-ns-animate data-delay="0.4" class="max-w-[700px]">
                 <span class="text-accent-400 block font-light">{solucion.tagline}</span>
              </h5>
              {solucion.bajada && (
                <p data-ns-animate data-delay="0.5" class="text-white/60">
                    <span class="text-xl">{solucion.bajada}</span>                                      
                </p>
              )}
            </div>

            {solucion.description ? (
              <div class="details-body">
                <PortableText client:load value={solucion.description} />
              </div>
            ) : null}

            <figure data-ns-animate data-delay="0.3" data-instant class="max-w-[767px] overflow-hidden rounded-xl">
                <!-- Procurement pipeline: Request → Approval → PO → Supplier → Delivery -->
                <svg class="w-full h-auto block" viewBox="0 0 767 420" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
                  <defs>
                    <pattern id="sdc1-dots" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
                      <circle cx="0.5" cy="0.5" r="0.8" fill="rgba(143,209,79,0.08)"/>
                    </pattern>
                    <radialGradient id="sdc1-fade" cx="50%" cy="50%" r="55%">
                      <stop offset="30%" stop-color="#0b0d10" stop-opacity="0"/>
                      <stop offset="100%" stop-color="#0b0d10" stop-opacity="1"/>
                    </radialGradient>
                    <mask id="sdc1-mask">
                      <rect width="767" height="420" fill="white"/>
                      <rect width="767" height="420" fill="url(#sdc1-fade)"/>
                    </mask>
                  </defs>
                  <rect width="767" height="420" fill="#0b0d10"/>
                  <rect width="767" height="420" fill="url(#sdc1-dots)" mask="url(#sdc1-mask)"/>

                  <!-- Main pipeline paths -->
                  <path id="sdc1-p1" d="M 110 200 L 250 200" stroke="rgba(143,209,79,0.35)" stroke-width="1.5" stroke-dasharray="6 12">
                    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="1.6s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc1-p2" d="M 250 200 L 400 200" stroke="rgba(143,209,79,0.35)" stroke-width="1.5" stroke-dasharray="6 12">
                    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="2.0s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc1-p3" d="M 400 200 L 550 200" stroke="rgba(143,209,79,0.35)" stroke-width="1.5" stroke-dasharray="6 12">
                    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="1.8s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc1-p4" d="M 550 200 L 670 200" stroke="rgba(143,209,79,0.28)" stroke-width="1.2" stroke-dasharray="6 12">
                    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="1.4s" repeatCount="indefinite"/>
                  </path>

                  <!-- Approval branches (upward) -->
                  <path id="sdc1-ap1" d="M 250 200 L 250 105" stroke="rgba(143,209,79,0.22)" stroke-width="1" stroke-dasharray="5 10">
                    <animate attributeName="stroke-dashoffset" from="0" to="-15" dur="2.2s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc1-ap2" d="M 250 105 L 340 65" stroke="rgba(143,209,79,0.16)" stroke-width="0.8" stroke-dasharray="5 10">
                    <animate attributeName="stroke-dashoffset" from="0" to="-15" dur="2.8s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc1-ap3" d="M 400 200 L 400 105" stroke="rgba(143,209,79,0.18)" stroke-width="1" stroke-dasharray="5 10">
                    <animate attributeName="stroke-dashoffset" from="0" to="-15" dur="2.4s" repeatCount="indefinite"/>
                  </path>
                  <path d="M 250 105 L 400 105" stroke="rgba(143,209,79,0.1)" stroke-width="0.7" stroke-dasharray="4 8">
                    <animate attributeName="stroke-dashoffset" from="0" to="-12" dur="3.2s" repeatCount="indefinite"/>
                  </path>
                  <path d="M 340 65 L 325 35" stroke="rgba(143,209,79,0.1)" stroke-width="0.6" stroke-dasharray="3 7"/>

                  <!-- Supplier branches (downward) -->
                  <path id="sdc1-sp1" d="M 550 200 L 490 315" stroke="rgba(143,209,79,0.2)" stroke-width="1" stroke-dasharray="5 10">
                    <animate attributeName="stroke-dashoffset" from="0" to="-15" dur="2.6s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc1-sp2" d="M 550 200 L 600 325" stroke="rgba(143,209,79,0.17)" stroke-width="0.9" stroke-dasharray="5 10">
                    <animate attributeName="stroke-dashoffset" from="0" to="-15" dur="2.3s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc1-sp3" d="M 550 200 L 660 300" stroke="rgba(143,209,79,0.13)" stroke-width="0.8" stroke-dasharray="5 10">
                    <animate attributeName="stroke-dashoffset" from="0" to="-15" dur="3.0s" repeatCount="indefinite"/>
                  </path>

                  <!-- Data packets: main pipeline -->
                  <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.0s" repeatCount="indefinite" begin="0s"><mpath href="#sdc1-p1"/></animateMotion></circle>
                  <circle r="2" fill="rgba(143,209,79,0.55)"><animateMotion dur="2.0s" repeatCount="indefinite" begin="1.0s"><mpath href="#sdc1-p1"/></animateMotion></circle>
                  <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.5s" repeatCount="indefinite" begin="0.4s"><mpath href="#sdc1-p2"/></animateMotion></circle>
                  <circle r="2" fill="rgba(143,209,79,0.55)"><animateMotion dur="2.5s" repeatCount="indefinite" begin="1.6s"><mpath href="#sdc1-p2"/></animateMotion></circle>
                  <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0.8s"><mpath href="#sdc1-p3"/></animateMotion></circle>
                  <circle r="2" fill="rgba(143,209,79,0.55)"><animateMotion dur="2.2s" repeatCount="indefinite" begin="1.4s"><mpath href="#sdc1-p3"/></animateMotion></circle>
                  <circle r="2.5" fill="rgba(143,209,79,0.7)"><animateMotion dur="1.8s" repeatCount="indefinite" begin="0.3s"><mpath href="#sdc1-p4"/></animateMotion></circle>
                  <!-- Data packets: approval -->
                  <circle r="2" fill="rgba(143,209,79,0.6)"><animateMotion dur="2.8s" repeatCount="indefinite" begin="0.5s"><mpath href="#sdc1-ap1"/></animateMotion></circle>
                  <circle r="1.5" fill="rgba(143,209,79,0.45)"><animateMotion dur="3.5s" repeatCount="indefinite" begin="1.8s"><mpath href="#sdc1-ap2"/></animateMotion></circle>
                  <!-- Data packets: supplier -->
                  <circle r="2" fill="rgba(143,209,79,0.5)"><animateMotion dur="3.0s" repeatCount="indefinite" begin="0.7s"><mpath href="#sdc1-sp1"/></animateMotion></circle>
                  <circle r="1.5" fill="rgba(143,209,79,0.4)"><animateMotion dur="2.8s" repeatCount="indefinite" begin="1.5s"><mpath href="#sdc1-sp2"/></animateMotion></circle>

                  <!-- Document icons near central PO node -->
                  <rect x="358" y="150" width="18" height="24" rx="2" stroke="rgba(143,209,79,0.3)" stroke-width="1" fill="rgba(143,209,79,0.05)"/>
                  <line x1="362" y1="157" x2="372" y2="157" stroke="rgba(143,209,79,0.25)" stroke-width="0.8"/>
                  <line x1="362" y1="161" x2="372" y2="161" stroke="rgba(143,209,79,0.2)" stroke-width="0.8"/>
                  <line x1="362" y1="165" x2="369" y2="165" stroke="rgba(143,209,79,0.15)" stroke-width="0.8"/>
                  <rect x="370" y="144" width="18" height="24" rx="2" stroke="rgba(143,209,79,0.2)" stroke-width="1" fill="rgba(143,209,79,0.04)"/>

                  <!-- N1: Requestor -->
                  <circle cx="110" cy="200" r="34" fill="rgba(143,209,79,0.05)" stroke="rgba(143,209,79,0.28)" stroke-width="1.5"/>
                  <circle cx="110" cy="200" r="22" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.18)" stroke-width="1"/>
                  <circle cx="110" cy="200" r="10" fill="rgba(143,209,79,0.4)">
                    <animate attributeName="r" values="10;13;10" dur="3.0s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="1;0.5;1" dur="3.0s" repeatCount="indefinite"/>
                  </circle>
                  <!-- N2: First approval -->
                  <circle cx="250" cy="200" r="22" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.32)" stroke-width="1.5"/>
                  <circle cx="250" cy="200" r="9" fill="rgba(143,209,79,0.45)"/>
                  <!-- N3: PO hub (central, highlighted) -->
                  <circle cx="400" cy="200" r="46" stroke="rgba(143,209,79,0.12)" stroke-width="0.8" stroke-dasharray="4 8" fill="transparent">
                    <animateTransform attributeName="transform" type="rotate" from="0 400 200" to="360 400 200" dur="20s" repeatCount="indefinite"/>
                  </circle>
                  <circle cx="400" cy="200" r="30" fill="rgba(143,209,79,0.08)" stroke="rgba(143,209,79,0.42)" stroke-width="1.5"/>
                  <circle cx="400" cy="200" r="20" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.2)" stroke-width="1"/>
                  <circle cx="400" cy="200" r="11" fill="rgba(143,209,79,0.55)">
                    <animate attributeName="r" values="11;15;11" dur="2.4s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="1;0.4;1" dur="2.4s" repeatCount="indefinite"/>
                  </circle>
                  <!-- N4: Supplier hub -->
                  <circle cx="550" cy="200" r="22" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.3)" stroke-width="1.5"/>
                  <circle cx="550" cy="200" r="9" fill="rgba(143,209,79,0.42)"/>
                  <!-- N5: Delivery -->
                  <circle cx="670" cy="200" r="18" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.25)" stroke-width="1.2"/>
                  <circle cx="670" cy="200" r="7" fill="rgba(143,209,79,0.38)"/>

                  <!-- Approval nodes (upper branch) -->
                  <circle cx="250" cy="105" r="14" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.26)" stroke-width="1"/>
                  <circle cx="250" cy="105" r="5" fill="rgba(143,209,79,0.38)"/>
                  <circle cx="400" cy="105" r="13" fill="rgba(143,209,79,0.05)" stroke="rgba(143,209,79,0.2)" stroke-width="1"/>
                  <circle cx="400" cy="105" r="5" fill="rgba(143,209,79,0.32)"/>
                  <circle cx="340" cy="65" r="10" fill="rgba(143,209,79,0.04)" stroke="rgba(143,209,79,0.16)" stroke-width="0.8"/>
                  <circle cx="340" cy="65" r="4" fill="rgba(143,209,79,0.28)"/>
                  <circle cx="325" cy="35" r="7" fill="rgba(143,209,79,0.04)" stroke="rgba(143,209,79,0.12)" stroke-width="0.7"/>
                  <circle cx="325" cy="35" r="3" fill="rgba(143,209,79,0.2)"/>

                  <!-- Supplier sub-nodes (lower branch) -->
                  <circle cx="490" cy="315" r="14" fill="rgba(143,209,79,0.05)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/>
                  <circle cx="490" cy="315" r="5" fill="rgba(143,209,79,0.32)"/>
                  <circle cx="600" cy="325" r="12" fill="rgba(143,209,79,0.04)" stroke="rgba(143,209,79,0.18)" stroke-width="0.9"/>
                  <circle cx="600" cy="325" r="4" fill="rgba(143,209,79,0.28)"/>
                  <circle cx="660" cy="300" r="10" fill="rgba(143,209,79,0.04)" stroke="rgba(143,209,79,0.14)" stroke-width="0.8"/>
                  <circle cx="660" cy="300" r="4" fill="rgba(143,209,79,0.22)"/>

                  <!-- Approval hint -->
                  <path d="M 158 193 L 163 198 L 173 186" stroke="rgba(143,209,79,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>

                  <!-- Stage labels -->
                  <text x="110" y="250" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="11" fill="rgba(143,209,79,0.82)">Solicitud</text>
                  <text x="250" y="238" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="11" fill="rgba(143,209,79,0.72)">Validación</text>
                  <text x="400" y="140" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="10" fill="rgba(143,209,79,0.85)">Orden de</text>
                  <text x="400" y="152" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="10" fill="rgba(143,209,79,0.85)">Compra</text>
                  <text x="550" y="238" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="11" fill="rgba(143,209,79,0.72)">Proveedor</text>
                  <text x="670" y="234" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="11" fill="rgba(143,209,79,0.72)">Recepción</text>
                  <!-- Approval hierarchy labels -->
                  <text x="250" y="87" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="9" fill="rgba(143,209,79,0.55)">Jefe</text>
                  <text x="400" y="88" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="9" fill="rgba(143,209,79,0.5)">Gerencia</text>
                  <text x="340" y="52" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="9" fill="rgba(143,209,79,0.45)">Dirección</text>
                </svg>
              </figure>

            <h2 data-ns-animate data-delay="0.2" id="caracteristicas" class="font-light text-white">Características principales</h2>
            <p data-ns-animate data-delay="0.3" class="text-white/60">
              {solucion.featuresDescription || 'Cada módulo está pensado para resolver un problema específico de operación, no para agregar complejidad innecesaria.'}
            </p>

            <!-- Feature list — Nexsas content-list checkmark pattern -->
            <ul data-ns-animate data-delay="0.4" class="space-y-4 pt-2">
              {solucion.features && solucion.features.map((feature, i) => (
                <li data-ns-animate data-delay={String(0.1 + i * 0.1)} class="flex items-center gap-3">
                  <span class="size-5 bg-secondary dark:bg-accent rounded-full flex items-center justify-center shrink-0">
                    <svg width="10" height="7" viewBox="0 0 10 7" fill="none" aria-hidden="true" class="fill-white dark:fill-secondary">
                      <path d="M4.31661 6.75605L9.74905 1.42144C10.0836 1.0959 10.0836 0.569702 9.74905 0.244158C9.41446 -0.081386 8.87363 -0.081386 8.53904 0.244158L3.7116 4.99012L1.46096 2.78807C1.12636 2.46253 0.585538 2.46253 0.250945 2.78807C-0.0836483 3.11362 -0.0836483 3.63982 0.250945 3.96536L3.1066 6.75605C3.27347 6.91841 3.49253 7 3.7116 7C3.93067 7 4.14974 6.91841 4.31661 6.75605Z" />
                    </svg>
                  </span>
                  <span class="font-normal text-white">{feature}</span>
                </li>
              ))}
            </ul>

            {solucion.galleryImages && solucion.galleryImages.length > 0 ? (
              <div class="space-y-4">
                {solucion.galleryImages.map((img, i) => (
                  <figure data-ns-animate data-delay={String(0.3 + i * 0.1)} data-instant class="max-w-[767px] overflow-hidden rounded-xl">
                    <img
                      src={urlFor(img.image).width(767).height(420).fit('crop').url()}
                      alt={img.alt || `${solucion.title} imagen ${i + 1}`}
                      class="size-full object-cover"
                      loading="lazy"
                    />
                  </figure>
                ))}
              </div>
            ) : (
              <figure data-ns-animate data-delay="0.4" data-instant class="max-w-[767px] overflow-hidden rounded-xl">
                <!-- Integration network: system hub connected to 6 module nodes -->
                <svg class="w-full h-auto block" viewBox="0 0 767 420" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
                  <defs>
                    <pattern id="sdc2-dots" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
                      <circle cx="0.5" cy="0.5" r="0.8" fill="rgba(143,209,79,0.08)"/>
                    </pattern>
                    <radialGradient id="sdc2-fade" cx="50%" cy="50%" r="55%">
                      <stop offset="30%" stop-color="#0b0d10" stop-opacity="0"/>
                      <stop offset="100%" stop-color="#0b0d10" stop-opacity="1"/>
                    </radialGradient>
                    <mask id="sdc2-mask">
                      <rect width="767" height="420" fill="white"/>
                      <rect width="767" height="420" fill="url(#sdc2-fade)"/>
                    </mask>
                  </defs>
                  <rect width="767" height="420" fill="#0b0d10"/>
                  <rect width="767" height="420" fill="url(#sdc2-dots)" mask="url(#sdc2-mask)"/>

                  <!-- Reference ellipses -->
                  <ellipse cx="383" cy="210" rx="205" ry="132" stroke="rgba(143,209,79,0.05)" stroke-width="1" fill="none"/>
                  <ellipse cx="383" cy="210" rx="118" ry="76" stroke="rgba(143,209,79,0.07)" stroke-width="0.8" fill="none"/>

                  <!-- 6 spokes: center(383,210) → outer nodes -->
                  <path id="sdc2-p1" d="M 383 210 L 383 78" stroke="rgba(143,209,79,0.32)" stroke-width="1.3" stroke-dasharray="6 12">
                    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="1.8s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc2-p2" d="M 383 210 L 560 143" stroke="rgba(143,209,79,0.28)" stroke-width="1.2" stroke-dasharray="6 12">
                    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="2.1s" repeatCount="indefinite"/>
                  </path>
                  <path id="sdc2-p3" d="M 383 210 L 560 277" stroke="rgba(143,209,79,0.28)" stroke-width="1.2" stroke-dasharray="6 12">
                    <animate attributeName="stroke-dashoffset" from="0" to="-18" dur="1.9s" repeatCount="indefinite"/>
