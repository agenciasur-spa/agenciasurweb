export async function getStaticPaths() {
  const fallbackData: Record<string, { slug: string }> = {
    'sistema-de-compras': { slug: 'sistema-de-compras' },
    'gestion-personal-transitorio': { slug: 'gestion-personal-transitorio' },
    'mesa-de-ayuda': { slug: 'mesa-de-ayuda' },
    'workflow-generico': { slug: 'workflow-generico' },
    'guard-hub': { slug: 'guard-hub' },
    'electivoia': { slug: 'electivoia' },
  };
  const fallbackSlugs = Object.keys(fallbackData);
  const paths = fallbackSlugs.map((slug) => ({ params: { slug } }));

  if (sanityClient) {
    try {
      const soluciones: Solucion[] = await sanityClient.fetch(
        `*[_type == "solucion"] { "slug": slug.current }`
      );
      for (const sol of soluciones) {
        if (!fallbackSlugs.includes(sol.slug)) {
          paths.push({ params: { slug: sol.slug } });
        }
      }
    } catch {
      // Sanity query failed — fallbacks still work
    }
  }

  return paths;
}

const { slug } = Astro.params;

let solucion: Solucion | null = null;
if (sanityClient) {
  try {
      solucion = await sanityClient.fetch(
        `*[_type == "solucion" && slug.current == $slug][0] {
          _id, title, "slug": slug.current, tagline, bajada, description, features, featuresDescription,
          mainImage, benefits, galleryImages { image, alt }, icon, image
        }`,
        { slug }
      );
  } catch {
    // Sanity query failed
  }
}

if (!solucion && slug && fallbackData[slug]) {
  solucion = fallbackData[slug];
}

if (!solucion) {
  return Astro.redirect('/soluciones');
}
---

<Layout title={`${solucion.title} | Agencia Sur`}>            
