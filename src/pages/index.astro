---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiciosGrid from '../components/ServiciosGrid.astro';
import SistemasGrid from '../components/SistemasGrid.astro';
import NosotrosSection from '../components/NosotrosSection.astro';
import ContactoFooter from '../components/ContactoFooter.astro';
import Footer from '../components/Footer.astro';
import DemoModal from '../components/DemoModal.astro';
---

<Layout title="Agencia Sur | Transformación Digital">
  <Hero />
  <ServiciosGrid />
  <SistemasGrid />
  <NosotrosSection />
  <ContactoFooter />
  <Footer />

  <!-- Modal de contacto inmediato disparado desde el Hero (ver
       data-open-demo-modal / initDemoModalTriggers en animations.ts).
       Estas props son el fallback por si algun trigger no manda detail. -->
  <DemoModal
    modalTitle="Conversemos"
    modalDescription="Cuéntanos sobre tu proyecto y te contactamos a la brevedad."
    ctaLabel="Enviar mensaje"
    solucionTitle="Consulta general"
    successTitle="¡Mensaje enviado!"
    successMessage="Te contactaremos en las próximas 24 horas hábiles."
  />
</Layout>
