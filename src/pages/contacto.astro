---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactFormV2.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto | Agencia Sur">

  <!-- Contact section — info cards -->
  <section class="pt-32 pb-14 sm:pt-36 md:pt-42 md:pb-16 lg:pb-20 xl:pt-[180px] xl:pb-[100px]" aria-label="Información de Contacto">
    <div class="main-container">
      <div class="space-y-[70px]">
        <!-- heading -->
        <div class="mx-auto max-w-[680px] space-y-3 text-center">
          <h2 data-ns-animate data-delay="0.2" class="font-light text-white">¿Tienes un <span class="text-accent-400">proyecto</span>?</h2>
          <p data-ns-animate data-delay="0.3" class="text-white/60">
            Cuéntanos qué necesitas. Te ayudamos a definir el camino desde la idea hasta la implementación.
            Estamos disponibles para responder consultas técnicas, cotizaciones o simplemente charlar sobre tu operación.
          </p>
        </div>

        <div class="flex flex-col items-center justify-center gap-10 lg:flex-row lg:items-start lg:gap-8 xl:gap-[70px]">
          <!-- contact info cards -->
          <div data-ns-animate data-delay="0.4" class="flex flex-col gap-8 md:flex-row lg:flex-col">
            <!-- contact info one — Dirección -->
            <div class="bg-secondary dark:bg-background-6 relative w-full space-y-6 overflow-hidden rounded-[20px] p-11 text-center md:max-w-[371px]">
              <figure class="pointer-events-none absolute top-[-187px] left-[174px] size-[350px] -rotate-[78deg] overflow-hidden select-none">
                <svg class="size-full" viewBox="0 0 350 350" xmlns="http://www.w3.org/2000/svg" fill="none" opacity="0.45" aria-hidden="true">
                  <line x1="0" y1="50" x2="350" y2="50" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="0" y1="100" x2="350" y2="100" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="0" y1="150" x2="350" y2="150" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="0" y1="200" x2="350" y2="200" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="0" y1="250" x2="350" y2="250" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="0" y1="300" x2="350" y2="300" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="50" y1="0" x2="50" y2="350" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="100" y1="0" x2="100" y2="350" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="150" y1="0" x2="150" y2="350" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="200" y1="0" x2="200" y2="350" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="250" y1="0" x2="250" y2="350" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <line x1="300" y1="0" x2="300" y2="350" stroke="rgba(143,209,79,0.35)" stroke-width="0.6"/>
                  <circle cx="100" cy="100" r="2.5" fill="rgba(143,209,79,0.6)"/>
                  <circle cx="200" cy="150" r="2.5" fill="rgba(143,209,79,0.6)"/>
                  <circle cx="150" cy="250" r="2.5" fill="rgba(143,209,79,0.6)"/>
                  <circle cx="250" cy="200" r="2.5" fill="rgba(143,209,79,0.5)"/>
                  <circle cx="175" cy="165" r="22" stroke="rgba(143,209,79,0.8)" stroke-width="2"/>
                  <circle cx="175" cy="165" r="7" fill="rgba(143,209,79,0.9)"/>
                  <line x1="175" y1="187" x2="175" y2="220" stroke="rgba(143,209,79,0.7)" stroke-width="2.5" stroke-linecap="round"/>
                  <circle cx="175" cy="165" r="40" stroke="rgba(143,209,79,0.2)" stroke-width="1" stroke-dasharray="4 3"/>
                </svg>
              </figure>
              <figure class="mx-auto size-10 overflow-hidden rounded-full bg-accent-400/10 p-2 ring-1 ring-accent-400/30">
                <svg class="size-full text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </figure>
              <div class="space-y-2.5">
                <p class="text-heading-6 text-accent">Dirección</p>
                <p class="text-accent/60">Las Bellotas 199, of 62, Providencia</p>
              </div>
            </div>

            <!-- contact info two — Email -->
            <div class="bg-secondary dark:bg-background-6 relative w-full overflow-hidden rounded-[20px] p-11 text-center md:max-w-[371px]">
              <figure class="pointer-events-none absolute top-[-206px] left-[-36px] size-[350px] rotate-[62deg] overflow-hidden select-none">
                <svg class="size-full" viewBox="0 0 350 350" xmlns="http://www.w3.org/2000/svg" fill="none" opacity="0.45" aria-hidden="true">
                  <circle cx="175" cy="175" r="22" stroke="rgba(143,209,79,0.7)" stroke-width="2"/>
                  <circle cx="175" cy="175" r="8" fill="rgba(143,209,79,0.6)"/>
                  <circle cx="65" cy="75" r="13" stroke="rgba(143,209,79,0.5)" stroke-width="1.5"/>
                  <circle cx="65" cy="75" r="5" fill="rgba(143,209,79,0.4)"/>
                  <line x1="78" y1="88" x2="157" y2="158" stroke="rgba(143,209,79,0.3)" stroke-width="1" stroke-dasharray="6 4"/>
                  <circle cx="118" cy="130" r="3.5" fill="rgba(143,209,79,0.7)"/>
                  <circle cx="285" cy="85" r="11" stroke="rgba(143,209,79,0.45)" stroke-width="1.5"/>
                  <circle cx="285" cy="85" r="4" fill="rgba(143,209,79,0.35)"/>
                  <line x1="274" y1="96" x2="194" y2="162" stroke="rgba(143,209,79,0.28)" stroke-width="1" stroke-dasharray="6 4"/>
                  <circle cx="230" cy="135" r="3.5" fill="rgba(143,209,79,0.6)"/>
                  <circle cx="55" cy="270" r="10" stroke="rgba(143,209,79,0.4)" stroke-width="1.5"/>
                  <line x1="65" y1="260" x2="157" y2="193" stroke="rgba(143,209,79,0.22)" stroke-width="1" stroke-dasharray="6 4"/>
                  <circle cx="295" cy="275" r="11" stroke="rgba(143,209,79,0.38)" stroke-width="1.5"/>
                  <line x1="284" y1="264" x2="194" y2="192" stroke="rgba(143,209,79,0.22)" stroke-width="1" stroke-dasharray="6 4"/>
                  <circle cx="240" cy="225" r="3.5" fill="rgba(143,209,79,0.5)"/>
                  <circle cx="108" cy="218" r="3.5" fill="rgba(143,209,79,0.45)"/>
                </svg>
              </figure>
              <div class="space-y-6">
                <figure class="mx-auto size-10 overflow-hidden rounded-full bg-accent-400/10 p-2 ring-1 ring-accent-400/30">
                  <svg class="size-full text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </figure>
                <div class="space-y-2.5">
                  <p class="text-heading-6 text-accent">Email</p>
                  <p class="text-accent/60">
                    <a href="mailto:contacto@agenciasur.cl">contacto@agenciasur.cl</a>
                  </p>
                </div>
              </div>
            </div>

            <!-- contact info three — Teléfono -->
            <div class="bg-secondary dark:bg-background-6 relative w-full overflow-hidden rounded-[20px] p-11 text-center md:max-w-[371px]">
              <figure class="pointer-events-none absolute top-[-264px] left-[-255px] size-[450px] select-none">
                <svg class="size-full" viewBox="0 0 450 450" xmlns="http://www.w3.org/2000/svg" fill="none" opacity="0.45" aria-hidden="true">
                  <circle cx="225" cy="225" r="14" fill="rgba(143,209,79,0.7)"/>
                  <circle cx="225" cy="225" r="35" stroke="rgba(143,209,79,0.7)" stroke-width="2"/>
                  <circle cx="225" cy="225" r="75" stroke="rgba(143,209,79,0.5)" stroke-width="1.5"/>
                  <circle cx="225" cy="225" r="120" stroke="rgba(143,209,79,0.32)" stroke-width="1"/>
                  <circle cx="225" cy="225" r="170" stroke="rgba(143,209,79,0.2)" stroke-width="1"/>
                  <circle cx="225" cy="225" r="222" stroke="rgba(143,209,79,0.1)" stroke-width="0.5"/>
                  <line x1="225" y1="3" x2="225" y2="447" stroke="rgba(143,209,79,0.08)" stroke-width="0.5"/>
                  <line x1="3" y1="225" x2="447" y2="225" stroke="rgba(143,209,79,0.08)" stroke-width="0.5"/>
                  <circle cx="225" cy="105" r="4" fill="rgba(143,209,79,0.5)"/>
                  <circle cx="345" cy="225" r="4" fill="rgba(143,209,79,0.4)"/>
                  <circle cx="225" cy="345" r="4" fill="rgba(143,209,79,0.35)"/>
                  <circle cx="105" cy="225" r="4" fill="rgba(143,209,79,0.4)"/>
                </svg>
              </figure>
              <div class="space-y-6">
                <figure class="mx-auto size-10 overflow-hidden rounded-full bg-accent-400/10 p-2 ring-1 ring-accent-400/30">
                  <svg class="size-full text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </figure>
                <div class="space-y-2.5">
                  <p class="text-heading-6 text-accent">Teléfono</p>
                  <p class="text-accent/60">
                    <a href="tel:+56978640400">+56 9 7864 0400</a>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Mad-libs form — using ContactForm component -->
          <div
            data-ns-animate
            data-delay="0.3"
            class="bg-secondary dark:bg-background-8 mx-auto w-full max-w-[847px] rounded-4xl p-6 md:p-8 lg:p-11"
          >
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
