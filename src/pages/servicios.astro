---
import Layout from '../layouts/Layout.astro';
import ContactoFooter from '../components/ContactoFooter.astro';
import { UserCog, Workflow, Code, Cloud, ShieldCheck, Rocket, CheckCircle } from '@lucide/astro';

const procesoSteps = [
  {
    step: '01',
    title: 'Levantamiento de Procesos',
    description: 'Entrevistamos a los stakeholders clave, mapeamos los flujos actuales e identificamos cuellos de botella. Entregamos un diagnóstico con recomendaciones priorizadas.',
    detail: 'No programamos una sola línea hasta entender tu operación.',
    icon: UserCog,
  },
  {
    step: '02',
    title: 'Diseño de Solución',
    description: 'Definimos la arquitectura técnica, los flujos de usuario y los criterios de aceptación. Prototipamos las pantallas críticas para validación antes de desarrollar.',
    detail: 'Wireframes, arquitectura de datos y plan de integración.',
    icon: Workflow,
  },
  {
    step: '03',
    title: 'Desarrollo Iterativo',
    description: 'Construimos en ciclos cortos con demostraciones frecuentes. Cada sprint entrega funcionalidad usable, no acumulamos deuda técnica.',
    detail: 'Sprints de 2 semanas con review del cliente.',
    icon: Code,
  },
  {
    step: '04',
    title: 'Testing & QA',
    description: 'Pruebas automatizadas y manuales. Validación con usuarios reales del cliente. Performance, seguridad y accesibilidad verificadas.',
    detail: 'Nada se entrega sin pasar QA.',
    icon: ShieldCheck,
  },
  {
    step: '05',
    title: 'Deploy & Soporte',
    description: 'Puesta en producción con plan de rollback. Capacitación al equipo interno. Soporte post-entrega según SLA acordado.',
    detail: 'Acompañamiento continuo, no desaparecemos después del deploy.',
    icon: Rocket,
  },
];

const tecnologias = [
  { name: 'Astro / Next.js', category: 'Frontend' },
  { name: 'React / Vue', category: 'Frontend' },
  { name: 'Node.js / Python', category: 'Backend' },
  { name: 'PostgreSQL / MongoDB', category: 'Base de Datos' },
  { name: 'AWS / Vercel', category: 'Infraestructura' },
  { name: 'Docker / Kubernetes', category: 'DevOps' },
];

const diferenciadores = [
  'Clarity Over Clutter — simplificamos lo complejo sin perder funcionalidad.',
  'People Before Features — el usuario opera, no el manual.',
  'Security as a Standard — seguridad desde el diseño, no como afterthought.',
];
---

<Layout title="Servicios | Agencia Sur">

  <!-- Hero — Nexsas services.htm pattern -->
  <section class="pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-yellow-v2">Nuestro Método</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto">
            Cómo trabajamos
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto">
            No vendemos horas. Entregamos soluciones que resuelven problemas reales.
            Nuestro proceso existe para garantizar que cada proyecto tenga impacto medible.
          </p>
        </div>
      </div>

      <!-- Process steps grid — Nexsas services.htm 12-col grid -->
      <div class="grid grid-cols-12 xl:gap-8 md:gap-8 gap-y-5">
        {procesoSteps.map((item, i) => (
          <div data-ns-animate data-delay={0.4 + i * 0.1} class:list={[
            'col-span-12 md:col-span-6 xl:col-span-4',
          ]}>
            <div class="px-6 py-8 rounded-[20px] bg-background-3 dark:bg-background-7 space-y-6 text-center grid items-center justify-center hover:translate-y-[-10px] transition-transform duration-500 ease-in-out">
              <div class="flex items-center justify-center">
                <span class="text-heading-4 text-secondary dark:text-accent font-medium">{item.step}</span>
              </div>
              <div class="space-y-2">
                <h3 class="text-heading-5">{item.title}</h3>
                <p class="max-w-[361px] mx-auto">
                  {item.description}
                </p>
              </div>
              <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 font-medium">
                {item.detail}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Diferenciadores — Nexsas feature.htm two-column pattern -->
  <section class="relative pt-14 md:pt-16 lg:pt-[88px] xl:pt-[100px] pb-24 md:pb-36 lg:pb-40 xl:pb-[200px] overflow-hidden">
    <div class="main-container">
      <div class="flex items-center flex-wrap lg:flex-nowrap gap-y-8 lg:gap-4 xl:gap-8">
        <div class="w-full lg:w-1/2">
          <div class="text-center lg:text-left">
            <span data-ns-animate data-delay="0.1" class="badge badge-green-v2 mb-5">Diferenciadores</span>
            <h2 data-ns-animate data-delay="0.2" class="mb-8 max-w-[520px] mx-auto lg:mx-0">
              Diseñado para entregar resultados tangibles
            </h2>
            <p data-ns-animate data-delay="0.3" class="mb-8 max-w-[520px] mx-auto lg:mx-0">
              Cada proyecto comienza con un diagnóstico real y termina con una solución operativa.
              No entregamos documentos — entregamos software que funciona.
            </p>
            <ul class="space-y-4 mb-14">
              {diferenciadores.map((d, i) => (
                <li
                  data-ns-animate
                  data-delay={0.4 + i * 0.1}
                  class="flex items-center lg:justify-start justify-center gap-2"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                    class="shrink-0"
                  >
                    <rect
                      width="18"
                      height="18"
                      rx="9"
                      fill=""
                      class="fill-secondary/10 dark:fill-accent/10"
                    />
                    <path
                      d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z"
                      fill=""
                      class="fill-secondary/80 dark:fill-accent/80"
                    />
                  </svg>
                  <span class="text-secondary/40 dark:text-accent/60">{d}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.7">
              <a href="/contacto" class="btn btn-secondary hover:btn-white dark:btn-white-dark btn-xl block md:inline-block w-full md:w-auto mx-auto">
                <span>Agendar Diagnóstico</span>
              </a>
            </div>
          </div>
        </div>
        <div data-ns-animate data-delay="0.3" class="w-full max-w-max mx-auto lg:mx-0 lg:w-1/2">
          <div class="rounded-[20px] bg-background-3 dark:bg-background-5 p-5 lg:p-8 relative overflow-hidden">
            <div class="flex gap-4 sm:gap-2.5 flex-wrap sm:flex-nowrap">
              <div class="bg-white dark:bg-background-8 p-6 rounded-2xl w-full sm:w-[55%]">
                <h5 class="mb-4">
                  Proceso <br class="hidden lg:block" />
                  validado
                </h5>
                <div class="w-full h-[1px] bg-secondary/10 dark:bg-accent/10 mb-7"></div>
                <div class="flex items-center justify-between">
                  <p class="text-secondary/60 dark:text-accent/60 text-tagline-2 font-medium">
                    5 etapas probadas
                  </p>
                  <svg
                    width="18"
                    height="16"
                    viewBox="0 0 18 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M9.34462 13.401L13.2849 15.8974C13.7886 16.2165 14.4139 15.7419 14.2644 15.154L13.126 10.6756C13.0939 10.5509 13.0977 10.4197 13.137 10.297C13.1762 10.1743 13.2492 10.0652 13.3477 9.98222L16.8811 7.04132C17.3453 6.6549 17.1057 5.88439 16.5092 5.84567L11.8949 5.5462C11.7706 5.53732 11.6514 5.49332 11.5511 5.41931C11.4509 5.34531 11.3737 5.24435 11.3286 5.12819L9.60765 0.794357C9.56087 0.671064 9.47769 0.564919 9.36915 0.490017C9.26062 0.415115 9.13187 0.375 9 0.375C8.86813 0.375 8.73938 0.415115 8.63085 0.490017C8.52232 0.564919 8.43914 0.671064 8.39236 0.794357L6.6714 5.12819C6.6263 5.24435 6.54914 5.34531 6.4489 5.41931C6.34865 5.49332 6.22944 5.53732 6.10515 5.5462L1.49078 5.84567C0.894294 5.88439 0.654664 6.6549 1.11894 7.04132L4.65232 9.98222C4.75079 10.0652 4.82383 10.1743 4.86305 10.297C4.90226 10.4197 4.90606 10.5509 4.874 10.6756L3.81824 14.8288C3.63889 15.5343 4.38929 16.1038 4.99369 15.7209L8.65539 13.401C8.75837 13.3354 8.87792 13.3006 9 13.3006C9.12208 13.3006 9.24163 13.3354 9.34462 13.401Z"
                      fill=""
                      class="fill-secondary dark:fill-accent"
                    />
                  </svg>
                </div>
              </div>

              <div class="bg-white dark:bg-background-8 p-6 rounded-2xl w-full sm:w-[45%]">
                <h5 class="mb-4">Resultados</h5>
                <div class="space-y-3">
                  <div class="flex items-center gap-2">
                    <span class="text-heading-4 text-secondary dark:text-accent font-medium">100%</span>
                    <span class="text-secondary/60 dark:text-accent/60 text-tagline-2">entes satisfechos</span>
                  </div>
                  <div class="w-full h-[1px] bg-secondary/10 dark:bg-accent/10"></div>
                  <p class="text-secondary/60 dark:text-accent/60 text-tagline-2">
                    Proyectos entregados a tiempo y dentro de presupuesto
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature dark card — Nexsas solutions.htm pattern -->
  <section>
    <div class="max-w-[1400px] xl:py-[200px] py-24 px-5 md:px-12 mx-5 sm:mx-auto bg-background-3 dark:bg-background-5 rounded-[20px] overflow-hidden">
      <div class="grid grid-cols-12 xl:gap-[100px] lg:gap-20 gap-y-24 items-end">
        <div class="col-span-12 lg:col-span-6">
          <div class="space-y-5 lg:mt-[114px] lg:text-left sm:text-center">
            <span data-ns-animate data-delay="0.1" class="badge badge-yellow-v2">Stack Flexible</span>
            <div class="space-y-3 max-w-[595px] lg:mx-0 mx-auto">
              <h2 data-ns-animate data-delay="0.2">
                No forzamos una tecnología si no encaja
              </h2>
              <p data-ns-animate data-delay="0.3">
                Adaptamos el stack a tu infraestructura existente. Cada decisión técnica se basa en tu contexto, no en modas.
              </p>
            </div>
          </div>
          <div class="mt-8 mb-14">
            <ul class="flex items-start sm:items-center sm:flex-row flex-col gap-8 lg:justify-start justify-start sm:justify-center">
              <li data-ns-animate data-delay="0.4" class="flex items-center gap-2">
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="10" viewBox="0 0 15 10" fill="none">
                    <path d="M13.1875 1.0625L5.3125 8.93715L1.375 5" class="stroke-secondary dark:stroke-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" />
                  </svg>
                </span>
                <p class="font-medium text-secondary dark:text-accent/60">Consultoría TI</p>
              </li>
              <li data-ns-animate data-delay="0.5" class="flex items-center gap-2">
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="10" viewBox="0 0 15 10" fill="none">
                    <path d="M13.1875 1.0625L5.3125 8.93715L1.375 5" class="stroke-secondary dark:stroke-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" />
                  </svg>
                </span>
                <p class="font-medium text-secondary dark:text-accent/60">Automatización</p>
              </li>
              <li data-ns-animate data-delay="0.6" class="flex items-center gap-2">
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="10" viewBox="0 0 15 10" fill="none">
                    <path d="M13.1875 1.0625L5.3125 8.93715L1.375 5" class="stroke-secondary dark:stroke-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" />
                  </svg>
                </span>
                <p class="font-medium text-secondary dark:text-accent/60">Cloud & DevOps</p>
              </li>
            </ul>
          </div>
          <div data-ns-animate data-delay="0.7" class="text-center lg:text-left">
            <a href="/contacto" class="btn btn-xl dark:btn-transparent hover:btn-primary btn-secondary w-[90] sm:w-auto">
              <span>Ver Soluciones</span>
            </a>
          </div>
        </div>
        <div class="col-span-12 lg:col-span-6">
          <div class="max-w-[595px] lg:mx-0 mx-auto w-full relative z-20 xl:mt-0 mt-40">
            <figure data-ns-animate data-delay="0.3" class="xl:max-w-[408px] max-w-[340px] w-full rounded-[20px] overflow-hidden xl:ml-9 relative z-10">
              <div class="size-full bg-background-2 dark:bg-background-6 rounded-[20px] flex items-center justify-center py-16">
                <div class="space-y-4 text-center px-6">
                  <Cloud class="size-12 text-secondary dark:text-accent mx-auto" />
                  <p class="text-tagline-1 font-medium text-secondary dark:text-accent">Infraestructura Cloud</p>
                  <p class="text-tagline-2 text-secondary/60 dark:text-accent/60">AWS / Vercel / Docker</p>
                </div>
              </div>
            </figure>
            <figure data-ns-animate data-delay="0.4" data-spring data-duration="1.9" data-direction="right" class="absolute xl:-top-28 -top-20 -z-10 xl:right-0 right-6 xl:max-w-[227px] max-w-[190px] w-full overflow-hidden rounded-2xl">
              <div class="size-full bg-white dark:bg-background-8 rounded-2xl flex items-center justify-center py-8">
                <div class="space-y-2 text-center px-4">
                  <Code class="size-8 text-secondary dark:text-accent mx-auto" />
                  <p class="text-tagline-2 font-medium text-secondary dark:text-accent">Desarrollo</p>
                </div>
              </div>
            </figure>
            <figure data-ns-animate data-delay="0.2" data-direction="left" class="absolute xl:-top-52 -top-44 -z-10 left-0 xl:max-w-[350px] max-w-[280px] w-full overflow-hidden rounded-2xl drop-shadow-11">
              <div class="size-full bg-white dark:bg-background-8 rounded-2xl flex items-center justify-center py-8">
                <div class="space-y-2 text-center px-4">
                  <ShieldCheck class="size-8 text-secondary dark:text-accent mx-auto" />
                  <p class="text-tagline-2 font-medium text-secondary dark:text-accent">Seguridad</p>
                </div>
              </div>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stack Tecnológico — Nexsas services.htm pattern -->
  <section class="pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-cyan">Stack</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto">
            Stack Tecnológico
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto">
            Adaptamos el stack a tu infraestructura existente. No forzamos una tecnología si no encaja.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-12 xl:gap-8 md:gap-8 gap-y-5">
        {tecnologias.map((tech, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.08} class="col-span-12 md:col-span-6 xl:col-span-4">
            <div class="px-6 py-8 rounded-[20px] bg-background-3 dark:bg-background-7 space-y-2 text-center grid items-center justify-center hover:translate-y-[-10px] transition-transform duration-500 ease-in-out">
              <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 uppercase tracking-wider font-medium">{tech.category}</p>
              <h4 class="text-heading-5">{tech.name}</h4>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews / Testimonios — Nexsas reviews pattern -->
  <section class="pb-[80px] lg:pb-[100px] overflow-hidden">
    <div class="main-container">
      <div class="mx-auto mb-10 max-w-[804px] space-y-5 text-center md:mb-8 lg:mb-14">
        <span data-ns-animate data-delay="0.1" class="badge badge-green">Reviews</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2">Lo que dicen nuestros clientes</h2>
          <p data-ns-animate data-delay="0.3">
            Trabajamos con empresas que necesitan resultados reales, no presentaciones. Esto es lo que nos cuentan.
          </p>
        </div>
      </div>
    </div>
    <div data-ns-animate data-delay="0.4" class="cards-marquee-container">
      <div class="flex items-center gap-8">
        <div class="bg-background-1/90 hover:shadow-1 ml-8 w-full max-w-[358px] min-w-[358px] shrink-0 rounded-[20px] p-8 transition-colors duration-300 ease-linear hover:bg-white dark:bg-background-6/90 dark:hover:bg-background-6">
          <p class="line-clamp-4 text-wrap">
            "Agencia Sur digitalizó nuestro proceso de compras en tiempo récord. El sistema funciona impecable y el equipo entendió nuestra operación desde el primer día."
          </p>
          <div class="bg-stroke-4 my-8 h-px w-full"></div>
          <div class="flex items-center gap-3">
            <figure class="size-12 overflow-hidden rounded-full">
              <img src="https://picsum.photos/48/48?random=301" alt="avatar" class="h-full w-full bg-linear-[156deg,#83E7EE_2.92%,#C6F56F_91%]" />
            </figure>
            <div>
              <h3 class="text-tagline-1 text-secondary font-medium dark:text-accent">Juan Pérez</h3>
              <p class="text-tagline-2 text-secondary/60 font-normal dark:text-accent/60">Gerente de Operaciones, BancoEstado</p>
            </div>
          </div>
        </div>
        <div class="bg-background-1/90 hover:shadow-1 w-full max-w-[358px] min-w-[358px] shrink-0 rounded-[20px] p-8 transition-colors duration-300 ease-linear hover:bg-white dark:bg-background-6/90 dark:hover:bg-background-6">
          <p class="line-clamp-4 text-wrap">
            "La gestión de personal transitorio pasó de ser un dolor de cabeza a un proceso fluido. Todo centralizado, trazable y sin papel."
          </p>
          <div class="bg-stroke-4 my-8 h-px w-full"></div>
          <div class="flex items-center gap-3">
            <figure class="size-12 overflow-hidden rounded-full">
              <img src="https://picsum.photos/48/48?random=302" alt="avatar" class="h-full w-full bg-linear-[156deg,#83E7EE_2.92%,#C6F56F_91%]" />
            </figure>
            <div>
              <h3 class="text-tagline-1 text-secondary font-medium dark:text-accent">María González</h3>
              <p class="text-tagline-2 text-secondary/60 font-normal dark:text-accent/60">Directora de RRHH, ServiEstado</p>
            </div>
          </div>
        </div>
        <div class="bg-background-1/90 hover:shadow-1 w-full max-w-[358px] min-w-[358px] shrink-0 rounded-[20px] p-8 transition-colors duration-300 ease-linear hover:bg-white dark:bg-background-6/90 dark:hover:bg-background-6">
          <p class="line-clamp-4 text-wrap">
            "Implementaron nuestra mesa de ayuda con IA en menos de 3 meses. La autoatención resuelve el 60% de los tickets sin intervención humana."
          </p>
          <div class="bg-stroke-4 my-8 h-px w-full"></div>
          <div class="flex items-center gap-3">
            <figure class="size-12 overflow-hidden rounded-full">
              <img src="https://picsum.photos/48/48?random=303" alt="avatar" class="h-full w-full bg-linear-[156deg,#83E7EE_2.92%,#C6F56F_91%]" />
            </figure>
            <div>
              <h3 class="text-tagline-1 text-secondary font-medium dark:text-accent">Carlos Ruiz</h3>
              <p class="text-tagline-2 text-secondary/60 font-normal dark:text-accent/60">CTO, FinTech Regional</p>
            </div>
          </div>
        </div>
        <div class="bg-background-1/90 hover:shadow-1 w-full max-w-[358px] min-w-[358px] shrink-0 rounded-[20px] p-8 transition-colors duration-300 ease-linear hover:bg-white dark:bg-background-6/90 dark:hover:bg-background-6">
          <p class="line-clamp-4 text-wrap">
            "Su metodología de levantamiento de procesos nos permitió descubrir cuellos de botella que ni sabíamos que teníamos. El ROI fue inmediato."
          </p>
          <div class="bg-stroke-4 my-8 h-px w-full"></div>
          <div class="flex items-center gap-3">
            <figure class="size-12 overflow-hidden rounded-full">
              <img src="https://picsum.photos/48/48?random=304" alt="avatar" class="h-full w-full bg-linear-[156deg,#83E7EE_2.92%,#C6F56F_91%]" />
            </figure>
            <div>
              <h3 class="text-tagline-1 text-secondary font-medium dark:text-accent">Ana Silva</h3>
              <p class="text-tagline-2 text-secondary/60 font-normal dark:text-accent/60">COO, RetailCorp</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA — Nexsas pricing.htm centered pattern -->
  <section class="relative xl:py-[200px] py-24 overflow-hidden">
    <div class="main-container space-y-[70px]">
      <div class="flex flex-col items-center text-center">
        <span data-ns-animate data-delay="0.1" class="badge badge-yellow-v2 mb-5">¿Listo para empezar?</span>
        <h2 data-ns-animate data-delay="0.2" class="max-w-[650px] mx-auto mb-8">
          ¿Listo para levantar tu proceso?
        </h2>
        <p data-ns-animate data-delay="0.3" class="max-w-[500px] mx-auto mb-8">
          El primer paso es una reunión de diagnóstico. Sin compromiso, sin letra chica.
        </p>
        <div data-ns-animate data-delay="0.4">
