---

<Layout title="Servicios | Agencia Sur">



  <!-- Hero — Qué hacemos (los 4 servicios reales, antes solo vivían en el mega-menu) -->
  <section class="relative overflow-hidden min-h-screen min-h-dvh flex items-center" style="background-color: #0b0d10;">
    <!-- Background SVG — 4-arm diamond, diferente al home hub-and-spoke radial -->
    <svg style="filter: blur(2px);" class="pointer-events-none absolute inset-0 z-0 h-full w-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
      <defs>
        <pattern id="srv-dots" x="0" y="0" width="36" height="36" patternUnits="userSpaceOnUse">
          <circle cx="0.5" cy="0.5" r="0.9" fill="rgba(143,209,79,0.08)"/>
        </pattern>
        <radialGradient id="srv-fade" cx="50%" cy="50%" r="55%">
          <stop offset="25%" stop-color="white" stop-opacity="1"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </radialGradient>
        <mask id="srv-mask">
          <rect width="1440" height="900" fill="url(#srv-fade)"/>
        </mask>
      </defs>

      <!-- Dot grid with radial fade -->
      <rect width="1440" height="900" fill="url(#srv-dots)" mask="url(#srv-mask)"/>

      <!-- ── 4 diagonal arms (NE / NW / SE / SW) ── -->
      <!-- NE: hub→mid (805,365) →tip (876,294) -->
      <path id="s-ne1" d="M 720 450 L 805 365" stroke="rgba(143,209,79,0.32)" stroke-width="1.2" stroke-dasharray="6 14"><animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.7s" repeatCount="indefinite"/></path>
      <path id="s-ne2" d="M 805 365 L 876 294" stroke="rgba(143,209,79,0.26)" stroke-width="1" stroke-dasharray="5 12"><animate attributeName="stroke-dashoffset" from="0" to="-17" dur="2.0s" repeatCount="indefinite"/></path>
      <!-- NW: hub→mid (635,365) →tip (564,294) -->
      <path id="s-nw1" d="M 720 450 L 635 365" stroke="rgba(143,209,79,0.32)" stroke-width="1.2" stroke-dasharray="6 14"><animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.5s" repeatCount="indefinite"/></path>
      <path id="s-nw2" d="M 635 365 L 564 294" stroke="rgba(143,209,79,0.26)" stroke-width="1" stroke-dasharray="5 12"><animate attributeName="stroke-dashoffset" from="0" to="-17" dur="2.2s" repeatCount="indefinite"/></path>
      <!-- SE: hub→mid (805,535) →tip (876,606) -->
      <path id="s-se1" d="M 720 450 L 805 535" stroke="rgba(143,209,79,0.32)" stroke-width="1.2" stroke-dasharray="6 14"><animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.9s" repeatCount="indefinite"/></path>
      <path id="s-se2" d="M 805 535 L 876 606" stroke="rgba(143,209,79,0.26)" stroke-width="1" stroke-dasharray="5 12"><animate attributeName="stroke-dashoffset" from="0" to="-17" dur="1.6s" repeatCount="indefinite"/></path>
      <!-- SW: hub→mid (635,535) →tip (564,606) -->
      <path id="s-sw1" d="M 720 450 L 635 535" stroke="rgba(143,209,79,0.32)" stroke-width="1.2" stroke-dasharray="6 14"><animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.4s" repeatCount="indefinite"/></path>
      <path id="s-sw2" d="M 635 535 L 564 606" stroke="rgba(143,209,79,0.26)" stroke-width="1" stroke-dasharray="5 12"><animate attributeName="stroke-dashoffset" from="0" to="-17" dur="2.1s" repeatCount="indefinite"/></path>

      <!-- ── Quadratic arcs connecting outer tips ── -->
      <path d="M 876 294 Q 720 148 564 294" stroke="rgba(143,209,79,0.16)" stroke-width="1" stroke-dasharray="5 10"><animate attributeName="stroke-dashoffset" from="0" to="-15" dur="3.2s" repeatCount="indefinite"/></path>
      <path d="M 876 606 Q 720 752 564 606" stroke="rgba(143,209,79,0.16)" stroke-width="1" stroke-dasharray="5 10"><animate attributeName="stroke-dashoffset" from="0" to="-15" dur="3.6s" repeatCount="indefinite"/></path>
      <path d="M 876 294 Q 1022 450 876 606" stroke="rgba(143,209,79,0.16)" stroke-width="1" stroke-dasharray="5 10"><animate attributeName="stroke-dashoffset" from="0" to="-15" dur="2.8s" repeatCount="indefinite"/></path>
      <path d="M 564 294 Q 418 450 564 606" stroke="rgba(143,209,79,0.16)" stroke-width="1" stroke-dasharray="5 10"><animate attributeName="stroke-dashoffset" from="0" to="-15" dur="3.0s" repeatCount="indefinite"/></path>

      <!-- ── Faint long lines to periphery ── -->
      <line x1="876" y1="294" x2="1240" y2="95"  stroke="rgba(143,209,79,0.07)" stroke-width="0.8"/>
      <line x1="876" y1="294" x2="1330" y2="370" stroke="rgba(143,209,79,0.06)" stroke-width="0.8"/>
      <line x1="564" y1="294" x2="200"  y2="95"  stroke="rgba(143,209,79,0.07)" stroke-width="0.8"/>
      <line x1="564" y1="294" x2="110"  y2="370" stroke="rgba(143,209,79,0.06)" stroke-width="0.8"/>
      <line x1="876" y1="606" x2="1240" y2="805" stroke="rgba(143,209,79,0.07)" stroke-width="0.8"/>
      <line x1="876" y1="606" x2="1330" y2="530" stroke="rgba(143,209,79,0.06)" stroke-width="0.8"/>
      <line x1="564" y1="606" x2="200"  y2="805" stroke="rgba(143,209,79,0.07)" stroke-width="0.8"/>
      <line x1="564" y1="606" x2="110"  y2="530" stroke="rgba(143,209,79,0.06)" stroke-width="0.8"/>

      <!-- ── Data packets ── -->
      <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.4s" repeatCount="indefinite" begin="0s"><mpath href="#s-ne1"/></animateMotion></circle>
      <circle r="2"   fill="rgba(143,209,79,0.6)"><animateMotion dur="2.4s" repeatCount="indefinite" begin="1.2s"><mpath href="#s-ne1"/></animateMotion></circle>
      <circle r="2.5" fill="rgba(143,209,79,0.75)"><animateMotion dur="2.8s" repeatCount="indefinite" begin="0.3s"><mpath href="#s-ne2"/></animateMotion></circle>
      <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0.6s"><mpath href="#s-nw1"/></animateMotion></circle>
      <circle r="2"   fill="rgba(143,209,79,0.6)"><animateMotion dur="2.2s" repeatCount="indefinite" begin="1.4s"><mpath href="#s-nw1"/></animateMotion></circle>
      <circle r="2.5" fill="rgba(143,209,79,0.75)"><animateMotion dur="2.6s" repeatCount="indefinite" begin="1.1s"><mpath href="#s-nw2"/></animateMotion></circle>
      <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.0s" repeatCount="indefinite" begin="0.9s"><mpath href="#s-se1"/></animateMotion></circle>
      <circle r="2"   fill="rgba(143,209,79,0.6)"><animateMotion dur="2.0s" repeatCount="indefinite" begin="0.5s"><mpath href="#s-se1"/></animateMotion></circle>
      <circle r="2.5" fill="rgba(143,209,79,0.75)"><animateMotion dur="2.4s" repeatCount="indefinite" begin="0.4s"><mpath href="#s-se2"/></animateMotion></circle>
      <circle r="3.5" fill="rgba(143,209,79,0.9)"><animateMotion dur="2.6s" repeatCount="indefinite" begin="1.4s"><mpath href="#s-sw1"/></animateMotion></circle>
      <circle r="2"   fill="rgba(143,209,79,0.6)"><animateMotion dur="2.6s" repeatCount="indefinite" begin="0.2s"><mpath href="#s-sw1"/></animateMotion></circle>
      <circle r="2.5" fill="rgba(143,209,79,0.75)"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0.7s"><mpath href="#s-sw2"/></animateMotion></circle>

      <!-- ── Peripheral micro-nodes ── -->
      <circle cx="1240" cy="95"  r="7" fill="rgba(143,209,79,0.1)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/><circle cx="1240" cy="95"  r="3" fill="rgba(143,209,79,0.4)"/>
      <circle cx="200"  cy="95"  r="7" fill="rgba(143,209,79,0.1)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/><circle cx="200"  cy="95"  r="3" fill="rgba(143,209,79,0.4)"/>
      <circle cx="1240" cy="805" r="7" fill="rgba(143,209,79,0.1)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/><circle cx="1240" cy="805" r="3" fill="rgba(143,209,79,0.4)"/>
      <circle cx="200"  cy="805" r="7" fill="rgba(143,209,79,0.1)" stroke="rgba(143,209,79,0.22)" stroke-width="1"/><circle cx="200"  cy="805" r="3" fill="rgba(143,209,79,0.4)"/>
      <circle cx="1330" cy="370" r="4" fill="rgba(143,209,79,0.2)" stroke="rgba(143,209,79,0.3)"  stroke-width="0.8"/>
      <circle cx="110"  cy="370" r="4" fill="rgba(143,209,79,0.2)" stroke="rgba(143,209,79,0.3)"  stroke-width="0.8"/>
      <circle cx="1330" cy="530" r="4" fill="rgba(143,209,79,0.18)" stroke="rgba(143,209,79,0.28)" stroke-width="0.8"/>
      <circle cx="110"  cy="530" r="4" fill="rgba(143,209,79,0.18)" stroke="rgba(143,209,79,0.28)" stroke-width="0.8"/>

      <!-- ── Mid-arm nodes (ring 1) ── -->
      <circle cx="805" cy="365" r="15" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.3)" stroke-width="1.2"/><circle cx="805" cy="365" r="6" fill="rgba(143,209,79,0.45)"/>
      <circle cx="635" cy="365" r="15" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.3)" stroke-width="1.2"/><circle cx="635" cy="365" r="6" fill="rgba(143,209,79,0.45)"/>
      <circle cx="805" cy="535" r="15" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.3)" stroke-width="1.2"/><circle cx="805" cy="535" r="6" fill="rgba(143,209,79,0.45)"/>
      <circle cx="635" cy="535" r="15" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.3)" stroke-width="1.2"/><circle cx="635" cy="535" r="6" fill="rgba(143,209,79,0.45)"/>

      <!-- ── Tip nodes (ring 2) ── -->
      <circle cx="876" cy="294" r="19" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.38)" stroke-width="1.5"/><circle cx="876" cy="294" r="8" fill="rgba(143,209,79,0.5)"/>
      <circle cx="564" cy="294" r="19" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.38)" stroke-width="1.5"/><circle cx="564" cy="294" r="8" fill="rgba(143,209,79,0.5)"/>
      <circle cx="876" cy="606" r="19" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.38)" stroke-width="1.5"/><circle cx="876" cy="606" r="8" fill="rgba(143,209,79,0.5)"/>
      <circle cx="564" cy="606" r="19" fill="rgba(143,209,79,0.07)" stroke="rgba(143,209,79,0.38)" stroke-width="1.5"/><circle cx="564" cy="606" r="8" fill="rgba(143,209,79,0.5)"/>

      <!-- ── Central Hub (counter-clockwise ring, distinto al home) ── -->
      <circle cx="720" cy="450" r="70" stroke="rgba(143,209,79,0.18)" stroke-width="1" stroke-dasharray="4 9" fill="transparent">
        <animateTransform attributeName="transform" type="rotate" from="360 720 450" to="0 720 450" dur="22s" repeatCount="indefinite"/>
      </circle>
      <circle cx="720" cy="450" r="54" fill="rgba(143,209,79,0.06)" stroke="rgba(143,209,79,0.38)" stroke-width="1.5"/>
      <circle cx="720" cy="450" r="38" fill="rgba(143,209,79,0.04)" stroke="rgba(143,209,79,0.18)" stroke-width="1"/>
      <circle cx="720" cy="450" r="10" fill="rgba(143,209,79,0.9)">
        <animate attributeName="r"       values="10;15;10" dur="3.0s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="1;0.4;1"  dur="3.0s" repeatCount="indefinite"/>
      </circle>
    </svg>
    <div class="main-container relative z-10 py-32">
      <div class="text-center space-y-5">
        <span data-ns-animate data-delay="0.1" class="badge badge-section">Qué hacemos</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto font-light text-white">
            Servicios pensados para tu operación
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto text-white/60">
            Cuatro frentes de trabajo, un mismo objetivo: que la tecnología deje de ser un
            problema y empiece a ser una ventaja.
          </p>
        </div>

        <!-- Mismos CTAs (texto + accion) que el Hero del home: abren el
             DemoModal via data-open-demo-modal / initDemoModalTriggers en
             animations.ts, con el mismo texto/props por boton. -->
        <ul class="mt-8 flex flex-col items-center gap-y-4 sm:flex-row sm:justify-center sm:gap-x-4">
          <li
            data-ns-animate
            data-delay="0.5"
            data-direction="up"
            data-offset="30"
            class="w-full sm:w-auto"
          >
            <button
              type="button"
              data-open-demo-modal
              data-modal-title="Hablemos de tu proyecto"
              data-cta-label="Enviar mensaje"
              data-solucion="Consulta general"
              data-description="Cuéntanos brevemente en qué podemos ayudarte y te contactamos a la brevedad."
              class="btn btn-green hover:btn-white dark:hover:btn-accent mx-auto sm:mx-0 block md:inline-block w-[90%] md:w-auto btn-lg md:btn-xl border-0"
            >
              <span>Hablemos de tu proyecto</span>
            </button>
          </li>
          <li
            data-ns-animate
            data-delay="0.6"
            data-direction="up"
            data-offset="30"
            class="w-full sm:w-auto"
          >
            <button
              type="button"
              data-open-demo-modal
              data-modal-title="Agenda una llamada"
              data-cta-label="Solicitar llamada"
              data-solucion="Llamada agendada"
              data-description="Déjanos tus datos y coordinamos un horario que te acomode."
              class="btn btn-lg md:btn-xl dark:btn-transparent dark:border btn-dark bg-accent/20 mx-auto block w-[90%] sm:mx-0 sm:w-auto md:inline-block hover:btn-accent"
            >
              <span>Agenda una llamada</span>
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Scroll cue: mismo patron que Hero.astro (home) — fixed (no
         absolute) para que el margen quede calculado siempre sobre el
         100vh real de la pantalla, sin depender de cuanto mida el Hero
         en cada breakpoint. Fuera del sistema data-ns-animate a
         proposito, su fade lo maneja initHeroScrollCue en
         animations.ts (ya wireado de forma generica por id) segun la
         posicion de scroll. -->
    <a
      id="hero-scroll-cue"
      href="#marquee-servicios"
      aria-label="Ver más contenido"
      class="scroll-cue fixed bottom-6 left-1/2 z-30 hidden -translate-x-1/2 md:flex"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7" />
      </svg>
    </a>
  </section>


  <!-- Marquee tipografico de servicios — patron "BRANDING + A.I. +
       DESIGN + DEVELOPMENT" de trionn.com/services: los 4 servicios en
       loop horizontal con tipografia gigante. Sin WebGL — solo CSS +
       vanilla-infinite-marquee (misma lib que el stack tecnologico mas
       abajo, ver initMarquees()). -->
  <section id="marquee-servicios" class="relative overflow-hidden bg-background-6 py-16 md:py-20 lg:py-24">
    <div class="absolute left-0 top-0 h-full w-[80px] md:w-[140px] bg-gradient-to-r from-background-6 to-transparent z-10"></div>
    <div class="absolute right-0 top-0 h-full w-[80px] md:w-[140px] bg-gradient-to-l from-background-6 to-transparent z-10"></div>

    <div class="disciplines-marquee-container flex items-center whitespace-nowrap">
      {servicios.map(({ title }) => (
        <div class="flex items-center gap-8 md:gap-12 px-4">
          <span class="text-[2.75rem] sm:text-[4.25rem] lg:text-[5.5rem] font-light uppercase tracking-tight text-white">
            {title}
          </span>
          <span class="text-accent-400 text-[1.75rem] sm:text-[2.5rem] lg:text-[3rem]" aria-hidden="true">+</span>
        </div>
      ))}
    </div>

    <p data-ns-animate data-delay="0.2" class="text-center mt-10 md:mt-14 text-white/50">
