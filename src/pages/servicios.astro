---
import Layout from '../layouts/Layout.astro';
import ContactoFooter from '../components/ContactoFooter.astro';
import DemoModal from '../components/DemoModal.astro';
import { UserCog, Workflow, Code, Cloud, ShieldCheck, Rocket, CheckCircle, Smartphone, Accessibility, Monitor, Server, Database, Container, Globe, GitBranch, Zap, Webhook } from '@lucide/astro';
import StackIcon from 'tech-stack-icons';



const procesoSteps = [
  {
    step: '01',
    title: 'Levantamiento de Procesos',
    description: 'Entrevistamos a los stakeholders clave, mapeamos los flujos actuales e identificamos cuellos de botella. Entregamos un diagnóstico con recomendaciones priorizadas.',
    detail: 'No programamos una sola línea hasta entender tu operación.',
    icon: UserCog,
  },
  {
    step: '02',
    title: 'Diseño de Solución',
    description: 'Definimos la arquitectura técnica, los flujos de usuario y los criterios de aceptación. Prototipamos las pantallas críticas para validación antes de desarrollar.',
    detail: 'Wireframes, arquitectura de datos y plan de integración.',
    icon: Workflow,
  },
  {
    step: '03',
    title: 'Desarrollo Iterativo',
    description: 'Construimos en ciclos cortos con demostraciones frecuentes. Cada sprint entrega funcionalidad usable, no acumulamos deuda técnica.',
    detail: 'Sprints de 2 semanas con review del cliente.',
    icon: Code,
  },
  {
    step: '04',
    title: 'Testing & QA',
    description: 'Pruebas automatizadas y manuales. Validación con usuarios reales del cliente. Performance, seguridad y accesibilidad verificadas.',
    detail: 'Nada se entrega sin pasar QA.',
    icon: ShieldCheck,
  },
  {
    step: '05',
    title: 'Deploy & Soporte',
    description: 'Puesta en producción con plan de rollback. Capacitación al equipo interno. Soporte post-entrega según SLA acordado.',
    detail: 'Acompañamiento continuo, no desaparecemos después del deploy.',
    icon: Rocket,
  },
];


const tecnologias = [
  { name: 'symfony' },
  { name: 'astro' },
  { name: 'nextjs2' },
  { name: 'nestjs' },
  { name: 'react' },
  { name: 'vuejs' },
  { name: 'angular' },
  { name: 'nodejs' },
    { name: 'python' },
    { name: 'django' },
    { name: 'flask' },
    { name: 'js' },
    { name: 'redis' },
    { name: 'php' },
    { name: 'laravel' },
    { name: 'mysql' },
    { name: 'postgresql' },
    { name: 'mongodb' },
    { name: 'redis' },
    { name: 'docker' },
    { name: 'kubernetes' },
    { name: 'aws' },
    { name: 'azure' },
    { name: 'supabase' },
    { name: 'heroku' },
    { name: 'digitalocean' },
    { name: 'netlify' },
    { name: 'vercel' },
    
];

const diferenciadores = [
  'Clarity Over Clutter — simplificamos lo complejo sin perder funcionalidad.',
  'People Before Features — el usuario opera, no el manual.',
  'Security as a Standard — seguridad desde el diseño, no como afterthought.',
];
---

<Layout title="Servicios | Agencia Sur">



  <!-- Hero — Nexsas services.htm pattern -->
  <section class="pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
    
        <span data-ns-animate data-delay="0.1" class="badge badge-section">Nuestro Método</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto font-light">
            Cómo trabajamos
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto">
            No vendemos horas. Entregamos soluciones que resuelven problemas reales.
            Nuestro proceso existe para garantizar que cada proyecto tenga impacto medible.
          </p>
        </div>
      </div>

    
  <div data-ns-animate data-delay="0.4" class="process-steps">
      <div class="max-w-[870px] mx-auto mb-[100px]">
        {procesoSteps.map((item, i) => {
          const isLast = i === procesoSteps.length - 1;
          const isLeft = i % 2 === 0;
          return (
            <div class="relative">
              <div>
                <!-- Step circle -->
                <div
                  class="size-[34px] flex items-center justify-center mx-auto rounded-full bg-black drop-shadow-2xl dark:bg-black "
                >
                  <span class="text-black text-accent-300">{item.step}</span>
                </div>
                {/* Gradient line — only if NOT the last step */}
                {!isLast && (
                  <div class="h-[150px] lg:h-[200px] w-1 mx-auto bg-stroke-2 dark:bg-stroke-6 overflow-hidden">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="step-line w-full"
                      style="height: 0px;"
                      viewBox="0 0 2 222"
                      preserveAspectRatio="none"
                      fill="none"
                    >
                      <path
                        d="M1 1L0.99999 221"
                        stroke={`url(#step-gradient-${i})`}
                        stroke-width="2"
                        stroke-linecap="round"
                      />
                      <defs>
                        <linearGradient
                          id={`step-gradient-${i}`}
                          x1="0.5"
                          y1="1"
                          x2="0.49999"
                          y2="221"
                          gradientUnits="userSpaceOnUse"
                        >
                          <stop offset="0" stop-color="#66ffb2" />
                          <stop offset="0.25" stop-color="#00e676" />
                          <stop offset="0.5" stop-color="#00e676" />
                          <stop offset="1" stop-color="#66ffb2" />
                        </linearGradient>
                      </defs>
                    </svg>
                  </div>
                )}
              </div>
              <!-- Step card — alternating left/right on desktop -->
              <div
                data-ns-animate
                data-delay={0.3 + i * 0.1}
                class:list={[
                  'card-item absolute max-w-[370px] w-full space-y-3',
                  isLeft
                    ? 'lg:left-0 lg:top-0 left-1/2 lg:translate-x-0 -translate-x-1/2 top-1/2 lg:translate-y-0 -translate-y-1/2'
                    : 'lg:right-0 lg:top-0 right-1/2 lg:translate-x-0 translate-x-1/2 top-1/2 -translate-y-1/2',
                  isLast && 'top-16',
                  'lg:bg-none dark:bg-background-6 lg:dark:bg-transparent lg:p-0 lg:rounded-none p-6 rounded-[20px] max-sm:bg-background-4',
                ]}
              >
                <p class="text-accent-600">PASO {item.step}</p>
                <div class="space-y-2">
                  <h5 class="text-heading-6 lg:text-heading-5 dark:text-accent-400">{item.title}</h5>
                  <small class="dark:text-white/50">{item.description}</small>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    </div>
  </section>











  <!-- Diferenciadores — Nexsas feature.htm two-column pattern -->
  <section class="relative pt-14 md:pt-16 lg:pt-[88px] xl:pt-[100px] pb-24 md:pb-36 lg:pb-40 xl:pb-[200px] overflow-hidden hidden">
    <div class="main-container">
      <div class="flex items-center flex-wrap lg:flex-nowrap gap-y-8 lg:gap-4 xl:gap-8">
        <div class="w-full lg:w-1/2">
          <div class="text-center lg:text-left">
            <span data-ns-animate data-delay="0.1" class="badge badge-green-v2 mb-5">Diferenciadores</span>
            <h2 data-ns-animate data-delay="0.2" class="mb-8 max-w-[520px] mx-auto lg:mx-0">
              Diseñado para entregar resultados tangibles
            </h2>
            <p data-ns-animate data-delay="0.3" class="mb-8 max-w-[520px] mx-auto lg:mx-0">
              Cada proyecto comienza con un diagnóstico real y termina con una solución operativa.
              No entregamos documentos — entregamos software que funciona.
            </p>
            <ul class="space-y-4 mb-14">
              {diferenciadores.map((d, i) => (
                <li
                  data-ns-animate
                  data-delay={0.4 + i * 0.1}
                  class="flex items-center lg:justify-start justify-center gap-2"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                    class="shrink-0"
                  >
                    <rect
                      width="18"
                      height="18"
                      rx="9"
                      fill=""
                      class="fill-secondary/10 dark:fill-accent/10"
                    />
                    <path
                      d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z"
                      fill=""
                      class="fill-secondary/80 dark:fill-accent/80"
                    />
                  </svg>
                  <span class="text-secondary/40 dark:text-accent/60">{d}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.7">
              <a href="/contacto" class="btn btn-secondary hover:btn-white dark:btn-white-dark btn-xl block md:inline-block w-full md:w-auto mx-auto">
                <span>Agendar Diagnóstico</span>
              </a>
            </div>
          </div>
        </div>
        <div data-ns-animate data-delay="0.3" class="w-full max-w-max mx-auto lg:mx-0 lg:w-1/2">
          <div class="rounded-[20px] bg-background-3 dark:bg-background-5 p-5 lg:p-8 relative overflow-hidden">
            <div class="flex gap-4 sm:gap-2.5 flex-wrap sm:flex-nowrap">
              <div class="bg-white dark:bg-background-8 p-6 rounded-2xl w-full sm:w-[55%]">
                <h5 class="mb-4">
                  Proceso <br class="hidden lg:block" />
                  validado
                </h5>
                <div class="w-full h-[1px] bg-secondary/10 dark:bg-accent/10 mb-7"></div>
                <div class="flex items-center justify-between">
                  <p class="text-secondary/60 dark:text-accent/60 text-tagline-2 font-medium">
                    5 etapas probadas
                  </p>
                  <svg
                    width="18"
                    height="16"
                    viewBox="0 0 18 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M9.34462 13.401L13.2849 15.8974C13.7886 16.2165 14.4139 15.7419 14.2644 15.154L13.126 10.6756C13.0939 10.5509 13.0977 10.4197 13.137 10.297C13.1762 10.1743 13.2492 10.0652 13.3477 9.98222L16.8811 7.04132C17.3453 6.6549 17.1057 5.88439 16.5092 5.84567L11.8949 5.5462C11.7706 5.53732 11.6514 5.49332 11.5511 5.41931C11.4509 5.34531 11.3737 5.24435 11.3286 5.12819L9.60765 0.794357C9.56087 0.671064 9.47769 0.564919 9.36915 0.490017C9.26062 0.415115 9.13187 0.375 9 0.375C8.86813 0.375 8.73938 0.415115 8.63085 0.490017C8.52232 0.564919 8.43914 0.671064 8.39236 0.794357L6.6714 5.12819C6.6263 5.24435 6.54914 5.34531 6.4489 5.41931C6.34865 5.49332 6.22944 5.53732 6.10515 5.5462L1.49078 5.84567C0.894294 5.88439 0.654664 6.6549 1.11894 7.04132L4.65232 9.98222C4.75079 10.0652 4.82383 10.1743 4.86305 10.297C4.90226 10.4197 4.90606 10.5509 4.874 10.6756L3.81824 14.8288C3.63889 15.5343 4.38929 16.1038 4.99369 15.7209L8.65539 13.401C8.75837 13.3354 8.87792 13.3006 9 13.3006C9.12208 13.3006 9.24163 13.3354 9.34462 13.401Z"
                      fill=""
                      class="fill-secondary dark:fill-accent"
                    />
                  </svg>
                </div>
              </div>

              <div class="bg-white dark:bg-background-8 p-6 rounded-2xl w-full sm:w-[45%]">
                <h5 class="mb-4">Resultados</h5>
                <div class="space-y-3">
                  <div class="flex items-center gap-2">
                    <span class="text-heading-4 text-secondary dark:text-accent font-medium">100%</span>
                    <span class="text-secondary/60 dark:text-accent/60 text-tagline-2">entes satisfechos</span>
                  </div>
                  <div class="w-full h-[1px] bg-secondary/10 dark:bg-accent/10"></div>
                  <p class="text-secondary/60 dark:text-accent/60 text-tagline-2">
                    Proyectos entregados a tiempo y dentro de presupuesto
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>



  

<!-- =========================
Tech Stack Marquee
===========================-->
<section
  class="py-24 lg:py-[120px] bg-background-1 dark:bg-background-6 overflow-hidden"
  aria-label="Stack Tecnológico"
>
  <div class="max-w-[1028px] text-center w-full mx-auto mb-14">
    <span data-ns-animate data-delay="0.1" class="badge badge-section mb-5">Stack flexible</span>
    <h2 data-ns-animate data-delay="0.2" class="mb-3 font-light">Stack Tecnológico</h2>
    <p data-ns-animate data-delay="0.3" class="max-w-[582px] mx-auto w-full">
      Adaptamos el stack a tu infraestructura existente. No forzamos una tecnología si no encaja.
    </p>
  </div>

  <div class="space-y-6">
    <!-- Row 1: left marquee -->
    <div data-ns-animate data-delay="0.4" class="relative">
      <div class="absolute left-0 top-0 h-full w-[100px] bg-gradient-to-r from-background-1 to-transparent dark:from-background-6 z-40"></div>
      <div class="absolute right-0 top-0 h-full w-[100px] bg-gradient-to-l from-background-1 to-transparent dark:from-background-6 z-40"></div>
     



      

<div class="logos-marquee-container">
        {tecnologias.map((tech, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.08}>
            <div class="flex items-center justify-center rounded-2xl p-4 border border-stroke-1 bg-white dark:bg-background-5 dark:border-stroke-7">
              <StackIcon name={tech.name} variant="light" className="icon-dark h-10 w-10" />
              <StackIcon name={tech.name} variant="dark" className="icon-light h-10 w-10" />
            </div>
          </div>
        ))}
      </div>
      <div class="logos-right-marquee-container mt-10">
        {tecnologias.map((tech, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.08}>
            <div class="flex items-center justify-center rounded-2xl p-4 border border-stroke-1 bg-white dark:bg-background-5 dark:border-stroke-7">
              <StackIcon name={tech.name} variant="light" className="icon-dark h-10 w-10" />
              <StackIcon name={tech.name} variant="dark" className="icon-light h-10 w-10" />
            </div>
          </div>
        ))}
      </div>



    </div>
  </div>
</section>



  <!-- CTA — Nexsas pricing.htm centered pattern -->
  <section class="relative xl:py-[200px] py-24 overflow-hidden">
    <div class="main-container space-y-[70px]">
      <div class="flex flex-col items-center text-center">
        <span data-ns-animate data-delay="0.1" class="badge badge-section mb-5">¿Listo para empezar?</span>
        <h2 data-ns-animate data-delay="0.2" class="max-w-[650px] mx-auto mb-8 font-light">
          ¿Listo para levantar tu proceso?
        </h2>
        <p data-ns-animate data-delay="0.3" class="max-w-[500px] mx-auto mb-8">
          El primer paso es una reunión de diagnóstico. Sin compromiso, sin letra chica.
        </p>
        <div data-ns-animate data-delay="0.4">
          <button
            id="cta-diagnostico-btn"
            class="btn btn-green btn-lg md:btn-xl hover:btn-secondary dark:hover:btn-accent"
          >
            <span>Agendar Diagnóstico</span>
          </button>
        </div>
      </div>
    </div>
  </section>


<style is:inline>
  /* StackIcon variant toggle — default is dark theme, .light class overrides */
  /* !important needed because StackIcon sets inline display styles */
  .icon-light { display: none !important; }
  .icon-dark { display: inline-block !important; }

  .light .icon-light { display: inline-block !important; }
  .light .icon-dark { display: none !important; }
</style>

<script>
import InfiniteMarquee from 'vanilla-infinite-marquee';
import '/node_modules/vanilla-infinite-marquee/infinite-marquee.css';

function initMarquees() {


  if (typeof InfiniteMarquee === 'undefined') return;

  const configs = [
    {
      selector: '.logos-marquee-container',
      speed: 140000,
      direction: 'left',
      spaceBetween:"20px",
      duplicateCount: 1,
      smoothEdges: true,
      mobileSettings: { direction: 'left', speed: 50000 },
    },
    {
      selector: '.logos-right-marquee-container',
      speed: 140000,
      direction: 'right',
      spaceBetween:"20px",
      duplicateCount: 1,
      smoothEdges: true,
      mobileSettings: { direction: 'right', speed: 50000 },
    }
    
  ];

  configs.forEach(({ selector, ...options }) => {
    const el = document.querySelector(selector);
    if (!el) return;

    // Evitar reinicializar si InfiniteMarquee ya procesó el elemento
    if (el.dataset.marqueeInit === 'true') return;

    new InfiniteMarquee({
      element: selector,
      on: { beforeInit: () => {}, afterInit: () => {} },
      ...options,
    });

    el.dataset.marqueeInit = 'true';
  });
}


document.addEventListener('DOMContentLoaded', initMarquees);


document.addEventListener('astro:after-swap', () => {
  initMarquees();
});

</script>

<DemoModal
  modalTitle="Agendar Diagnóstico"
  modalDescription="Completá tus datos y te contactamos para una reunión de diagnóstico sin compromiso. Analizamos tu operación y te proponemos un plan de acción."
  ctaLabel="Agendar Diagnóstico"
  successTitle="¡Solicitud recibida!"
  successMessage="Te contactaremos en las próximas 24 horas hábiles para agendar tu diagnóstico."
  solucionTitle="Diagnóstico Gratuito"
/>

<script>
  document.getElementById('cta-diagnostico-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-demo-modal'));
  });
</script>
</Layout>


