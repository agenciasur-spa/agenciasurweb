const stackCategorias = [
  {
    titulo: 'Frontend',
    items: ['React', 'Vue.js', 'Angular', 'Next.js', 'Astro', 'JavaScript'],
  },
  {
    titulo: 'Backend',
    items: ['Node.js', 'Symfony', 'NestJS', 'Python', 'Django', 'Flask', 'Laravel', 'PHP'],
  },
  {
    titulo: 'Bases de datos',
    items: ['MySQL', 'PostgreSQL', 'MongoDB', 'Redis'],
  },
  {
    titulo: 'Cloud & Hosting',
    items: ['AWS', 'Azure', 'DigitalOcean', 'Supabase', 'Heroku', 'Vercel', 'Netlify'],
  },
