---
import Layout from '../layouts/Layout.astro';
import ContactoFooter from '../components/ContactoFooter.astro';
import DemoModal from '../components/DemoModal.astro';
import Footer from '../components/Footer.astro';
import { UserCog, Workflow, Code, Cloud, ShieldCheck, Rocket, CheckCircle, Smartphone, Accessibility, Monitor, Server, Database, Container, Globe, GitBranch, Zap, Webhook } from '@lucide/astro';
import StackIcon from 'tech-stack-icons';



const procesoSteps = [
  {
    step: '01',
    title: 'Levantamiento de Procesos',
    description: 'Entrevistamos a los stakeholders clave, mapeamos los flujos actuales e identificamos cuellos de botella. Entregamos un diagnóstico con recomendaciones priorizadas.',
    detail: 'No programamos una sola línea hasta entender tu operación.',
    icon: UserCog,
  },
  {
    step: '02',
    title: 'Diseño de Solución',
    description: 'Definimos la arquitectura técnica, los flujos de usuario y los criterios de aceptación. Prototipamos las pantallas críticas para validación antes de desarrollar.',
    detail: 'Wireframes, arquitectura de datos y plan de integración.',
    icon: Workflow,
  },
  {
    step: '03',
    title: 'Desarrollo Iterativo',
    description: 'Construimos en ciclos cortos con demostraciones frecuentes. Cada sprint entrega funcionalidad usable, no acumulamos deuda técnica.',
    detail: 'Sprints de 2 semanas con review del cliente.',
    icon: Code,
  },
  {
    step: '04',
    title: 'Testing & QA',
    description: 'Pruebas automatizadas y manuales. Validación con usuarios reales del cliente. Performance, seguridad y accesibilidad verificadas.',
    detail: 'Nada se entrega sin pasar QA.',
    icon: ShieldCheck,
  },
  {
    step: '05',
    title: 'Deploy & Soporte',
    description: 'Puesta en producción con plan de rollback. Capacitación al equipo interno. Soporte post-entrega según SLA acordado.',
    detail: 'Acompañamiento continuo, no desaparecemos después del deploy.',
    icon: Rocket,
  },
];

const servicios = [
  {
    icon: UserCog,
    slug: 'consultoria',
    title: 'Consultoría',
    description: 'Asesoría tecnológica estratégica para tu negocio.',
    detalle:
      'Diagnosticamos tu operación antes de proponer una sola herramienta. Identificamos cuellos de botella reales, priorizamos por impacto y definimos una hoja de ruta técnica que tu equipo puede ejecutar con o sin nosotros.',
    capacidades: [
      'Diagnóstico de procesos y sistemas',
      'Arquitectura de solución',
      'Priorización por impacto',
      'Roadmap técnico',
      'Acompañamiento a equipos internos',
      'Auditoría de infraestructura existente',
    ],
  },
  {
    icon: Workflow,
    slug: 'automatizacion',
    title: 'Automatización',
    description: 'Optimizamos procesos críticos con tecnología inteligente.',
    detalle:
      'Conectamos tus sistemas y eliminamos tareas manuales repetitivas. Diseñamos flujos que se adaptan a cómo opera tu negocio, no al revés.',
    capacidades: [
      'Automatización de flujos de trabajo',
      'Integraciones entre sistemas (APIs)',
      'Bots y agentes para tareas repetitivas',
      'Orquestación de procesos (n8n y similares)',
      'Notificaciones y alertas automatizadas',
      'Reducción de errores operativos',
    ],
  },
  {
    icon: Code,
    slug: 'desarrollo-web',
    title: 'Desarrollo Web',
    description: 'Sistemas robustos sobre arquitecturas modernas.',
    detalle:
      'Construimos plataformas y sistemas web sobre arquitecturas modernas, pensadas para crecer sin reescribirse cada dos años.',
    capacidades: [
      'Frontend & backend a medida',
      'Integraciones con CMS headless',
      'APIs y arquitectura de datos',
      'Aplicaciones web responsivas',
      'Performance y accesibilidad',
      'Mantenimiento y evolución continua',
    ],
  },
  {
    icon: Cloud,
    slug: 'infraestructura-cloud',
    title: 'Infraestructura y Cloud',
    description: 'Infraestructura escalable y gestión en la nube.',
    detalle:
      'Diseñamos infraestructura que escala con tu operación, con foco en disponibilidad, seguridad y costos predecibles.',
    capacidades: [
      'Arquitectura cloud (AWS, GCP, Azure)',
      'Despliegues y CI/CD',
      'Monitoreo y observabilidad',
      'Seguridad desde el diseño',
      'Optimización de costos',
      'Migración y modernización',
    ],
  },
];


const tecnologias = [
  { name: 'symfony' },
  { name: 'astro' },
  { name: 'nextjs2' },
  { name: 'nestjs' },
  { name: 'react' },
  { name: 'vuejs' },
  { name: 'angular' },
  { name: 'nodejs' },
    { name: 'python' },
    { name: 'django' },
    { name: 'flask' },
    { name: 'js' },
    { name: 'php' },
    { name: 'laravel' },
    { name: 'mysql' },
    { name: 'postgresql' },
    { name: 'mongodb' },
    { name: 'redis' },
    { name: 'docker' },
    { name: 'kubernetes' },
    { name: 'aws' },
    { name: 'azure' },
    { name: 'supabase' },
    { name: 'heroku' },
    { name: 'digitalocean' },
    { name: 'netlify' },
    { name: 'vercel' },
    
];

const stackCategorias = [
  {
    titulo: 'Frontend',
    items: ['React', 'Vue.js', 'Angular', 'Next.js', 'Astro', 'JavaScript'],
  },
  {
    titulo: 'Backend',
    items: ['Node.js', 'Symfony', 'NestJS', 'Python', 'Django', 'Flask', 'Laravel', 'PHP'],
  },
  {
    titulo: 'Bases de datos',
    items: ['MySQL', 'PostgreSQL', 'MongoDB', 'Redis'],
  },
  {
    titulo: 'Cloud & Hosting',
    items: ['AWS', 'Azure', 'DigitalOcean', 'Supabase', 'Heroku', 'Vercel', 'Netlify'],
  },
  {
    titulo: 'DevOps',
    items: ['Docker', 'Kubernetes'],
  },
];

const diferenciadores = [
  'Clarity Over Clutter — simplificamos lo complejo sin perder funcionalidad.',
  'People Before Features — el usuario opera, no el manual.',
  'Security as a Standard — seguridad desde el diseño, no como afterthought.',
];
---

<Layout title="Servicios | Agencia Sur">



  <!-- Hero — Qué hacemos (los 4 servicios reales, antes solo vivían en el mega-menu) -->
  <section class="relative overflow-hidden bg-background-6 pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <canvas
      data-live-gradient
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
      aria-hidden="true"
    ></canvas>
    <div class="main-container relative z-10">
      <div class="text-center space-y-5">
        <span data-ns-animate data-delay="0.1" class="badge badge-section">Qué hacemos</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto font-light text-white">
            Servicios pensados para tu operación
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto text-white/60">
            Cuatro frentes de trabajo, un mismo objetivo: que la tecnología deje de ser un
            problema y empiece a ser una ventaja.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Marquee tipografico de servicios — patron "BRANDING + A.I. +
       DESIGN + DEVELOPMENT" de trionn.com/services: los 4 servicios en
       loop horizontal con tipografia gigante. Sin WebGL — solo CSS +
       vanilla-infinite-marquee (misma lib que el stack tecnologico mas
       abajo, ver initMarquees()). -->
  <section class="relative overflow-hidden bg-background-6 py-16 md:py-20 lg:py-24">
    <div class="absolute left-0 top-0 h-full w-[80px] md:w-[140px] bg-gradient-to-r from-background-6 to-transparent z-10"></div>
    <div class="absolute right-0 top-0 h-full w-[80px] md:w-[140px] bg-gradient-to-l from-background-6 to-transparent z-10"></div>

    <div class="disciplines-marquee-container flex items-center whitespace-nowrap">
      {servicios.map(({ title }) => (
        <div class="flex items-center gap-8 md:gap-12 px-4">
          <span class="text-[2.75rem] sm:text-[4.25rem] lg:text-[5.5rem] font-light uppercase tracking-tight text-white">
            {title}
          </span>
          <span class="text-accent-400 text-[1.75rem] sm:text-[2.5rem] lg:text-[3rem]" aria-hidden="true">+</span>
        </div>
      ))}
    </div>

    <p data-ns-animate data-delay="0.2" class="text-center mt-10 md:mt-14 text-white/50">
      ✦ Capacidades pensadas para escalar con tu operación.
    </p>
  </section>

  <!-- Detalle por servicio — patron "Our Core Capabilities" de
       trionn.com/services: imagen + titulo + descripcion + lista de
       capacidades, con una linea que se dibuja (scaleX 0 -> 1) al hacer
       scroll via initCapabilityLines en animations.ts. La imagen es un
       placeholder con gradiente de marca hasta que se suba la foto real a
       /public/images/servicios/{slug}.jpg (ver data-service-image de cada
       bloque) — si el archivo no existe, el layer de gradiente de fondo
       queda visible sin icono de imagen rota. -->
  <section class="relative bg-background-1 dark:bg-background-6">
    {servicios.map(({ title, detalle, capacidades, slug }, index) => {
      const reversed = index % 2 === 1;
      return (
      <div class={`main-container py-20 md:py-24 lg:py-28 ${index !== 0 ? 'border-t border-stroke-1 dark:border-stroke-7' : ''}`}>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-8 items-center">
          <div class={`lg:col-span-5 lg:row-start-1 ${reversed ? 'lg:col-start-8' : ''}`}>
            <div data-ns-animate data-delay="0.1" class="mb-16 lg:mb-20">
              <h2 class="text-heading-3 font-light -tracking-[0.02em] mb-6">{title}</h2>
              <p class="max-w-md">{detalle}</p>
            </div>
            <div data-ns-animate data-delay="0.2" class="max-w-md">
              <span class="text-tagline-2 uppercase tracking-widest text-secondary/50 dark:text-accent/40 block mb-6">
                Capacidades
              </span>
              <div class="cap-list" id={`cap-list-${slug}`}>
                {capacidades.map((cap, i) => (
                  <Fragment>
                    <div class="py-4">
                      <p class="text-secondary dark:text-accent">{cap}</p>
                    </div>
                    {i < capacidades.length - 1 && (
                      <div class="relative h-px">
                        <div class="cap-divider-line absolute inset-0 origin-left scale-x-0 bg-stroke-2 dark:bg-stroke-6"></div>
                      </div>
                    )}
                  </Fragment>
                ))}
              </div>
            </div>
          </div>

          <!-- Placeholder de imagen: gradiente de marca + intento de carga
               de la foto real (que aun no existe). -->
          <div
            data-ns-animate
            data-direction="up"
            data-offset="30"
            data-delay="0.3"
            data-service-image={slug}
            class={`lg:col-span-6 lg:row-start-1 ${reversed ? 'lg:col-start-1 lg:self-start' : 'lg:col-start-7'} aspect-4/3 rounded-[20px] border border-stroke-1 dark:border-stroke-7 bg-gradient-to-br from-accent-400/25 via-background-3 to-secondary/5 dark:from-accent-400/15 dark:via-background-6 dark:to-background-8 bg-cover bg-center`}
            style={`background-image: url('/images/servicios/${slug}.jpg');`}
          >
          </div>
        </div>
      </div>
      );
    })}
  </section>

  <!-- Nuestro Método — Nexsas services.htm pattern, ahora horizontal estilo trionn.com -->
  <section class="relative bg-background-2 dark:bg-background-6 pt-14 md:pt-16 lg:pt-[88px] xl:pt-[100px] pb-24 md:pb-36 lg:pb-40 xl:pb-[200px]">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-section">Nuestro Método</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto font-light">
            Cómo trabajamos
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto text-secondary/60 dark:text-accent/60">
            No vendemos horas. Entregamos soluciones que resuelven problemas reales.
            Nuestro proceso existe para garantizar que cada proyecto tenga impacto medible.
          </p>
        </div>
      </div>

      <!-- Steps en una sola fila conectada (antes: zigzag vertical con
           gradiente neón). Inspirado en el "How we work" de trionn.com:
           una sola línea que atraviesa todos los pasos, revelados al
           hacer scroll con el sistema [data-ns-animate] existente. -->
      <div class="process-steps relative">
        <!-- Línea conectora horizontal (solo desktop, donde los 5 pasos
             quedan en una sola fila). El tramo base va gris; step-line-h
             se rellena de verde vía initStepLineAnimation al hacer scroll. -->
        <div class="hidden lg:block absolute inset-x-0 top-[17px] h-px bg-stroke-2 dark:bg-stroke-6 overflow-hidden">
          <div
            class="step-line-h h-full bg-gradient-to-r from-accent-300 via-accent-400 to-accent-300"
            style="width: 0%;"
          ></div>
        </div>

        <div class="relative z-10 grid grid-cols-1 gap-y-12 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-5 lg:gap-x-6">
          {procesoSteps.map((item, i) => (
            <div data-ns-animate data-delay={0.3 + i * 0.1} class="text-center lg:text-left">
              <div class="size-[34px] flex items-center justify-center mx-auto lg:mx-0 rounded-full bg-secondary dark:bg-background-8 drop-shadow-2xl">
                <span class="text-accent-300">{item.step}</span>
              </div>
              <div class="mt-6 space-y-2 max-w-[280px] mx-auto lg:mx-0">
                <p class="text-accent-600 text-tagline-2 font-medium">PASO {item.step}</p>
                <h5 class="text-heading-6 text-secondary dark:text-accent">{item.title}</h5>
                <small class="text-secondary/60 dark:text-accent/60">{item.description}</small>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>











  <!-- Diferenciadores — Nexsas feature.htm two-column pattern -->
  <section class="relative bg-background-2 dark:bg-background-6 pt-14 md:pt-16 lg:pt-[88px] xl:pt-[100px] pb-24 md:pb-36 lg:pb-40 xl:pb-[200px] overflow-hidden">
    <div class="main-container">
      <div class="flex items-center flex-wrap lg:flex-nowrap gap-y-8 lg:gap-4 xl:gap-8">
        <div class="w-full lg:w-1/2">
          <div class="text-center lg:text-left">
            <span data-ns-animate data-delay="0.1" class="badge badge-section mb-5">Diferenciadores</span>
            <h2 data-ns-animate data-delay="0.2" class="mb-8 max-w-[520px] mx-auto lg:mx-0 font-light">
              Diseñado para entregar resultados tangibles
            </h2>
            <p data-ns-animate data-delay="0.3" class="mb-8 max-w-[520px] mx-auto lg:mx-0">
              Cada proyecto comienza con un diagnóstico real y termina con una solución operativa.
              No entregamos documentos — entregamos software que funciona.
            </p>
            <ul class="space-y-4 mb-14">
              {diferenciadores.map((d, i) => (
                <li
                  data-ns-animate
                  data-delay={0.4 + i * 0.1}
                  class="flex items-center lg:justify-start justify-center gap-2"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                    class="shrink-0"
                  >
                    <rect
                      width="18"
                      height="18"
                      rx="9"
                      fill=""
                      class="fill-accent-400/15"
                    />
                    <path
                      d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z"
                      fill=""
                      class="fill-accent-400"
                    />
                  </svg>
                  <span class="text-secondary/70 dark:text-accent/60">{d}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.7">
              <a href="/contacto" class="btn btn-secondary hover:btn-white dark:btn-white-dark btn-xl block md:inline-block w-full md:w-auto mx-auto">
                <span>Agendar Diagnóstico</span>
              </a>
            </div>
          </div>
        </div>
        <div data-ns-animate data-delay="0.3" class="w-full max-w-max mx-auto lg:mx-0 lg:w-1/2">
          <div class="rounded-[20px] bg-background-3 dark:bg-background-5 p-5 lg:p-8 relative overflow-hidden">
            <div class="flex gap-4 sm:gap-2.5 flex-wrap sm:flex-nowrap">
              <div class="bg-white dark:bg-background-8 p-6 rounded-2xl w-full sm:w-[55%]">
                <h5 class="mb-4">
                  Proceso <br class="hidden lg:block" />
                  validado
                </h5>
                <div class="w-full h-[1px] bg-secondary/10 dark:bg-accent/10 mb-7"></div>
                <div class="flex items-center justify-between">
                  <p class="text-secondary/60 dark:text-accent/60 text-tagline-2 font-medium">
                    5 etapas probadas
                  </p>
                  <svg
                    width="18"
                    height="16"
                    viewBox="0 0 18 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M9.34462 13.401L13.2849 15.8974C13.7886 16.2165 14.4139 15.7419 14.2644 15.154L13.126 10.6756C13.0939 10.5509 13.0977 10.4197 13.137 10.297C13.1762 10.1743 13.2492 10.0652 13.3477 9.98222L16.8811 7.04132C17.3453 6.6549 17.1057 5.88439 16.5092 5.84567L11.8949 5.5462C11.7706 5.53732 11.6514 5.49332 11.5511 5.41931C11.4509 5.34531 11.3737 5.24435 11.3286 5.12819L9.60765 0.794357C9.56087 0.671064 9.47769 0.564919 9.36915 0.490017C9.26062 0.415115 9.13187 0.375 9 0.375C8.86813 0.375 8.73938 0.415115 8.63085 0.490017C8.52232 0.564919 8.43914 0.671064 8.39236 0.794357L6.6714 5.12819C6.6263 5.24435 6.54914 5.34531 6.4489 5.41931C6.34865 5.49332 6.22944 5.53732 6.10515 5.5462L1.49078 5.84567C0.894294 5.88439 0.654664 6.6549 1.11894 7.04132L4.65232 9.98222C4.75079 10.0652 4.82383 10.1743 4.86305 10.297C4.90226 10.4197 4.90606 10.5509 4.874 10.6756L3.81824 14.8288C3.63889 15.5343 4.38929 16.1038 4.99369 15.7209L8.65539 13.401C8.75837 13.3354 8.87792 13.3006 9 13.3006C9.12208 13.3006 9.24163 13.3354 9.34462 13.401Z"
                      fill=""
                      class="fill-secondary dark:fill-accent"
                    />
                  </svg>
                </div>
              </div>

              <div class="bg-white dark:bg-background-8 p-6 rounded-2xl w-full sm:w-[45%]">
                <h5 class="mb-4">Resultados</h5>
                <div class="space-y-3">
                  <div class="flex items-center gap-2">
                    <span class="text-heading-4 text-secondary dark:text-accent font-medium">100%</span>
                    <span class="text-secondary/60 dark:text-accent/60 text-tagline-2">clientes satisfechos</span>
                  </div>
                  <div class="w-full h-[1px] bg-secondary/10 dark:bg-accent/10"></div>
                  <p class="text-secondary/60 dark:text-accent/60 text-tagline-2">
                    Proyectos entregados a tiempo y dentro de presupuesto
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>



  

<!-- =========================
Tech Stack Marquee
===========================-->
<section
  class="py-24 lg:py-[120px] bg-background-1 dark:bg-background-6 overflow-hidden"
  aria-label="Stack Tecnológico"
>
  <div class="max-w-[1028px] text-center w-full mx-auto mb-14">
    <span data-ns-animate data-delay="0.1" class="badge badge-section mb-5">Stack flexible</span>
    <h2 data-ns-animate data-delay="0.2" class="mb-3 font-light">Stack Tecnológico</h2>
    <p data-ns-animate data-delay="0.3" class="max-w-[582px] mx-auto w-full">
      Adaptamos el stack a tu infraestructura existente. No forzamos una tecnología si no encaja.
    </p>
  </div>

  <div class="space-y-6">
    <!-- Row 1: left marquee -->
    <div data-ns-animate data-delay="0.4" class="relative">
      <div class="absolute left-0 top-0 h-full w-[100px] bg-gradient-to-r from-background-1 to-transparent dark:from-background-6 z-40"></div>
      <div class="absolute right-0 top-0 h-full w-[100px] bg-gradient-to-l from-background-1 to-transparent dark:from-background-6 z-40"></div>
     



      

<div class="logos-marquee-container">
        {tecnologias.map((tech, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.08}>
            <div class="flex items-center justify-center rounded-2xl p-4 border border-stroke-1 bg-white dark:bg-background-5 dark:border-stroke-7">
              <StackIcon name={tech.name} variant="light" className="icon-dark h-10 w-10" />
              <StackIcon name={tech.name} variant="dark" className="icon-light h-10 w-10" />
            </div>
          </div>
        ))}
      </div>
      <div class="logos-right-marquee-container mt-10">
        {tecnologias.map((tech, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.08}>
            <div class="flex items-center justify-center rounded-2xl p-4 border border-stroke-1 bg-white dark:bg-background-5 dark:border-stroke-7">
              <StackIcon name={tech.name} variant="light" className="icon-dark h-10 w-10" />
              <StackIcon name={tech.name} variant="dark" className="icon-light h-10 w-10" />
            </div>
          </div>
        ))}
      </div>



    </div>
  </div>
</section>

  <!-- Stack tecnológico categorizado — patron "technology stack" de
       trionn.com/services: mismo stack que el marquee de logos de
       arriba, pero organizado por categoria en texto — complementa,
       no reemplaza, el marquee (mas "credencial tecnica" para quien
       lee en detalle). -->
  <section class="py-24 lg:py-[120px] bg-background-2 dark:bg-background-8">
    <div class="main-container">
      <div class="max-w-[700px] mb-16 md:mb-20">
        <span data-ns-animate data-delay="0.1" class="badge badge-section mb-5">Detalle técnico</span>
