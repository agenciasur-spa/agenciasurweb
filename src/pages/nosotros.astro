---
import Layout from '../layouts/Layout.astro';
import StatsBar from '../components/StatsBar.astro';
import NosotrosSection from '../components/NosotrosSection.astro';
import ContactoFooter from '../components/ContactoFooter.astro';
import { Clock, Code, Shield, Eye } from '@lucide/astro';

const timeline = [
  { year: '2008', event: 'Inicio de trayectoria técnica en desarrollo de software empresarial.' },
  { year: '2012', event: 'Primeros proyectos de automatización de procesos para el sector financiero.' },
  { year: '2016', event: 'Fundación de Agencia Sur. Enfoque en transformación digital.' },
  { year: '2019', event: 'Lanzamiento del Sistema de Compras. Primer producto propio.' },
  { year: '2021', event: 'Expansión a gestión de personal transitorio y mesa de ayuda.' },
  { year: '2024', event: '50+ proyectos entregados. Clientes como BancoEstado y ServiEstado.' },
];

const valores = [
  {
    title: 'Antes de programar, entendemos',
    description: 'No escribimos código sin un diagnóstico previo. Cada proyecto parte de un levantamiento real de procesos.',
    icon: Clock,
  },
  {
    title: 'Código con propósito',
    description: 'Cada línea responde a un objetivo de negocio. No hay features por vanity ni deuda técnica innecesaria.',
    icon: Code,
  },
  {
    title: 'Acompañamiento continuo',
    description: 'No desaparecemos después del deploy. Nuestro éxito se mide en la operación del cliente, no en la entrega.',
    icon: Shield,
  },
  {
    title: 'Transparencia total',
    description: 'Sprints con demostraciones, estimaciones honestas y comunicación directa. Sin humo.',
    icon: Eye,
  },
];
---

<Layout title="Nosotros | Agencia Sur">

  <!-- Hero de página -->
  <section class="pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <div class="main-container">
      <div class="text-center space-y-5 mb-10">
        <span data-ns-animate data-delay="0.1" class="badge badge-primary">Quiénes Somos</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto">
            18 años convirtiendo complejidad en simplicidad
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto">
            Somos un equipo técnico con trayectoria real en operaciones empresariales.
            No somos una agencia creativa — somos ingenieros que resuelven problemas de negocio con software.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión (2-columnas) -->
  <NosotrosSection />

  <!-- Stats -->
  <StatsBar />

  <!-- Timeline -->
  <section class="py-14 md:py-16 lg:py-[88px] xl:py-[100px] bg-background-2 dark:bg-background-5">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-yellow">Trayectoria</span>
        <h2 data-ns-animate data-delay="0.2">Nuestra Historia</h2>
      </div>

      <div class="max-w-[800px] mx-auto space-y-8">
        {timeline.map((item, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.08} class="flex gap-6 items-start">
            <span class="text-heading-4 font-bold text-primary-500 flex-shrink-0 w-20">{item.year}</span>
            <p class="text-tagline-1 pt-1">{item.event}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="bg-secondary dark:bg-background-8 py-20 lg:py-[100px] xl:py-[140px]">
    <div class="main-container">
      <div class="mb-10 max-w-[514px] space-y-3 md:mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-primary">Valores</span>
        <h2 data-ns-animate data-delay="0.2" class="text-accent">Cómo Trabajamos</h2>
      </div>

      <div class="grid grid-cols-12 xl:gap-8 md:gap-8 gap-y-5">
        {valores.map((valor, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.1} class="col-span-12 md:col-span-6">
            <div class="bg-background-1 dark:bg-background-6 rounded-[20px] p-8 space-y-4 h-full">
              <div class="flex size-12 items-center justify-center rounded-2xl bg-primary-500/10 dark:bg-accent/10">
                <valor.icon class="size-6 text-primary-500 dark:text-accent" />
              </div>
              <h3 class="text-heading-5 text-secondary dark:text-accent">{valor.title}</h3>
              <p class="text-secondary/60 dark:text-accent/60">{valor.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 md:py-16 lg:py-[88px] xl:py-[100px]">
    <div class="main-container text-center">
      <div class="max-w-[600px] mx-auto space-y-5">
        <h2 data-ns-animate data-delay="0.1">¿Quieres conocer nuestro enfoque?</h2>
        <p data-ns-animate data-delay="0.2">
          Agenda una reunión sin compromiso. Te explicamos cómo podríamos ayudarte.
        </p>
        <div data-ns-animate data-delay="0.3">
          <a href="/contacto" class="btn btn-primary btn-lg md:btn-xl hover:btn-secondary dark:hover:btn-accent">
            <span>Hablemos</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactoFooter />
</Layout>
