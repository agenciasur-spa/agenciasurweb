                <path d="M25 88 L28 91 L32 85" stroke="#8FD14F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <text x="38" y="90" fill="rgba(255,255,255,0.7)" font-size="9" font-family="system-ui, sans-serif">Diseño de arquitectura</text>
                <text x="200" y="90" text-anchor="end" fill="rgba(143,209,79,0.5)" font-size="8" font-family="system-ui, sans-serif">✓</text>
