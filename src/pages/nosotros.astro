---
import Layout from '../layouts/Layout.astro';
import StatsBar from '../components/StatsBar.astro';
import NosotrosSection from '../components/NosotrosSection.astro';
import ContactoFooter from '../components/ContactoFooter.astro';
import { Clock, Code, Shield, Eye, CheckCircle } from '@lucide/astro';

const timeline = [
  { year: '2008', event: 'Inicio de trayectoria técnica en desarrollo de software empresarial.' },
  { year: '2012', event: 'Primeros proyectos de automatización de procesos para el sector financiero.' },
  { year: '2016', event: 'Fundación de Agencia Sur. Enfoque en transformación digital.' },
  { year: '2019', event: 'Lanzamiento del Sistema de Compras. Primer producto propio.' },
  { year: '2021', event: 'Expansión a gestión de personal transitorio y mesa de ayuda.' },
  { year: '2024', event: '50+ proyectos entregados. Clientes como BancoEstado y ServiEstado.' },
];

const valores = [
  {
    title: 'Antes de programar, entendemos',
    description: 'No escribimos código sin un diagnóstico previo. Cada proyecto parte de un levantamiento real de procesos.',
    icon: Clock,
  },
  {
    title: 'Código con propósito',
    description: 'Cada línea responde a un objetivo de negocio. No hay features por vanity ni deuda técnica innecesaria.',
    icon: Code,
  },
  {
    title: 'Acompañamiento continuo',
    description: 'No desaparecemos después del deploy. Nuestro éxito se mide en la operación del cliente, no en la entrega.',
    icon: Shield,
  },
  {
    title: 'Transparencia total',
    description: 'Sprints con demostraciones, estimaciones honestas y comunicación directa. Sin humo.',
    icon: Eye,
  },
];

const principios = [
  'Entendemos antes de construir — diagnóstico real de procesos antes de cualquier línea de código.',
  'Código con propósito — cada feature responde a un objetivo de negocio medible.',
  'Acompañamiento post-deploy — medimos éxito por la operación del cliente, no por la entrega.',
  'Transparencia total — sprints con demos, estimaciones honestas y comunicación directa.',
];
---

<Layout title="Nosotros | Agencia Sur">

  <!-- Hero -->
  <section class="overflow-hidden pt-32 pb-14 sm:pt-36 md:pt-42 md:pb-16 lg:pb-[88px] xl:pt-[180px] xl:pb-[100px]">
    <div class="main-container space-y-14 md:space-y-[70px]">
      <div class="space-y-3 text-center">
        <span data-ns-animate data-delay="0.1" class="badge badge-cyan mb-5">Quiénes Somos</span>
        <h2 data-ns-animate data-delay="0.2" class="mx-auto max-w-[980px]">
          18 años convirtiendo complejidad en <span class="text-accent-400">simplicidad</span>
        </h2>
        <p data-ns-animate data-delay="0.3" class="mx-auto max-w-[700px]">
          Somos un equipo técnico con trayectoria real en operaciones empresariales.
          No somos una agencia creativa — somos ingenieros que resuelven problemas de negocio con software.
        </p>
      </div>

      <!-- Hero visual -->
      <div class="flex flex-col-reverse items-start justify-around gap-x-4 gap-y-7 md:flex-row md:items-center lg:items-end 2xl:justify-evenly">
        <article class="flex flex-row items-center space-y-[25px] max-md:justify-between max-md:gap-2 md:hidden md:flex-col lg:block">
          <figure data-ns-animate data-delay="0.4" data-duration="2.8" data-spring data-direction="left"
            class="shadow-5 max-h-[250px] max-w-[254px] overflow-hidden rounded-2xl">
            <img src="https://picsum.photos/254/250?random=101" class="shadow-5 block size-full object-cover" alt="Procesos empresariales" loading="lazy" />
          </figure>
          <figure data-ns-animate data-delay="0.5" data-duration="2.2" data-spring
            class="shadow-2 max-h-[110px] max-w-[143px] overflow-hidden rounded-2xl">
            <img src="https://picsum.photos/143/110?random=102" class="block size-full object-cover" alt="Equipo técnico" loading="lazy" />
          </figure>
        </article>

        <figure data-ns-animate data-delay="0.5" data-direction="up" class="max-h-[564px] max-w-[630px]">
          <img src="https://picsum.photos/630/564?random=103" alt="Equipo Agencia Sur" loading="lazy" class="size-full object-cover rounded-2xl" />
        </figure>

        <article class="space-y-[37px] max-md:w-full">
          <figure data-ns-animate data-delay="0.5" data-spring data-duration="2.2">
            <div class="flex items-center gap-2 text-tagline-1 font-medium text-secondary dark:text-accent">
              <CheckCircle class="size-5 text-ns-green" />
              <span>Procesos certificados</span>
            </div>
          </figure>

          <div data-ns-animate data-delay="0.4" data-direction="right"
            class="bg-secondary dark:bg-accent flex h-auto w-full flex-col items-start gap-1 rounded-2xl p-4 md:h-[91px] md:w-[148px]">
            <h3 class="text-tagline-2 text-accent dark:text-secondary font-normal">Proyectos</h3>
            <h3 class="text-heading-5 text-ns-green dark:text-secondary flex items-center justify-center gap-0.5 font-normal">
              <span data-counter data-number="50" data-speed="1000" data-interval="180" data-rooms="2" data-height-space="2.6">50</span>+
            </h3>
          </div>

          <div data-ns-animate data-delay="0.6" data-direction="right"
            class="max-w-full min-w-full rounded-2xl bg-white p-6 md:max-w-[288px] md:min-w-[288px] dark:bg-black">
            <div class="text-left">
              <span class="text-tagline-2 text-secondary dark:text-accent font-normal">Experiencia</span>
              <h3 class="mt-2 mb-[30px] flex items-center text-heading-2 leading-[1.2] font-normal">
                <span data-counter data-number="18" data-speed="1000" data-interval="180" data-rooms="2" data-height-space="2.2">18</span>+ años
              </h3>
            </div>
            <div class="flex gap-3">
              <div class="bg-background-4 dark:bg-background-9 flex-1 space-y-2 rounded-xl p-4 text-left">
                <div class="text-tagline-2 text-secondary dark:text-accent flex items-center justify-start gap-2">
                  <span class="bg-ns-green flex size-[18px] items-center justify-center rounded-full p-1">
                    <svg width="8" height="9" viewBox="0 0 8 9" fill="none"><path d="M7.8842 4.50308C7.81538 4.57946 7.72089 4.62436 7.62101 4.62815C7.51393 4.63024 7.41095 4.58486 7.33717 4.50308L4.39555 1.40367L4.39555 8.59218C4.39277 8.81619 4.2211 8.99707 4.0085 9C3.79589 8.99707 3.62422 8.81619 3.62144 8.59218L3.62144 1.40367L0.679823 4.50308C0.581182 4.60993 0.435935 4.65321 0.298794 4.61663C0.161654 4.58004 0.0534544 4.46915 0.0149541 4.32572C-0.0235462 4.18229 0.0135021 4.02811 0.112143 3.92127L3.72465 0.114967C3.87798 -0.0383222 4.11836 -0.0383222 4.27169 0.114967L7.8842 3.92127C7.95828 3.99794 8 4.10276 8 4.21217C8 4.32159 7.95828 4.42641 7.8842 4.50308Z" fill="#1A1A1C"/></svg>
                  </span>
                  Procesos
                </div>
                <div class="dark:text-accent flex items-center text-lg leading-[1.5] font-medium">200+</div>
              </div>
              <div class="bg-background-4 dark:bg-background-9 flex-1 space-y-2 rounded-xl p-4 text-left">
                <div class="text-tagline-2 text-secondary dark:text-accent flex items-center justify-start gap-2">
                  <span class="bg-ns-green flex size-[18px] items-center justify-center rounded-full p-1">
                    <svg width="8" height="9" viewBox="0 0 8 9" fill="none"><path d="M7.8842 4.49692C7.81538 4.42054 7.72089 4.37564 7.62101 4.37185C7.51393 4.36976 7.41095 4.41514 7.33717 4.49692L4.39555 7.59633L4.39555 0.407818C4.39277 0.18381 4.2211 0.00292873 4.0085 0C3.79589 0.00292873 3.62422 0.18381 3.62144 0.407818L3.62144 7.59633L0.679823 4.49692C0.581182 4.39007 0.435935 4.34679 0.298794 4.38337C0.161654 4.41996 0.0534544 4.53085 0.0149541 4.67428C-0.0235462 4.81771 0.0135021 4.97189 0.112143 5.07873L3.72465 8.88503C3.87798 9.03832 4.11836 9.03832 4.27169 8.88503L7.8842 5.07873C7.95828 5.00206 8 4.89724 8 4.78783C8 4.67841 7.95828 4.57359 7.8842 4.49692Z" fill="#1A1A1C"/></svg>
                  </span>
                  Clientes
                </div>
                <div class="dark:text-accent flex items-center text-lg leading-[1.5] font-medium">30+</div>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Misión -->
  <NosotrosSection />

  <!-- Visión / Stats -->
  

  <!-- Timeline -->
  <section class="pb-14 pt-14 md:pb-16 md:pt-16 lg:pb-[88px] lg:pt-[88px] xl:pb-[100px] xl:pt-[100px]">
    <div class="main-container space-y-16 md:space-y-[100px]">
      <div class="space-y-3 text-center">
        <span data-ns-animate data-delay="0.1" class="badge badge-yellow mb-5">Trayectoria</span>
        <h2 data-ns-animate data-delay="0.2">Nuestra Historia</h2>
        <p data-ns-animate data-delay="0.3" class="max-w-[806px] mx-auto">
          De los primeros proyectos empresariales a la fundación de Agencia Sur y el lanzamiento de nuestros sistemas propios.
        </p>
      </div>

      <div class="max-w-[800px] mx-auto space-y-8">
        {timeline.map((item, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.08} class="flex gap-6 items-start">
            <span class="text-heading-4 font-bold text-accent-400 flex-shrink-0 w-20">{item.year}</span>
            <p class="text-tagline-1 pt-1 text-secondary dark:text-accent">{item.event}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Principios — estilo innovation.htm -->
  <section class="pb-14 pt-14 md:pb-16 md:pt-16 lg:pb-[88px] lg:pt-[88px] xl:pb-[100px] xl:pt-[100px]">
    <div class="main-container" data-ns-animate data-delay="0.2">
      <div class="relative z-10">
        <div class="absolute top-0 left-0 right-0 bottom-0 -z-10 rounded-[20px] overflow-hidden">
          <img src="https://picsum.photos/1290/500?random=104" alt="Fondo principios" class="w-full h-full object-cover opacity-60" />
        </div>
        <div class="py-14 px-6 md:px-11 grid max-sm:grid-cols-1 grid-cols-2 max-sm:gap-10 gap-5">
          <div class="max-w-[500px]">
            <h2 class="text-accent text-heading-5 mb-8">
              Antes de programar, entendemos. Cada línea de código responde a un objetivo de negocio real.
            </h2>
            <div>
              <a href="/contacto" class="btn btn-md btn-white hover:btn-green dark:btn-transparent dark:hover:btn-green">
                <span>Hablemos</span>
              </a>
            </div>
          </div>
          <div>
            <ul class="space-y-4">
              {principios.map((p) => (
                <li class="flex items-center gap-3">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="shrink-0">
                    <path d="M0 10.0002C0 4.47729 4.47717 0 10 0C15.5229 0 20.0001 4.47729 20.0001 10.0002C20.0001 15.523 15.5229 20.0003 10 20.0003C4.47717 20.0003 0 15.523 0 10.0002Z" fill="#FCFCFC" fill-opacity="0.17"/>
                    <path d="M14.125 7.375L8.875 12.6248L6.25 10" stroke="" stroke-linecap="round" stroke-linejoin="round" class="stroke-accent"/>
                  </svg>
                  <span class="text-accent">{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="bg-secondary dark:bg-background-8 py-20 lg:py-[100px] xl:py-[140px]">
    <div class="main-container">
      <div class="mb-10 max-w-[514px] space-y-3 md:mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-section">Valores</span>
        <h2 data-ns-animate data-delay="0.2" class="text-accent">Cómo Trabajamos</h2>
      </div>

      <div class="grid grid-cols-12 xl:gap-8 md:gap-8 gap-y-5">
        {valores.map((valor, i) => (
          <div data-ns-animate data-delay={0.3 + i * 0.1} class="col-span-12 md:col-span-6">
            <div class="bg-background-1 dark:bg-background-6 rounded-[20px] p-8 space-y-4 h-full">
              <div class="flex size-12 items-center justify-center rounded-2xl bg-accent-400/10">
                <valor.icon class="size-6 text-accent-400" />
              </div>
              <h3 class="text-heading-5 text-secondary dark:text-accent">{valor.title}</h3>
              <p class="text-secondary/60 dark:text-accent/60">{valor.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 md:py-16 lg:py-[88px] xl:py-[100px]">
    <div class="main-container text-center">
      <div class="max-w-[600px] mx-auto space-y-5">
        <h2 data-ns-animate data-delay="0.1">¿Quieres conocer nuestro enfoque?</h2>
        <p data-ns-animate data-delay="0.2">
          Agenda una reunión sin compromiso. Te explicamos cómo podríamos ayudarte.
        </p>
        <div data-ns-animate data-delay="0.3">
          <a href="/contacto" class="btn btn-green btn-lg md:btn-xl hover:btn-secondary dark:hover:btn-accent">
            <span>Hablemos</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactoFooter />
</Layout>
