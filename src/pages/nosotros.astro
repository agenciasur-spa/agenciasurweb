                <text x="16" y="218" fill="rgba(255,255,255,0.2)" font-size="7" font-family="system-ui, sans-serif">Equipo</text>
                <circle cx="60" cy="232" r="10" fill="rgba(143,209,79,0.12)" stroke="rgba(143,209,79,0.35)" stroke-width="1"/>
                <text x="60" y="236" text-anchor="middle" fill="rgba(255,255,255,0.6)" font-size="8" font-family="system-ui, sans-serif">MO</text>
