                <line x1="16" y1="34" x2="238" y2="34" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                <rect x="16" y="42" width="222" height="4" rx="2" fill="rgba(255,255,255,0.05)"/>
                <rect x="16" y="42" width="134" height="4" rx="2" fill="rgba(143,209,79,0.5)"/>
