---
import Layout from "../../layouts/Layout.astro";
import ContactoFooter from "../../components/ContactoFooter.astro";
import { sanityClient } from "../../lib/sanity";
import PortableText from "../../components/PortableText";
import type { CasoExito } from "../../types/sanity";

// Fallback data for when Sanity is offline
const fallbackData: Record<string, CasoExito> = {
  "desarrollo-web-mobile": {
    title: "Automatización de procesos de compra",
    slug: "desarrollo-web-mobile",
    client: "BancoEstado",
    industry: "Financiero",
    challenge: undefined,
    solution: undefined,
    results: [
      "60% reducción en tiempo de aprobación",
      "100% eliminación de papel",
    ],
    testimonial: undefined,
    testimonialAuthor: undefined,
  },
};

export async function getStaticPaths() {
  const fallbackData: Record<string, { slug: string }> = {
    "desarrollo-web-mobile": { slug: "desarrollo-web-mobile" },
  };
  const fallbackSlugs = Object.keys(fallbackData);
  const paths = fallbackSlugs.map((slug) => ({ params: { slug } }));

  if (sanityClient) {
    try {
      const casos: CasoExito[] = await sanityClient.fetch(
        `*[_type == "casoExito"] { "slug": slug.current }`,
      );
      for (const caso of casos) {
        if (!fallbackSlugs.includes(caso.slug)) {
          paths.push({ params: { slug: caso.slug } });
        }
      }
    } catch {
      // Sanity query failed — fallbacks still work
    }
  }

  return paths;
}

const { slug } = Astro.params;

// Try Sanity first, fallback to static data
let caso: CasoExito | null = null;
if (sanityClient) {
  try {
    caso = await sanityClient.fetch(
      `*[_type == "casoExito" && slug.current == $slug][0] {
        _id, title, "slug": slug.current, client, industry,
        challenge, solution, results, testimonial, testimonialAuthor, image
      }`,
      { slug },
    );
  } catch {
    // Sanity query failed
  }
}

// Use fallback if Sanity has no data
if (!caso && slug && fallbackData[slug]) {
  caso = fallbackData[slug];
}

if (!caso) {
  return Astro.redirect("/casos-exito");
}
---

<Layout title={`${caso.title} | Agencia Sur`}>
  <!-- Hero -->
  <section
    class="overflow-hidden pt-32 pb-24 sm:pt-36 md:pt-42 md:pb-28 lg:pb-32 xl:pt-[180px] xl:pb-[200px]"
  >
    <div class="main-container">
      <div class="space-y-[70px]">
        <div class="space-y-5">
          <!--a href="/casos-exito" class="text-tagline-1 text-accent/60 dark:text-accent/60  font-medium hover:underline inline-block mb-2">
            ← Volver a Casos de Éxito
          </a-->
          <span data-ns-animate data-delay="0.1" class="badge badge-section"
            >{caso.client}</span
          >
          <div class="space-y-4">
            <h1
              data-ns-animate
              data-delay="0.2"
              class="max-w-[884px] font-light text-white"
            >
              {caso.title}
            </h1>
            <dl data-ns-animate data-delay="0.3" class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/60">
              <div class="flex items-center gap-1.5">
                <dt class="text-white/40">Empresa</dt>
                <dd class="text-white/80 font-medium">{caso.client}</dd>
              </div>
              {caso.industry && (
                <div class="flex items-center gap-1.5">
                  <dt class="text-white/40">Sector</dt>
                  <dd class="text-white/80 font-medium">{caso.industry}</dd>
                </div>
              )}
            </dl>
          </div>
        </div>

        <figure
          data-ns-animate
          data-delay="0.3"
          class="max-w-[1290px] overflow-hidden rounded-4xl"
        >
          <img
            src={`https://picsum.photos/1290/520?random=${slug.length + 700}`}
            alt={`${caso.title} vista general`}
            class="size-full object-cover"
            loading="lazy"
          />
        </figure>

        <div class="flex gap-4 flex-wrap">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm text-accent-400 border border-white/[0.07]" style="background: rgba(143,209,79,0.06);">
            <span class="size-2 rounded-full bg-accent-400 inline-block"></span>
            Proyecto completado
          </span>
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm text-accent-400 border border-white/[0.07]" style="background: rgba(143,209,79,0.06);">
            <span class="size-2 rounded-full bg-accent-400 inline-block"></span>
            Resultados medibles
          </span>
          {caso.industry && (
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm text-accent-400 border border-white/[0.07]" style="background: rgba(143,209,79,0.06);">
              <span class="size-2 rounded-full bg-accent-400 inline-block"></span>
              {caso.industry}
            </span>
          )}
        </div>

        <div class="mx-auto max-w-[950px]">
          <div class="space-y-14">

            <!-- Desafío — side-label pattern from customer-details-info.htm -->
            <div
              class="flex flex-col gap-y-4 md:flex-row md:gap-x-12"
            >
              <div data-ns-animate data-delay="0.1" class="md:w-44 md:shrink-0">
                <p
                  class="text-heading-5 text-white/50 sticky top-28"
                >
                  El desafío
                </p>
              </div>

              <div class="space-y-8 lg:max-w-[808px]">
                {
                  caso.challenge && (
                    <div class="details-body">
                      <PortableText client:load value={caso.challenge} />
                    </div>
                  )
                }
                {
                  !caso.challenge && (
                    <p data-ns-animate data-delay="0.2" class="text-white/60">
                      {caso.client} enfrentaba el desafío de{" "}
                      {caso.industry || "su industria"}: optimizar procesos que
                      limitaban su capacidad de crecer y escalar eficientemente.
                    </p>
                  )
                }
              </div>
            </div>

            <!-- Solución — side-label pattern -->
            <div
              class="flex flex-col gap-y-4 md:flex-row md:gap-x-12"
            >
              <div data-ns-animate data-delay="0.1" class="md:w-44 md:shrink-0">
                <p
                  class="text-heading-5 text-white/50 sticky top-28"
                >
                  La solución
                </p>
              </div>

              <div class="space-y-8 lg:max-w-[808px]">
                {
                  caso.solution && (
                    <div class="details-body">
                      <PortableText client:load value={caso.solution} />
                    </div>
                  )
                }
                {
                  !caso.solution && (
                    <p data-ns-animate data-delay="0.2" class="text-white/60">
                      Agencia Sur diseñó e implementó una plataforma a medida
                      que permitió
                      {caso.results?.[0]?.toLowerCase() ||
                        "optimizar operaciones clave"}
                      , integrando tecnología moderna con los procesos
                      existentes de {caso.client}.
                    </p>
                  )
                }

                <!-- Solution bullet list — case-study-details.htm pattern -->
                {
                  caso.results && caso.results.length > 0 && (
                    <ul data-ns-animate data-delay="0.3" class="space-y-4">
                      {caso.results.map((result, idx) => (
                        <li class="text-white/60 flex items-center justify-start gap-x-3">
                          <span class="bg-white size-2 rounded-full" />
                          {result}
                        </li>
                      ))}
                    </ul>
                  )
                }
              </div>
            </div>

            <!-- Resultados — side-label pattern + before/after table -->
            <div
              class="flex flex-col gap-y-4 md:flex-row md:gap-x-12"
            >
              <div data-ns-animate data-delay="0.1" class="md:w-44 md:shrink-0">
                <p
                  class="text-heading-5 text-white/50 sticky top-28"
                >
                  Los resultados
                </p>
              </div>

              <div class="space-y-8 lg:max-w-[808px]">
                {
                  caso.results && caso.results.length > 0 ? (
                    <div
                      data-ns-animate
                      data-delay="0.2"
                      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
                    >
                      {caso.results.map((result, idx) => (
                        <div class="rounded-2xl border border-white/[0.07] p-6 space-y-2" style="background-color: rgba(255,255,255,0.04);">
                          <p class="text-2xl font-bold text-accent-400">
                            {result.split(/(\d+%|\d+x)/)[1] || "✓"}
                          </p>
                          <p class="font-medium text-white/70">
                            {result}
                          </p>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p
                      data-ns-animate
                      data-delay="0.2"
                      class="text-white/60"
                    >
                      Próximamente compartiremos los resultados cuantificables
                      de este proyecto.
                    </p>
                  )
                }
              </div>
            </div>

            <!-- Testimonio — side-label pattern with testimonial card -->
            <div
              class="flex flex-col gap-y-4 md:flex-row md:gap-x-12"
            >
              <div data-ns-animate data-delay="0.1" class="md:w-44 md:shrink-0">
                <p
                  class="text-heading-5 text-white/50 sticky top-28"
                >
                  Testimonio
                </p>
              </div>

              <div class="space-y-8 lg:max-w-[808px]">
                {
                  caso.testimonial ? (
                    <article
                      data-ns-animate
                      data-delay="0.3"
                      class="max-w-[950px] space-y-6 rounded-[20px] p-8 border border-white/[0.07]"
                      style="background-color: rgba(255,255,255,0.03);"
                    >
                      <figure class="size-14 overflow-hidden rounded-full bg-(image:--color-gradient-7)">
                        <img
                          class="size-full object-cover"
                          src={`https://picsum.photos/56/56?random=${slug.length + 701}`}
                          alt="avatar"
                        />
                      </figure>
                      <blockquote>
                        <p class="text-white/80">
                          "{caso.testimonial}"
                        </p>
                      </blockquote>
                      {caso.testimonialAuthor && (
                        <div class="pb-4">
                          <h4 class="text-lg leading-[150%] font-medium text-white">
                            {caso.testimonialAuthor}
                          </h4>
                          <p class="text-tagline-2 text-accent/60">
                            {caso.client}
                          </p>
                        </div>
                      )}
                    </article>
                  ) : (
                    <p
                      data-ns-animate
                      data-delay="0.2"
                      class="text-white/60"
                    >
                      Próximamente compartiremos el testimonio de {caso.client}.
                    </p>
                  )
                }
              </div>
            </div>

            <!-- Características implementadas — side-label pattern -->
            <div
              class="flex flex-col gap-y-4 md:flex-row md:gap-x-12"
            >
              <div data-ns-animate data-delay="0.1" class="md:w-44 md:shrink-0">
                <p
                  class="text-heading-5 text-white/50 sticky top-28"
                >
                  Características
                </p>
              </div>

              <div
                data-ns-animate
                data-delay="0.2"
                class="space-y-6 lg:max-w-[808px]"
              >
                {caso.results && caso.results.length > 0 ? (
                  <ul class="space-y-4">
                    {caso.results.map((result) => (
                      <li class="text-white/60 flex items-center justify-start gap-x-3">
                        <span class="bg-accent-400 size-2 rounded-full shrink-0" />
                        {result}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-white/60">
                    Próximamente compartiremos las características técnicas
                    implementadas en este proyecto.
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 md:py-16 lg:py-[88px] xl:py-[100px]">
    <div class="main-container text-center">
      <div class="max-w-[600px] mx-auto space-y-5">
        <h2 data-ns-animate data-delay="0.1" class="font-light text-white">
          ¿Tu empresa tiene un desafío similar?
        </h2>
        <p data-ns-animate data-delay="0.2" class="text-white/60">
          Hablemos sobre cómo podemos ayudarte a lograr resultados como estos.
        </p>
        <div data-ns-animate data-delay="0.3">
          <a
            href="#contact-form-panel"
            class="btn btn-primary btn-lg md:btn-xl hover:btn-secondary dark:hover:btn-accent"
          >
            <span>Contactar</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactoFooter />
</Layout>
