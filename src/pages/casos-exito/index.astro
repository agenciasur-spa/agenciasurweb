---
import Layout from '../../layouts/Layout.astro';
import ContactoFooter from '../../components/ContactoFooter.astro';
import { sanityClient } from '../../lib/sanity';
import type { CasoExito } from '../../types/sanity';

let casos: CasoExito[] = [];
if (sanityClient) {
  try {
    casos = await sanityClient.fetch(
    `*[_type == "casoExito"] {
      _id,
      title,
      "slug": slug.current,
      client,
      industry,
      results
    }`);
  } catch {
    // Sanity query failed
  }
}

const fallbackCasos = [
  {
    title: 'Automatización de procesos de compra',
    slug: 'automatizacion-compras',
    client: 'BancoEstado',
    industry: 'Financiero',
    results: ['60% reducción en tiempo de aprobación', '100% eliminación de papel'],
  },
  {
    title: 'Gestión centralizada de personal externo',
    slug: 'gestion-personal-externo',
    client: 'ServiEstado',
    industry: 'Servicios',
    results: ['40% menos tiempo en onboarding', 'Control total de documentación'],
  },
];

const displayCasos = casos.length > 0 ? casos : fallbackCasos;
---

<Layout title="Casos de Éxito | Agencia Sur">

  <!-- Hero -->
  <section class="pb-14 md:pb-16 lg:pb-[88px] xl:pb-[100px] xl:pt-[180px] md:pt-42 sm:pt-36 pt-32">
    <div class="main-container">
      <div class="text-center space-y-5 mb-[70px]">
        <span data-ns-animate data-delay="0.1" class="badge badge-green">Resultados Reales</span>
        <div class="space-y-3">
          <h2 data-ns-animate data-delay="0.2" class="max-w-[878px] mx-auto">
            Casos de Éxito
          </h2>
          <p data-ns-animate data-delay="0.3" class="max-w-[700px] mx-auto">
            No hablamos en abstracto. Estos son problemas reales que resolvimos con resultados medibles.
          </p>
        </div>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-12 xl:gap-8 md:gap-8 gap-y-5">
        {displayCasos.map((caso, i) => (
          <div data-ns-animate data-delay={0.4 + i * 0.1} class="col-span-12 md:col-span-6">
            <a href={`/casos-exito/${caso.slug}`} class="group block">
              <div class="px-6 py-8 rounded-[20px] bg-background-3 dark:bg-background-7 space-y-5 hover:translate-y-[-10px] transition-transform duration-500 ease-in-out">
                <div class="flex items-center justify-between">
                  <span class="badge badge-primary">{caso.client}</span>
                  {caso.industry && (
                    <span class="text-tagline-2 text-secondary/60 dark:text-accent/60">{caso.industry}</span>
                  )}
                </div>
                <h3 class="text-heading-5">{caso.title}</h3>
                {caso.results && caso.results.length > 0 && (
                  <div class="flex gap-3 flex-wrap">
                    {caso.results.slice(0, 2).map((result) => (
                      <span class="badge badge-green text-tagline-3">{result}</span>
                    ))}
                  </div>
                )}
                <p class="text-tagline-2 text-primary-500 font-medium group-hover:underline">
                  Leer caso completo →
                </p>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactoFooter />
</Layout>
